+
+static void
+destroy_devices(void)
+{
+	vprofile_t *ptr;
+
+	/*
+	 * Destroy all DSP/WAV/loopback cuse devices BEFORE the process exits.
+	 *
+	 * cuse_dev_destroy() runs cuse_server_free_dev() in the kernel
+	 * (sys/fs/cuse/cuse.c), which marks every client of the device as
+	 * closing so the clients drop their server references.  Without this,
+	 * the kernel's cuse_server_free() (the /dev/cuse cdevpriv destructor
+	 * run at process exit) busy-waits forever in pause("W", hz) for
+	 * pcs->refs to fall to 1, and the exiting virtual_oss hangs unkillable
+	 * in state D<E, pinning cuse.ko (reboot required).
+	 *
+	 * Previously only the CTL device was destroyed; the DSP/WAV/loopback
+	 * handles returned by cuse_dev_create() were discarded, so they were
+	 * never torn down explicitly.  We now keep them in the profile and
+	 * destroy them here.  WAV before OSS, and only non-NULL handles.
+	 */
+	TAILQ_FOREACH(ptr, &virtual_profile_client_head, entry) {
+		if (ptr->wav_dev != NULL)
+			cuse_dev_destroy(ptr->wav_dev);
+		if (ptr->oss_dev != NULL)
+			cuse_dev_destroy(ptr->oss_dev);
+	}
+	TAILQ_FOREACH(ptr, &virtual_profile_loopback_head, entry) {
+		if (ptr->wav_dev != NULL)
+			cuse_dev_destroy(ptr->wav_dev);
+		if (ptr->oss_dev != NULL)
+			cuse_dev_destroy(ptr->oss_dev);
+	}
 }
 
