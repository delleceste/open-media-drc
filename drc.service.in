[Unit]
Description=DRC restore/save (user service)
After=default.target

# Template — generated to drc.service by install.sh from config.env.

[Service]
Type=oneshot
RemainAfterExit=yes

# Let drc.sh read the complete saved session itself.  Besides splitting the
# rate/design tuple correctly, restore also honours power, source and geometry.
ExecStart=@REPO_DIR@/drc.sh restore

[Install]
WantedBy=default.target
