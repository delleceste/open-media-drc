<?xml version="1.0" encoding="utf-8"?>
<!--
  Meant to read as a home-screen icon sitting directly on the wallpaper,
  stacked the way a launcher icon and its label are: the icon circle on top
  (RemoteViewsBuilder.iconSurface - the static app icon, or the cover
  painted into that same circle), the plain "OMDRC" label underneath.

  On Android 12+ RemoteViewsBuilder.layoutTiny resizes and repositions
  these to match the launcher's icons for the cell's actual size; the
  fixed sizes below (the Pixel launcher's 5-column grid), centered, are the
  fallback before that. WidgetConfigureActivity's tile settings adjust both.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/tiny_column"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <FrameLayout
            android:id="@+id/icon_surface"
            android:layout_width="53.5dp"
            android:layout_height="53.5dp">

            <ImageView
                android:id="@+id/cover_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:contentDescription="@null" />

        </FrameLayout>

        <!-- The label, drawn by RemoteViewsBuilder.labelBitmap in the font
             chosen at setup, which RemoteViews can't set on a TextView. -->
        <ImageView
            android:id="@+id/omdrc_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:contentDescription="@string/app_name" />

    </LinearLayout>

    <!-- Play/pause, over the icon's bottom-right edge towards the label:
         outside icon_surface so it isn't clipped to the icon. Placed from
         the cell's center; these margins fit the fallback icon above, and
         layoutTiny replaces them. -->
    <ImageView
        android:id="@+id/play_pause_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="center"
        android:layout_marginLeft="21dp"
        android:layout_marginTop="15dp"
        android:background="@drawable/widget_icon_chip_background"
        android:padding="4dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_play"
        tools:ignore="RtlHardcoded" />

</FrameLayout>
