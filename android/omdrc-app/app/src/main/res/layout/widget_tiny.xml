<?xml version="1.0" encoding="utf-8"?>
<!--
  Meant to read as a home-screen icon sitting directly on the wallpaper,
  stacked the way a launcher icon and its label are: the icon circle on top
  (RemoteViewsBuilder.iconSurface - the static app icon, or the cover
  painted into that same circle), the plain "OMDRC" label underneath.

  Sizes are measured off the Pixel launcher (Pixel 9, default grid) so the
  tile lines up with the icons in its row: a 53.5dp circle, a 13sp label,
  3.8dp between them. Everything hangs from the cell's bottom edge (the
  9.9dp under the label), the one edge the launcher places identically for
  an icon and a widget in the same row.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="bottom|center_horizontal">

        <FrameLayout
            android:id="@+id/icon_surface"
            android:layout_width="53.5dp"
            android:layout_height="53.5dp">

            <ImageView
                android:id="@+id/cover_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/play_pause_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/widget_icon_chip_background"
                android:padding="3dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_play" />

        </FrameLayout>

        <TextView
            android:id="@+id/omdrc_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3.8dp"
            android:layout_marginBottom="9.9dp"
            android:singleLine="true"
            android:text="@string/app_name"
            android:textColor="@android:color/white"
            android:textSize="13sp" />

    </LinearLayout>

</FrameLayout>
