<?xml version="1.0" encoding="utf-8"?>
<!--
  Meant to read as a home-screen icon sitting directly on the wallpaper,
  stacked the way a launcher icon and its label are: the icon circle on top
  (RemoteViewsBuilder.iconSurface - the static app icon, or the cover
  painted into that same circle), the plain "OMDRC" label underneath.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <FrameLayout
            android:id="@+id/icon_surface"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- fitEnd pins the circle's bounding square to this frame's
                 bottom-right corner whatever the cell's aspect, so the label
                 sits right under it and play_pause_icon (bottom|end) always
                 lands inside that square. -->
            <ImageView
                android:id="@+id/cover_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="2dp"
                android:scaleType="fitEnd"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/play_pause_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="2dp"
                android:background="@drawable/widget_icon_chip_background"
                android:padding="3dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_play" />

        </FrameLayout>

        <TextView
            android:id="@+id/omdrc_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:singleLine="true"
            android:text="@string/app_name"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

    </LinearLayout>

</FrameLayout>
