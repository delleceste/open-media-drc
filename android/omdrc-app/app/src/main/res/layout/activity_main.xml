<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_background">

    <!-- Swipe down to reload the page: also the way back after a network failure. -->
    <com.omdrc.widget.VerticalSwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/web_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.omdrc.widget.VerticalSwipeRefreshLayout>

    <com.omdrc.widget.LoadingRingView
        android:id="@+id/loading_ring"
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Stands in for the WebView's own "Web page not available" page, in the
         kiosk's look (see ConnectionErrorPanel). Clickable so no touch reaches
         the page underneath. -->
    <ScrollView
        android:id="@+id/conn_error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/kiosk_bg"
        android:clickable="true"
        android:descendantFocusability="beforeDescendants"
        android:fillViewport="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/conn_error_card"
                android:gravity="center_horizontal"
                android:minWidth="300dp"
                android:orientation="vertical"
                android:paddingHorizontal="28dp"
                android:paddingVertical="22dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/conn_error_led"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/conn_error_led" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.15"
                        android:text="@string/conn_error_badge"
                        android:textColor="@color/kiosk_muted"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_cloud_off" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:maxWidth="400dp"
                    android:text="@string/conn_error_title"
                    android:textColor="@color/kiosk_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/conn_error_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:maxWidth="400dp"
                    android:textColor="@color/kiosk_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/conn_error_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.15"
                    android:maxWidth="400dp"
                    android:textColor="@color/kiosk_text"
                    android:textSize="14sp" />

                <!-- The address, editable in place: after moving to another network
                     the box usually has another IP. flagNoExtractUi keeps the field
                     on the card instead of the landscape full-screen editor. -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:labelFor="@id/conn_error_host"
                    android:letterSpacing="0.12"
                    android:text="@string/conn_error_address_label"
                    android:textColor="@color/kiosk_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/conn_error_host"
                        android:layout_width="240dp"
                        android:layout_height="44dp"
                        android:autofillHints="none"
                        android:background="@drawable/conn_error_field"
                        android:fontFamily="monospace"
                        android:hint="@string/conn_error_address_hint"
                        android:imeOptions="actionGo|flagNoExtractUi|flagNoFullscreen"
                        android:importantForAutofill="no"
                        android:inputType="textUri"
                        android:paddingHorizontal="12dp"
                        android:selectAllOnFocus="true"
                        android:singleLine="true"
                        android:textColor="@color/kiosk_text"
                        android:textColorHint="@color/kiosk_muted"
                        android:textCursorDrawable="@null"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/conn_error_connect"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/conn_error_button_primary"
                        android:gravity="center"
                        android:paddingHorizontal="20dp"
                        android:text="@string/conn_error_connect"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/conn_error_retry"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/conn_error_button_secondary"
                    android:gravity="center"
                    android:paddingHorizontal="20dp"
                    android:text="@string/conn_error_retry"
                    android:textColor="@color/kiosk_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/conn_error_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/kiosk_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>

    <TextView
        android:id="@+id/settings_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:background="@drawable/widget_background"
        android:gravity="center"
        android:text="⚙"
        android:textColor="@color/widget_text_secondary"
        android:textSize="18sp"
        android:contentDescription="@string/settings_change_server" />
</FrameLayout>
