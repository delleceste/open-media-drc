<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="widget_background">#1E1E24</color>
    <color name="widget_text_primary">#F2F2F5</color>
    <color name="widget_text_secondary">#A0A0AA</color>
    <color name="status_safe">#4CAF50</color>
    <color name="status_unsafe">#E5484D</color>
    <color name="status_off">#8A8A94</color>
    <color name="icon_background">#FFFFFF</color>
    <color name="icon_glyph">#000000</color>
    <!-- Under the 1x1 tile's play/pause chip and its DRC / format strip. -->
    <color name="widget_chip_backdrop">#59000000</color>
    <!-- The tile's strip colors the source format like the kiosk page's own
         track strip (kiosk/static/widgets/track.js K.formatColor): hi-res
         (24-bit, 88kHz+) in blue, 24-bit/176kHz+ in status_safe, already
         used for the headroom-safe status icon. kiosk_accent's own dark-
         theme blue (#58A6FF) read too close to the strip's backdrop over a
         busy cover, so this is a brighter, more saturated blue instead,
         plus the text shadow below - kept close enough to still read as
         "the same blue" as the rest of the app. -->
    <color name="widget_fmt_hires">#4FC3FF</color>
    <color name="widget_fmt_green">@color/status_safe</color>
    <!-- Behind the strip's text (setShadowLayer), so a bright or busy
         cover showing through the backdrop never washes it out. -->
    <color name="widget_strip_text_shadow">#CC000000</color>
    <!-- The kiosk page's palette (omdrc-ctrl/src/kiosk/static/kiosk.css), for native
         screens that stand in for it, like the connection error: its light theme here,
         the dark one in values-night, so they follow the phone as the page does. -->
    <color name="kiosk_bg">#F3F5F8</color>
    <color name="kiosk_surface">#FFFFFF</color>
    <color name="kiosk_surface2">#EEF1F5</color>
    <color name="kiosk_border">#CFD6DE</color>
    <color name="kiosk_text">#1F2328</color>
    <color name="kiosk_muted">#59636E</color>
    <color name="kiosk_accent">#0969DA</color>
    <color name="kiosk_accent_strong">#1F6FEB</color>
    <color name="kiosk_red">#CF222E</color>
    <color name="kiosk_ripple">#1F000000</color>
</resources>
