<?xml version="1.0" encoding="utf-8"?>
<!-- The address field: the kiosk's input look, accent outline while editing. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/kiosk_bg" />
            <stroke android:width="1.5dp" android:color="@color/kiosk_accent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/kiosk_bg" />
            <stroke android:width="1dp" android:color="@color/kiosk_border" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
