<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OmdrcWidget" parent="android:Theme.Material.NoActionBar" />
    <!-- The dashboard, light (the phone in light mode): the page's colour from the first
         frame, the system splash included.  values-night-v31 has the dark one. -->
    <style name="Theme.OmdrcWidget.Main" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/kiosk_bg</item>
        <item name="android:windowSplashScreenBackground">@color/kiosk_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
