<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Same dark palette in both modes: the widget always renders dark
         (matches the dashboard's own dark theme), independent of system
         light/dark mode. Kept as a values-night override point rather than
         hardcoding, in case a light widget variant is wanted later. -->
    <color name="widget_background">#1E1E24</color>
    <color name="widget_text_primary">#F2F2F5</color>
    <color name="widget_text_secondary">#A0A0AA</color>
    <color name="status_safe">#4CAF50</color>
    <color name="status_unsafe">#E5484D</color>
    <color name="status_off">#8A8A94</color>
</resources>
