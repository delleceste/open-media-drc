<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.OmdrcWidget">

        <!--
          Launcher entry point: opens the dashboard directly (no widget instance
          context), using the app-wide default host/port. Tapping a widget body
          also launches this activity, but with an explicit host/port extra for
          that widget instance instead of the app-wide default.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".WidgetConfigureActivity"
            android:exported="true"
            android:label="@string/configure_widget_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!--
          One receiver handles everything: the system's APPWIDGET_UPDATE
          lifecycle broadcasts (dispatched by AppWidgetProvider's own
          onReceive into onUpdate/onDeleted/onEnabled/onDisabled), the
          self-rescheduling AlarmManager tick and the manual-refresh tap,
          both delivered as explicit intents (no intent-filter needed for
          those), and BOOT_COMPLETED to re-arm the alarm after a reboot
          (AlarmManager alarms, unlike WorkManager jobs, do not survive a
          reboot on their own).
        -->
        <receiver
            android:name=".OmdrcWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/omdrc_widget_info" />
        </receiver>

    </application>
</manifest>
