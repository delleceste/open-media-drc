[Unit]
Description=omdrc CD / S-PDIF input bridge (alsaloop)
After=sound.target
# BruteFIR decides where the bridge writes (loopback vs DAC straight), and the
# answer is settled once at startup — so the unit is deliberately NOT ordered
# after drc-usb-audio.service (the unit that brings BruteFIR up on Linux).
# drc.sh starts and stops this unit at the moment the chain moves, which is the
# only ordering that is actually correct.

# Template — rendered to omdrc-cdin.service by CMake (see cmake/).
# A --user unit, like the renderers: omdrcctrl's CD input card drives it with
# `systemctl --user start|stop omdrc-cdin`, which needs no sudoers grant.
# Link into ~/.config/systemd/user/ and `systemctl --user enable` it only if
# the CD input should survive a reboot; drc.sh starts it on demand either way.

[Service]
Type=simple
Environment=HOME=@AUDIO_HOME@
# The capture and DAC cards are looked up by role here; every knob below is
# also an OMDRC_CDIN_* environment variable, so an override belongs in
# ~/.config/systemd/user/omdrc-cdin.service.d/ rather than in this template.
Environment=OMDRC_CDIN_LOG_FILE=/tmp/omdrc-cdin.log
# Which input to capture, and at which rate, for the source drc.sh has just
# selected.  The bridge is started by unit name, so this is the only way the
# choice can reach it; drc.sh writes the file immediately before the start
# (write_cdin_env), which makes "CD input" and "Line input" the same unit with
# a different two lines in front of it.  The leading '-' is what lets a box
# that has never selected a capture source start the bridge anyway, on the
# bridge's own defaults.
EnvironmentFile=-@OMDRC_STATE_DIR@/cdin.env
ExecStart=@REPO_DIR@/scripts/omdrc-cdin-alsaloop
# The supervisor already retries alsaloop across carrier loss; a Restart here
# covers only the supervisor itself dying, which is a bug, not a CD player
# being switched off.
Restart=on-failure
RestartSec=5
# Bit-perfect capture at 44.1 kHz is a real-time job with a small buffer, and
# the box runs a convolution engine next to it.
Nice=-5

[Install]
WantedBy=default.target
