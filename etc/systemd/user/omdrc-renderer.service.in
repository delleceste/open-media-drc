[Unit]
Description=Start the last active MPD renderer (qobuzconnect2mpd or upmpdcli)
After=network-online.target sound.target
Wants=network-online.target

# Template — rendered to omdrc-renderer.service by CMake from host.cmake.
# Linux counterpart of etc/rc.d/omdrc_renderer: a oneshot that starts whichever
# renderer omdrcctrl's toggle last recorded in the state file (last_renderer),
# so a reboot comes back the way the box was left.
#
# systemd --user unit, like the two renderers it drives (the toggle switches
# them with `systemctl --user`, no sudo).  Symlink into ~/.config/systemd/user/
# and enable THIS instead of upmpdcli.service:
#
#	systemctl --user disable upmpdcli.service
#	systemctl --user enable --now omdrc-renderer.service
#
# Leaving upmpdcli.service (or qobuzconnect2mpd.service) enabled would start it
# at boot behind this unit's back, and both front-ends would drive MPD at once.
# Needs lingering for boot (not login) start:  loginctl enable-linger @AUDIO_USER@

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=PREFIX=@PREFIX@
# Uncomment (and match what omdrcctrl writes) if this unit and the panel would
# resolve different state directories — e.g. an installed panel using
# ~/.local/state/omdrc while the helper below runs from the checkout:
#Environment=OMDRC_STATE_DIR=%h/.local/state/omdrc
ExecStart=@REPO_DIR@/scripts/omdrc-renderer start
ExecStop=@REPO_DIR@/scripts/omdrc-renderer stop

[Install]
WantedBy=default.target
