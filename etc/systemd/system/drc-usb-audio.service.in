[Unit]
Description=DRC audio routing when USB DAC is connected
After=sound.target mpd.service
Wants=mpd.service
Requires=omdrc-audio-roles.service
After=omdrc-audio-roles.service

# Template — rendered to drc-usb-audio.service by CMake (see cmake/).
[Service]
Type=oneshot
RemainAfterExit=yes
User=@AUDIO_USER@
Environment=HOME=@AUDIO_HOME@
Environment=PATH=/usr/local/bin:/usr/bin:/bin
LimitRTPRIO=99
LimitMEMLOCK=infinity
ExecStartPre=/bin/sleep 1
ExecStart=@REPO_DIR@/drc.sh restore
ExecStop=@REPO_DIR@/drc.sh stop
