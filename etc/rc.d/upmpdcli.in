#!/bin/sh

# PROVIDE: upmpdcli
# REQUIRE: NETWORKING FILESYSTEMS musicpd
# KEYWORD: shutdown
#
# Template — rendered to upmpdcli by CMake (see cmake/).
#
# FreeBSD rc.d service script for upmpdcli (UPnP/OpenHome front-end for MPD).
#
# Installed service: CMake renders the daemon configuration for @AUDIO_USER@.

PREFIX="@PREFIX@"
BINDIR="${PREFIX}/bin"

upmpdcli_user="@AUDIO_USER@"
upmpdcli_homedir="@AUDIO_HOME@"

. /etc/rc.subr

name="upmpdcli"
rcvar="upmpdcli_enable"

load_rc_config "$name"

: ${upmpdcli_enable:="NO"}
: ${upmpdcli_user:="@AUDIO_USER@"}
: ${upmpdcli_homedir:="@AUDIO_HOME@"}
: ${upmpdcli_flags:=""}
# Config lives in the repo checkout; pidfile in the user's cache dir
# (/var/run is not writable by an unprivileged user).
: ${upmpdcli_config:="@REPO_DIR@/upmpdcli/upmpdcli.conf"}
: ${upmpdcli_pidfile:="${upmpdcli_homedir}/.cache/upmpdcli/upmpdcli.pid"}
# Console log: upmpdcli's own log goes to logfilename in upmpdcli.conf, but its
# cdplugin subprocesses (Qobuz among them) log to the stderr they inherit —
# where the Qobuz login/OAuth verdict is reported.  Without this it lands in
# /dev/null and omdrcctrl's Logs panel has nothing to show.
: ${upmpdcli_logfile:="/tmp/upmpdcli-console.log"}

# rc.subr's su -m does not update HOME; export it so upmpdcli finds its cachedir.
export HOME="${upmpdcli_homedir}"

# Services start with a minimal PATH that omits /usr/local/bin on FreeBSD; the
# python3 plugin subprocesses upmpdcli launches need it.
export PATH="${BINDIR}:/usr/bin:/bin"

# daemon(8) backgrounds upmpdcli (run without -D) and manages the PID file.
command="/usr/sbin/daemon"
procname="${BINDIR}/upmpdcli"
pidfile="${upmpdcli_pidfile}"

required_files="${upmpdcli_config}"

# -o appends stdout+stderr to the console log and -H reopens it on SIGHUP so
# newsyslog(8) can rotate it.  daemon(8) creates that log 0600; its -M mode
# option is missing from older base systems, where passing it fails the start
# with "daemon: invalid option -- M", so upmpdcli_precmd pre-creates the log
# 0644 instead and omdrcctrl's Logs panel can read it on every release.
command_args="-f -o ${upmpdcli_logfile} -H -p ${upmpdcli_pidfile} -t ${name} -- ${BINDIR}/upmpdcli -c ${upmpdcli_config} ${upmpdcli_flags}"

start_precmd="upmpdcli_precmd"

upmpdcli_precmd()
{
	# Ensure the pidfile/cache dir exists and is owned by the run user
	# (created as root, before rc.subr drops privileges via su).
	/usr/bin/install -d -o "${upmpdcli_user}" -m 0755 "${upmpdcli_pidfile%/*}"
	# Only when missing: open(2) with O_CREAT keeps an existing file's mode,
	# and the log must survive a restart for the Logs panel to show history.
	for f in "${upmpdcli_pidfile}" "${upmpdcli_logfile}"; do
		[ -e "${f}" ] ||
			/usr/bin/install -o "${upmpdcli_user}" -m 0644 /dev/null "${f}"
	done
}

run_rc_command "$1"
