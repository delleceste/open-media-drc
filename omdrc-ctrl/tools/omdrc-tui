    def draw_live(self, screen, bottom):
        h, w = screen.getmaxyx()
        if any(self.config[key] for key in ("levels", "dr", "balance")):
            self.colored(screen, bottom, 0, "─" * (w - 1), "muted")
        y = bottom + 1
        if self.config["levels"]:
            v = self.level.get("vu") or {}
            bw = min(28, max(8, (w - 40) // 2))
            for side in ("left", "right"):
                try: peak = float(v.get(side + "_peak", -120))
                except (TypeError, ValueError): peak = -120
                if not math.isfinite(peak): peak = -120
                filled = round(max(0, min(1, (peak + 60) / 60)) * bw)
                self.colored(screen, y, 2, side[0].upper() + " ", "accent")
                for i in range(bw):
                    color = "red" if i >= bw * 57 / 60 else "yellow" if i >= bw * 48 / 60 else "green"
                    self.colored(screen, y, 4 + i, "█" if i < filled else "░", color if i < filled else "muted")
                self.colored(screen, y, 5 + bw, f"{peak:5.1f} dBFS", "red" if peak >= -3 else "yellow" if peak >= -12 else "green")
                y += 1
        if self.config["balance"]:
            now = time.monotonic()
            # The bubble tracks the latest RMS frame; the chosen window remains
            # available as a stable, power-weighted balance readout.
            live_db = balance_db(self.samples, now, .3)
            average_db = balance_db(self.samples, now, self.config["balance_window"])
            width = min(29, w - 30)
            line = "Balance " + balance_line(live_db, width)
            if average_db is not None:
                line += f"  {self.config['balance_window']:g}s avg {average_db:+.1f} dB"
            self.colored(screen, y, 2, compact(line, w - 4), "muted")
            if live_db is not None:
                middle = max(5, width | 1) // 2
                pos = round(middle + max(-6, min(6, live_db)) / 6 * middle)
                self.colored(screen, y, 2 + len("Balance L ") + pos, "●", "red" if live_db > .05 else "accent")
            y += 1
        if self.config["dr"]:
            d = self.dr
            count = min(len(self.dr_blocks), self.config["dr_window"] // 3)
            if self.config["dr_per_song"]:
                count = min(count, int(d.get("track_age_blocks") or 0))
            selected = self.dr_blocks[-count:] if count else []
            sampled = len(selected) * 3
            value = dr_value(selected)
            label = f"DR {value:.1f}" if isinstance(value, (int, float)) else f"DR collecting {sampled}s/{self.config['dr_window']}s"
            color = "red" if value is not None and value < 6 else "yellow" if value is not None and value < 9 else "green" if value is not None else "muted"
            self.colored(screen, y, 2, compact(label, w - 4), color)
            x = min(w - 3, 2 + len(label) + 2)
            blocks = selected[-min(28, max(0, w - x - 2)):]
            for i, block in enumerate(blocks):
                level = dr_level(block)
                if not math.isfinite(level):
                    glyph, block_color = "·", "muted"
                else:
                    glyph = "▂▃▄▅▆▇█"[max(0, min(6, int((level + 40) / 40 * 6)))]
                    local_dr = dr_value(blocks[max(0, i - 1):i + 1])
                    block_color = "red" if local_dr is not None and local_dr < 6 else "yellow" if local_dr is not None and local_dr < 9 else "green"
                self.colored(screen, y, x + i, glyph, block_color)
            y += 1
        job = self.measure
        if isinstance(job, dict) and job.get("status") in ("queued", "running"):
            self.colored(screen, min(y, h - 2), 2, f"Album DR measurement {int(job.get('fraction', 0)*100)}%  {job.get('message', '')}", "accent")

    def prompt(self, screen, label, initial=""):
        h, w = screen.getmaxyx()
        curses.echo(); curses.curs_set(1)
        try:
            screen.move(h - 1, 0); screen.clrtoeol()
            self.text(screen, h - 1, 1, label + " " + initial)
            screen.refresh(); screen.timeout(-1)
            raw = screen.getstr(h - 1, min(w - 2, len(label) + len(initial) + 2), max(1, w - len(label) - len(initial) - 5))
            return initial + raw.decode(errors="replace")
        finally:
            curses.noecho(); curses.curs_set(0); screen.timeout(100)

    def action(self, key, screen):
        if key == curses.KEY_RESIZE:
            self.list_sixel_size = None
            return
        if key in (curses.KEY_PPAGE, curses.KEY_NPAGE, CTRL_LEFT, CTRL_RIGHT):
            page = self.album_source if self.page == "Album" else self.research_back if self.page == "Research" else self.page
            index = next((i for i, (_, name) in enumerate(PAGE_NAV) if name == page), 1)
            step = -1 if key in (curses.KEY_PPAGE, CTRL_LEFT) else 1
            target = PAGE_NAV[max(0, min(len(PAGE_NAV) - 1, index + step))][1]
            if target != self.page: self.switch(target)
            return
        if self.page == "Library" and self.search_editing:
            self.search_edit_key(key)
            if key == 27 and screen is not None: self.draw(screen)
            return
        if key == ord(" ") and self.page != "Now":
            self.transport("pause" if self.player.get("state") == "play" else "play")
            return
        if self.keep_prompt_at is not None:
            if key in (ord("y"), ord("Y")):
                self.keep_prompt_at = None; self.away_at = time.monotonic(); self.message = "Keeping DR estimate"
            elif key in (ord("n"), ord("N"), 27):
                self.keep_prompt_at = None; self.release_dr(); self.message = "DR estimate stopped"
            return
        if key == ord("q"): raise KeyboardInterrupt
        if key == curses.KEY_BTAB:
            names = ("levels", "dr", "balance")
            mask = sum(1 << i for i, name in enumerate(names) if self.config[name])
            mask = (mask + 1) % (1 << len(names))
            for i, name in enumerate(names): self.config[name] = bool(mask & (1 << i))
            if self.config["dr"]: self.dr_paused = False
            self.save()
            self.message = " · ".join(f"{name} {'on' if self.config[name] else 'off'}" for name in names)
            return
        for index in range(4):
            if key == curses.KEY_F1 + index:
                self.switch(PAGE_NAV[index][1]); return
        if self.page == "Config":
            if key in (curses.KEY_UP, curses.KEY_DOWN):
                self.config_index = max(0, min(len(CONFIG_KEYS) - 1,
                    self.config_index + (-1 if key == curses.KEY_UP else 1)))
                return
            if key in (10, 13, curses.KEY_LEFT, curses.KEY_RIGHT):
                key = ord(CONFIG_KEYS[self.config_index])
            cycles = {ord("w"): ("dr_window", [60, 300, 900, 1800, 3600, 5400]),
                      ord("k"): ("dr_keep_minutes", [2, 5, 10]),
                      ord("b"): ("balance_window", [.3, 1, 3, 5, 15, 30, 60])}
            if key in cycles:
                name, values = cycles[key]
                self.config[name] = values[(values.index(self.config[name]) + 1) % len(values)]
            elif key == ord("t"): self.config["dr_per_song"] = not self.config["dr_per_song"]
            elif key == ord("c"): self.config["cover"] = not self.config["cover"]
            elif key == ord("p"):
                modes = ["auto", "sixel", "symbols"]
                current = self.config.get("cover_mode", "auto")
                self.config["cover_mode"] = modes[(modes.index(current) + 1) % len(modes)] if current in modes else "auto"
                self.cover_key = None
            elif key == ord("z"):
                choices = ["auto", "light", "dark"]
                current = self.config.get("theme", "auto")
                self.config["theme"] = choices[(choices.index(current) + 1) % len(choices)] if current in choices else "auto"
                self.configure_colors()
                self.cover_key = None
            elif key == ord("d"):
                delays = (0, 0.5, 1, 2, 3)
                current = self.config.get("library_delay", 1.0)
                self.config["library_delay"] = delays[(delays.index(current) + 1) % len(delays)] if current in delays else 1.0
            elif key == ord("a"):
                self.open_ai_setup()
            elif key == ord("u"):
                server = self.prompt(screen, "Server URL:").strip()
                if server.startswith(("http://", "https://")):
                    self.config["server"] = server.rstrip("/"); self.api = API(server)
            elif key == 27: self.switch("Now")
            self.save(); return
        if self.page == "Library": self.library_key(key, screen)
        elif self.page == "Now": self.now_key(key, screen)
        elif self.page == "Album":
            if key == 27: self.switch(self.album_source)
            elif key == curses.KEY_UP: self.album_scroll = max(0, self.album_scroll - 1)
            elif key == curses.KEY_DOWN: self.album_scroll += 1
            elif key in (curses.KEY_LEFT, curses.KEY_RIGHT):
                self.album_action_index = (self.album_action_index + (-1 if key == curses.KEY_LEFT else 1)) % len(ALBUM_ACTIONS)
            elif key in (10, 13): self.album_key(ord(ALBUM_ACTIONS[self.album_action_index][2]), screen)
            elif curses.KEY_F5 <= key <= curses.KEY_F9:
                self.album_action_index = key - curses.KEY_F5
                self.album_key(ord(ALBUM_ACTIONS[self.album_action_index][2]), screen)
            else: self.album_key(key, screen)
        elif self.page == "Research":
            if key == 27:
                if self.research_job:
                    job = self.research_job
                    self.research_job = None
                    self.submit("research-cancel", lambda: self.api.request("/qobuz/ai/listening/cancel", body={"job": job}, ai=True))
                self.research_setup_pending = False
                self.switch(self.research_back)
            elif key in (curses.KEY_LEFT, curses.KEY_RIGHT):
                self.guide_section += -1 if key == curses.KEY_LEFT else 1; self.guide_scroll = 0
            elif key == curses.KEY_UP: self.guide_scroll = max(0, self.guide_scroll - 1)
            elif key == curses.KEY_DOWN: self.guide_scroll += 1
            elif key == ord("r"): self.start_research(force=True)
        elif self.page == "DRC" and key == ord("r"): self.last_drc = 0

    def library_key(self, key, screen):
        if key == 9:
            if self.library_sidebar_focus:
                self.library_sidebar_focus = False
                self.library_right_index = 1 if self.tab == 5 else 0
                if self.tab == 0: self.begin_search_edit(resume=True)
            elif self.library_right_index == 0 and self.tab in (0, 1):
                self.library_right_index = 1
                self.sort_focus = False
            elif self.tab == 0 and self.library_right_index == 1 and not self.sort_focus:
                self.sort_focus = True
            elif self.library_right_index < (2 if self.tab in (0, 1) else 1):
                self.library_right_index = 2 if self.tab in (0, 1) else 1
                self.sort_focus = False
            else:
                self.library_sidebar_focus = True
                self.sort_focus = False
            return
        if key == curses.KEY_LEFT:
            if self.tab == 0 and not self.library_sidebar_focus and self.library_right_index == 1 and self.sort_focus:
                self.sort_focus = False
            else:
                self.library_sidebar_focus = True
                self.sort_focus = False
            return
        if key == curses.KEY_RIGHT:
            if self.tab == 0 and not self.library_sidebar_focus and self.library_right_index == 1:
                self.sort_focus = True
                return
            if self.library_sidebar_focus:
                self.library_sidebar_focus = False
                self.library_right_index = 1 if self.tab == 5 else 0
                if self.tab == 0: self.begin_search_edit(resume=True)
            return
        if self.library_sidebar_focus and key in (curses.KEY_UP, curses.KEY_DOWN):
            step = -1 if key == curses.KEY_UP else 1
            selected = max(0, min(len(TABS) - 1, self.library_sidebar_index + step))
            if selected != self.library_sidebar_index:
                self.select_library_tab(selected)
            return
        if self.library_sidebar_focus and key in (10, 13):
            if self.library_sidebar_index == 0 and self.tab == 0:
                key = ord("/")
            else:
                self.select_library_tab(self.library_sidebar_index, immediate=True)
                return
        if not self.library_sidebar_focus and key in (curses.KEY_UP, curses.KEY_DOWN):
            result_index = 2 if self.tab in (0, 1) else 1
            if key == curses.KEY_DOWN and self.library_right_index < result_index:
                self.library_right_index += 1
                self.sort_focus = False
                return
            if key == curses.KEY_UP:
                if self.library_right_index == result_index and self.row > 0:
                    self.row -= 1
                    return
                if self.library_right_index > 0:
                    self.library_right_index -= 1
                    self.sort_focus = False
                    if self.tab == 0 and self.library_right_index == 0:
                        self.begin_search_edit(resume=True)
                    return
        if not self.library_sidebar_focus and key in (10, 13):
            if self.library_right_index == 0:
                if self.tab == 1:
                    self.choose_genres(screen); return
                if self.tab in (0, 2, 3, 4): key = ord("/")
                else: return
            elif self.library_right_index == 1 and self.tab == 0 and self.sort_focus:
                self.toggle_sort(); return
            elif self.library_right_index == 1 and self.tab in (0, 1): key = ord("f")
        if key in (ord(str(i)) for i in range(1, 7)):
            self.select_library_tab(key - ord("1"), immediate=True)
            return
        if key == ord("/") and self.tab in (0, 2, 3, 4):
            if self.tab == 0:
                self.begin_search_edit()
                return
            self.query = self.prompt(screen, "Search:").strip()
            if self.tab == 2:
                self.config["favourites_query"] = self.query
                self.save()
            self.library_sidebar_focus = False
            self.library_right_index = 1
            self.fetch_list(); return
        if key == ord("f") and self.tab in (0, 1):
            names = ("label", "from", "to", "sort", "awarded", "hires", "local")
            labels = ("Labels", "From date", "To date", "Sort", "Awarded", "Hi-res", "Local")
            selected = 0
            screen.timeout(-1)
            try:
                while True:
                    h, _ = screen.getmaxyx()
                    for offset, group in enumerate((range(4), range(4, 7))):
                        screen.move(h - 2 + offset, 0); screen.clrtoeol()
                        self.text(screen, h - 2 + offset, 1, "  ".join(
                            f"{'>' if i == selected else ' '}{i + 1} {labels[i]}" for i in group))
                    screen.refresh()
                    choice = screen.getch()
                    if choice in (curses.KEY_LEFT, curses.KEY_UP): selected = (selected - 1) % len(names)
                    elif choice in (curses.KEY_RIGHT, curses.KEY_DOWN): selected = (selected + 1) % len(names)
                    elif ord("1") <= choice <= ord("7"): selected = choice - ord("1"); break
                    elif choice in (10, 13): break
                    elif choice == 27: return
            finally:
                screen.timeout(100)
            name = names[selected]
            if name == "label": self.choose_labels(screen); return
            elif name in ("from", "to"):
                self.filters[name] = self.prompt(screen, name.title() + " (blank clears):").strip()
            elif name == "sort": self.toggle_sort(); return
            elif name in ("awarded", "hires", "local"): self.filters[name] = not self.filters[name]
            self.fetch_list(); return
        if key == ord("s") and self.tab == 0: self.toggle_sort(); return
        if key == curses.KEY_UP: self.row = max(0, self.row - 1)
        elif key == curses.KEY_DOWN: self.row = min(max(0, len(self.rows) - 1), self.row + 1)
        elif key == ord("r"): self.fetch_list()
        elif key == ord("m") and self.more: self.fetch_list(append=True)
        elif key == ord("x") and self.rows and self.tab == 5:
            album_id = str(self.rows[self.row].get("id") or "")
            choice = self.prompt(screen, "Review later: remove/renew/note?").strip().lower()
            action = {"remove": "remove", "renew": "extend", "note": "note"}.get(choice)
            if action:
                note = self.prompt(screen, "New note:") if action == "note" else ""
                self.submit("review-edit", lambda: self.api.request("/qobuz/review", body={"action": action, "album_id": album_id, "note": note}),
                            lambda d: self.fetch_list())
        elif key == 27 and self.folder: self.folder = ""; self.fetch_list()
        elif self.rows and key in (10, 13, ord("p"), ord("a"), ord("h"), ord("b")):
            item = self.rows[self.row]
            if item.get("kind") == "folder":
                if key in (10, 13): self.folder = str(item.get("id", "")); self.fetch_list()
            elif key in (10, 13): self.open_album(item)
            else: self.album_action(item, key, screen)

    def toggle_sort(self):
        self.filters["sort"] = "date" if self.filters["sort"] == "relevance" else "relevance"
        self.config["search_sort"] = self.filters["sort"]
        self.save()
        self.fetch_list()

    def now_key(self, key, screen):
        if key in (curses.KEY_UP, curses.KEY_DOWN):
            step = -1 if key == curses.KEY_UP else 1
            position = NOW_ACTION_ORDER.index(self.now_action)
            self.now_action = NOW_ACTION_ORDER[max(0, min(len(NOW_ACTION_ORDER) - 1, position + step))]
            self.message = "↑↓ select · Enter activate"
            return
        if key in (10, 13):
            shortcut = NOW_ACTIONS[self.now_action][1]
            key = ord(shortcut)
        if key in (curses.KEY_LEFT, curses.KEY_RIGHT):
            elapsed = self.player.get("elapsed")
            if isinstance(elapsed, (int, float)):
                if self.player.get("state") == "play":
                    elapsed += max(0, time.monotonic() - self.last_player)
                duration = self.player.get("duration")
                target = max(0, elapsed + (-10 if key == curses.KEY_LEFT else 10))
                if isinstance(duration, (int, float)) and duration > 0: target = min(duration, target)
                self.transport("seek", {"seconds": target})
            else: self.message = "Seek unavailable for this source"
        elif key in (ord("C"), 27):
            self.cover_zoom = not self.cover_zoom if key == ord("C") else False
            self.cover_key = None
        elif key == ord(" "):
            self.transport("pause" if self.player.get("state") == "play" else "play")
        elif key == ord("["): self.transport("prev")
        elif key == ord("]"): self.transport("next")
        elif key == ord("s"): self.transport("stop")
        elif key == ord("g"):
            try: self.transport("seek", {"seconds": float(self.prompt(screen, "Seek to seconds:"))})
            except ValueError: self.message = "Enter seconds as a number"
        elif key == ord("i") and self.qstatus.get("qobuz_album"):
            self.open_album({"id": self.qstatus["qobuz_album"]}, "Now")
        elif key in (ord("h"), ord("b")):
            self.album_action({"id": self.qstatus.get("qobuz_album")}, key, screen)
        elif key == ord("R"): self.start_research()
        elif key == ord("M"): self.submit("measure-start", lambda: self.api.request("/dr/measure", body={}), lambda d: setattr(self, "measure", d.get("job")))

    def album_key(self, key, screen):
        if key == ord("R"): self.start_research()
        elif key in (ord("p"), ord("a"), ord("h"), ord("b")):
            self.album_action(self.album or {}, key, screen)

    def transport(self, action, extra=None):
        self.submit("transport", lambda: self.api.request("/k/api/transport", body={"action": action, **(extra or {})}),
                    lambda d: setattr(self, "message", action + " sent"))

    def open_album(self, card, source="Library"):
        album_id = str(card.get("id") or "")
        if not album_id or card.get("local"):
            self.message = "Album details require a Qobuz album"; return
        self.album_source = source; self.album = card; self.album_scroll = 0; self.album_action_index = 0; self.switch("Album")
        self.submit("album", lambda: self.api.request("/qobuz/album/" + urllib.parse.quote(album_id)),
                    lambda d: setattr(self, "album", d["album"]))

    def album_action(self, card, key, screen):
        album_id = str(card.get("id") or "")
        if not album_id:
            self.message = "A Qobuz album is required"; return
        if key in (ord("p"), ord("a")):
            body = {"album_id": album_id, "mode": "append" if key == ord("a") else "replace"}
            self.submit("play", lambda: self.api.request("/qobuz/play", body=body), lambda d: setattr(self, "message", "Queued album"))
        elif key == ord("h"):
            path = self.prompt(screen, "Favourite folder (blank = Qobuz):").strip()
            body = {"action": "add" if path else "favorite", "album_id": album_id, "path": path}
            self.submit("favorite", lambda: self.api.request("/qobuz/favorites", body=body), lambda d: setattr(self, "message", "Added to favourites"))
        elif key == ord("b"):
            note = self.prompt(screen, "Review later note (optional):").strip()
            self.submit("review", lambda: self.api.request("/qobuz/review", body={"action": "add", "album_id": album_id, "note": note}),
                        lambda d: setattr(self, "message", "Bookmarked for later"))

    def open_ai_setup(self):
        url = self.api.server + "/k/?page=config&ai_setup=1"
        if webbrowser.open(url):
            self.message = "AI setup opened in browser; return here when ready"
        else:
            self.message = "Open AI setup: " + url

    def start_research(self, force=False):
        album_id = str((self.album or {}).get("id") or self.qstatus.get("qobuz_album") or "")
        title = self.player.get("album") or self.player.get("title") or ""
        if not title and not album_id:
            self.message = "Nothing playing to research"; return
        if self.page != "Research": self.research_back = self.page
        self.switch("Research")
        guide_key = album_id or (title + "|" + str(self.player.get("artist", "")))
        if guide_key == self.guide_album and self.guide and not force: return
        self.guide = None; self.guide_album = guide_key; self.guide_section = self.guide_scroll = 0
        job = str(uuid.uuid4()); self.research_job = job
        self.research_started = time.monotonic()
        def work():
            settings = self.api.request("/qobuz/ai/settings")
            if not settings.get("configured"): return {"setup_required": True, "settings": settings}
            album = self.album if self.album and str(self.album.get("id")) == album_id else None
            if not album and album_id:
                album = self.api.request("/qobuz/album/" + urllib.parse.quote(album_id))["album"]
            album = album or {"title": title, "artist": self.player.get("artist", "")}
            tracks = album.get("track_list") or [{"title": self.player.get("title", title), "work": "", "composer": ""}]
            query = {"job": job, "album_id": album_id,
                     "album": {k: album.get(k, "") for k in ("title", "artist", "composer", "label", "year", "genre", "release_type")},
                     "tracks": [{k: t.get(k, "") for k in ("title", "work", "composer")} for t in tracks]}
            return self.api.request("/qobuz/ai/listening", body=query, timeout=270, ai=True)
        def apply(data):
            if self.research_job == job:
                self.research_job = None
                if data.get("setup_required"):
                    self.ai_settings = data["settings"]
                    self.research_setup_pending = True
                    self.last_ai_check = 0
                    self.open_ai_setup()
                else:
                    self.guide = data
                    self.message = "Research ready"
        self.submit("research", work, apply)

    def read_key(self, screen):
        key = screen.getch()
        if key != 27:
            return key
        # xterm and Konsole send Ctrl+Left/Right as CSI 1;5D/C, which
        # curses does not recognize unless the terminal profile defines it.
        consumed = []
        screen.timeout(25)
        try:
            for expected in (ord('['), ord('1'), ord(';'), ord('5')):
                next_key = screen.getch()
                if next_key == -1:
                    break
                consumed.append(next_key)
                if next_key != expected:
                    break
            else:
                next_key = screen.getch()
                if next_key == ord('D'):
                    return CTRL_LEFT
                if next_key == ord('C'):
                    return CTRL_RIGHT
                if next_key != -1:
                    consumed.append(next_key)
        finally:
            screen.timeout(100)
        for value in reversed(consumed):
            curses.ungetch(value)
        return key

    def run(self, screen):
        if hasattr(curses, "set_escdelay"):
            curses.set_escdelay(25)
        curses.curs_set(0); screen.keypad(True); screen.timeout(100)
        self.configure_colors()
        try:
            while True:
                self.drain(); self.poll(); self.draw(screen)
                key = self.read_key(screen)
                if key != -1: self.action(key, screen)
        except KeyboardInterrupt:
            pass
        finally:
            if self.level_stream: self.level_stream.close()
            if self.dr_stream: self.dr_stream.close()
            self.pool.shutdown(wait=False, cancel_futures=True)


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--server", default="http://localhost:9090",
                        help="omdrcctrl base URL (default: http://localhost:9090)")
    args = parser.parse_args(argv)
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        parser.error("requires an interactive terminal")
    curses.wrapper(App(args.server).run)


if __name__ == "__main__":
    main()
