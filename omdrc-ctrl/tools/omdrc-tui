            label = self.message
        elif self.message and self.message != "Connecting…" and now - self._message_at < 4:
            label = self.message
        else:
            state = self.player.get("state")
            symbol = "▶" if state == "play" else "⏸" if state == "pause" else "■"
            album = clean(self.player.get("album")).strip()
            track = clean(self.player.get("title")).strip()
