    def draw_list_cover(self, screen, art, left, top, width, height, local=False):
        mode = self.cover_mode()
        key = (art, width, height, mode)
        job = "list-cover-" + str(key)
        if (key not in self.list_covers or
                (self.list_covers[key] is None and job not in self.pending and
                 time.monotonic() >= self.list_cover_retry.get(key, 0))):
            self.list_covers[key] = None
            self.list_cover_retry[key] = time.monotonic() + 30
            def accept(lines):
                self.list_covers[key] = lines
            self.submit(job, lambda: self.render_cover(art, width, height, True, mode), accept)
        if screen is not None and not self.list_covers[key] and job not in self.pending:
            if local: self.draw_local_cover_marker(screen, left, top, width, height)
            else: self.colored(screen, top + height // 2, left, compact("No cover", width), "muted")
        if mode == "sixel":
            if self.list_covers[key]: self.list_sixel_targets.append((left, top, self.list_covers[key]))
            return
        for row, runs in enumerate((self.list_covers.get(key) or [])[:height]):
            col = left
            for value, fg, bg in runs:
                if col >= left + width: break
                self.text(screen, top + row, col, value[:left + width - col], self.cover_style(fg, bg))
                col += len(value)

