def research_rows(body, width):
    """Wrap the AI guide while retaining headings, lists, quotes and links."""
    rows = []
    for raw in clean(body).splitlines():
        raw = raw.strip()
        if not raw:
            rows.append(("", "soft", 0))
            continue
        heading = re.match(r"^#{1,6}\s+(.*)", raw)
        bullet = re.match(r"^[-*]\s+(.*)", raw)
        quote = raw.startswith("> ")
        content = heading[1] if heading else bullet[1] if bullet else raw[2:] if quote else raw
        content = re.sub(r"\[([^]]+)\]\(([^)]+)\)", r"\1 (\2)", content)
        content = re.sub(r"\*\*(.*?)\*\*|__(.*?)__", lambda m: m[1] or m[2], content)
        content = re.sub(r"(?<!\w)[*_]([^*_]+)[*_]", r"\1", content)
        prefix = "• " if bullet else "│ " if quote else ""
        color = "accent" if heading or content.startswith(("http://", "https://")) else "muted" if quote else "soft"
        style = curses.A_BOLD if heading or "**" in raw else 0
        for i, line in enumerate(textwrap.wrap(content, max(10, width - len(prefix)),
                                               break_long_words=True, break_on_hyphens=False) or [""]):
            rows.append(((prefix if i == 0 else "  " if prefix else "") + line, color, style))
    return rows


def format_color(line):
    """Use the same format tiers as the desktop and Android-facing UI."""
    match = re.search(r"(\d+)\s*bit.*?([\d.]+)\s*kHz", str(line or ""), re.I)
    if not match: return "muted"
    return format_tier(int(match[1]), float(match[2]))


def format_tier(bits, khz):
    if bits >= 24 and khz >= 176: return "green"
    if bits >= 24 and khz >= 88: return "fmt_hires"
    if bits >= 24: return "fmt_24"
    if khz >= 48: return "fmt_48"
    return "muted"



def album_quality(item):
    """Qobuz album quality as "24/96" with its format colour, or ("", None)."""
    try: bits, khz = int(item.get("bits") or 0), float(item.get("rate") or 0)
    except (TypeError, ValueError): return "", None
    if not bits or not khz: return "", None
    if khz >= 1000: khz /= 1000
    return f"{bits}/{khz:g}", format_tier(bits, khz)


def album_dr(item):
    """DR badge text, color and emphasis from the same log used by the web UI."""
    summary = item.get("dr_log") or {}
    value = summary.get("dr") if isinstance(summary, dict) else None
    exact = summary.get("kind") == "exact" if isinstance(summary, dict) else False
    if value is None:
        value = item.get("dr")
        exact = value is not None  # local dr14.txt when a log entry is unavailable
    if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value):
        return "", None, 0
    color = "red" if value < 6 else "orange" if value < 8 else "yellow" if value < 10 else "green"
    return (f"DR={value:g}" if exact else f"DR ~{value:g}"), color, curses.A_BOLD if exact else curses.A_DIM


def same_name(name, query):
    """Whether the searched words already name this artist."""
    fold = lambda value: " ".join(clean(value).casefold().split())
    name = fold(name)
    return bool(name) and f" {name} " in f" {fold(query)} "


def clean(value):
    value = re.sub(r"<[^>]*>", "", str(value or ""))
    return "".join(ch for ch in value if ch in "\n\t" or unicodedata.category(ch)[0] != "C")


def compact(value, width):
    value = clean(value).replace("\n", " ").strip()
    return value[:max(0, width - 1)] + "…" if len(value) > width else value


def bar(value, width, lo=-60, hi=0):
    if width <= 0:
        return ""
    try:
        fraction = max(0.0, min(1.0, (float(value) - lo) / (hi - lo)))
    except (ValueError, TypeError):
        fraction = 0
    filled = round(fraction * width)
    return "█" * filled + "░" * (width - filled)


def drc_summary(state):
    """The applied path, from /now rather than the saved filter selection."""
    if not isinstance(state, dict) or "running" not in state:
        return "Reading room correction…"
    if not state["running"]:
        return "DRC OFF · direct"
    parts = ["DRC ON"]
    if state.get("rate"):
        parts.append(f"{float(state['rate']) / 1000:g} kHz")
    for key in ("geometry", "design_id"):
        if state.get(key): parts.append(str(state[key]))
    if isinstance(state.get("effective_attenuation_db"), (int, float)):
        parts.append(f"−{state['effective_attenuation_db']:.1f} dB")
    return " · ".join(parts)


def theme_is_light(choice, environ=None):
    if choice in ("light", "dark"):
        return choice == "light"
    value = (os.environ if environ is None else environ).get("COLORFGBG", "")
    try:
        background = int(value.split(";")[-1])
        return background >= 7
    except ValueError:
        return False


def xterm_color(rgb):
    """Closest xterm-256 colour for a terminal cell."""
    red, green, blue = rgb
    cube = [0, 95, 135, 175, 215, 255]
    ci = [min(range(6), key=lambda i: abs(cube[i] - v)) for v in rgb]
    cube_rgb = tuple(cube[i] for i in ci)
    gray = round((red + green + blue) / 3)
    gi = min(range(24), key=lambda i: abs(8 + 10 * i - gray))
    gray_rgb = (8 + 10 * gi,) * 3
    distance = lambda a: sum((a[i] - rgb[i]) ** 2 for i in range(3))
    return 232 + gi if distance(gray_rgb) < distance(cube_rgb) else 16 + ci[0] * 36 + ci[1] * 6 + ci[2]


def parse_cover_ansi(output):
    """Convert chafa's true-colour SGR to runs usable by curses."""
    lines = [[]]
    fg = bg = None
    parts = re.split(r"(\x1b\[[0-9;?]*[A-Za-z])", output)
    for part in parts:
        if not part: continue
        if part.startswith("\x1b["):
            if not part.endswith("m"): continue
            codes = [int(n) if n else 0 for n in part[2:-1].split(";")]
            i = 0
            while i < len(codes):
                code = codes[i]
                if code == 0: fg = bg = None
                elif code == 39: fg = None
                elif code == 49: bg = None
                elif code in (38, 48) and i + 2 < len(codes):
                    if codes[i + 1] == 5:
                        value = codes[i + 2]; i += 2
                    elif codes[i + 1] == 2 and i + 4 < len(codes):
                        value = xterm_color(codes[i + 2:i + 5]); i += 4
                    else:
                        i += 1; continue
                    if code == 38: fg = value
                    else: bg = value
                i += 1
            continue
        for n, text in enumerate(part.split("\n")):
            if n: lines.append([])
            if text:
                if lines[-1] and lines[-1][-1][1:] == (fg, bg):
                    previous = lines[-1].pop()
                    lines[-1].append((previous[0] + text, fg, bg))
                else: lines[-1].append((text, fg, bg))
    return [line for line in lines if line]


def balance_db(samples, now, window):
    selected = [(l, r) for at, l, r in samples if at >= now - window]
    left = sum(l for l, _ in selected)
    right = sum(r for _, r in selected)
    return 10 * math.log10(max(right, 1e-12) / max(left, 1e-12)) if left or right else None


def balance_line(db, width):
    width = max(5, width | 1)
    middle = width // 2
    cells = ["─"] * width
    cells[middle] = "┼"
    if db is not None:
        cells[round(middle + max(-6, min(6, db)) / 6 * middle)] = "●"
    label = "—" if db is None else ("Centre" if abs(db) < .05 else f"{'L' if db < 0 else 'R'} {abs(db):.1f} dB")
    return f"L {''.join(cells)} R  {label}"


def dr_value(blocks):
    """Mirror the kiosk's rolling TT estimate from its three-second blocks."""
    active = list(blocks)
    for i in range(len(active) - 1, -1, -1):
        if all(p <= .0001 for p in active[i][1]):
            active = active[i + 1:]
            break
    if len(active) < 2: return None
    result = 0.0
    channels = len(active[0][0])
    for channel in range(channels):
        powers = sorted((b[0][channel] for b in active), reverse=True)
        peaks = sorted((b[1][channel] for b in active), reverse=True)
        count = max(1, int(len(active) * .2))
        rms = math.sqrt(sum(powers[:count]) / count)
        peak = peaks[min(1, len(peaks) - 1)]
        result += 20 * math.log10(peak / rms) if rms > 0 and peak > 0 else 0
    return result / channels


def dr_level(block):
    values = block[0]
    mean = sum(values) / len(values) if values else 0
    return 10 * math.log10(mean) if mean > 0 else -math.inf


class API:
    def __init__(self, server):
        self.server = server.rstrip("/")

    def request(self, path, params=None, body=None, timeout=12, ai=False):
        url = self.server + path
        if params:
            url += "?" + urllib.parse.urlencode(params, doseq=True)
        headers = {"Accept": "application/json"}
        data = None
        if body is not None:
            data = json.dumps(body).encode()
            headers["Content-Type"] = "application/json"
            if ai:
                headers["X-Qobuz-AI"] = "1"
        req = urllib.request.Request(url, data=data, headers=headers)
        try:
            with urllib.request.urlopen(req, timeout=timeout) as response:
                answer = json.load(response)
        except urllib.error.HTTPError as error:
            try:
                answer = json.load(error)
            except ValueError:
                raise RuntimeError(f"HTTP {error.code}") from error
        except (OSError, ValueError) as error:
            raise RuntimeError(str(error)) from error
        if not isinstance(answer, dict) or not answer.get("ok"):
            raise RuntimeError(clean(answer.get("error", "Request failed")) if isinstance(answer, dict) else "Bad response")
        return answer

class Stream:
    def __init__(self, api, mode, sink):
        self.stop = threading.Event()
        self.response = None
        self.thread = threading.Thread(target=self.run, args=(api, mode, sink), daemon=True)
        self.thread.start()

    def run(self, api, mode, sink):
        url = api.server + "/spectrum/stream?compact=1&mode=" + mode
        while not self.stop.is_set():
            try:
                with urllib.request.urlopen(url, timeout=20) as response:
                    self.response = response
                    while not self.stop.is_set():
                        line = response.readline()
                        if not line: break
                        if line.startswith(b"data:"):
                            try: sink(json.loads(line[5:]))
                            except ValueError: pass
            except (OSError, ValueError, AttributeError):
                pass
            finally:
                self.response = None
            self.stop.wait(2)

    def close(self):
        # Closing HTTPResponse from the curses thread can block while the
        # reader owns its buffer lock. The daemon reader checks this event on
        # the next frame (or after its socket timeout) and closes its own socket.
        self.stop.set()


