    def save(self):
        CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
        tmp = CONFIG_PATH.with_suffix(".tmp")
        tmp.write_text(json.dumps({k: v for k, v in self.config.items() if k != "server"}, indent=2) + "\n")
        os.replace(tmp, CONFIG_PATH)

    def submit(self, key, fn, callback=None):
        if key in self.pending:
            return
        self.pending.add(key)
        if key == "research":
            def background():
                try: self.events.put((key, callback, fn(), None))
                except Exception as error: self.events.put((key, callback, None, str(error)))
            threading.Thread(target=background, daemon=True).start()
            return
        future = self.pool.submit(fn)
        def done(result):
            try:
                value = result.result()
                self.events.put((key, callback, value, None))
            except Exception as error:
                self.events.put((key, callback, None, str(error)))
        future.add_done_callback(done)

    def fetch_list(self, append=False):
        self.library_auto_due = None
        self.list_generation += 1
        self.list_error = ""
        generation = self.list_generation
        tab = TABS[self.tab]
        query = self.query.strip()
        params = {}
        if tab == "Search":
            path = "/qobuz/search"
            params = {"q": query, "label": self.filters["label"],
                      "sort": self.filters["sort"], "awarded": int(self.filters["awarded"]),
                      "hires": int(self.filters["hires"]), "local": int(self.filters["local"])}
            for name in ("from", "to"):
                if self.filters[name]: params[name] = self.filters[name]
            if append: params["scan"] = self.offset
        elif tab == "Discover":
            path = "/qobuz/discover"
            params = {"genre": self.filters["genre"], "offset": self.offset if append else 0,
                      "label": self.filters["discover_label"], "awarded": int(self.filters["awarded"]),
                      "hires": int(self.filters["hires"])}
        elif tab == "Favourites":
            path = "/qobuz/favorites/playlist/" + urllib.parse.quote(self.folder) if self.folder else "/qobuz/favorites"
        elif tab == "Chronology":
            path, params = "/qobuz/played", {"q": query, "limit": 100}
        elif tab == "Awarded":
            path, params = "/qobuz/awarded", {"q": query}
        else:
            path = "/qobuz/review"
        def apply(data):
            if generation != self.list_generation or tab != TABS[self.tab]: return
            if tab == "Favourites" and not self.folder:
                rows = [{"kind": "folder", **f} for f in data.get("folders", [])]
                rows += data.get("albums", [])
            else:
                rows = data.get("results", data.get("albums", data.get("items", [])))
            if query and tab == "Favourites":
                needle = query.casefold()
                rows = [row for row in rows if needle in (str(row.get("title", "")) + " " + str(row.get("artist", "")) + " " + str(row.get("path", ""))).casefold()]
            self.rows = (self.rows + rows) if append and tab == "Discover" else rows
            if not append: self.row = self.scroll = 0
            self.more = bool(data.get("more"))
            self.offset = data.get("next_offset", data.get("next_scan", 0))
            self.list_error = str(data.get("qobuz_error") or "")
            self.message = self.list_error or (f"{len(self.rows)} items" + (" · more available (m)" if self.more else ""))
        self.submit(f"list-{generation}", lambda: self.api.request(path, params,
                    timeout=60 if tab == "Search" else 12), apply)

    def choose_genres(self, screen):
        try:
            if not self.genres:
                self.genres = self.api.request("/qobuz/genres")["genres"]
        except (RuntimeError, KeyError) as error:
            self.message = f"Could not load genres: {error}"
            return
        genres = self.genres
        selected = set(self.filters["genre"].split(",")) - {""}
        cursor = next((i for i, genre in enumerate(genres)
                       if str(genre["id"]) in selected), 0)
        screen.timeout(-1)
        try:
            while True:
                self.draw(screen)
                height, width = screen.getmaxyx()
                visible = max(1, height - 6)
                start = max(0, min(cursor - visible // 2, len(genres) - visible))
                screen.move(2, 0); screen.clrtoeol()
                self.colored(screen, 2, 2, compact("Genres · Space toggle · Enter apply · c clear · Esc cancel", width - 4), "accent", curses.A_BOLD)
                for row in range(visible):
                    y = row + 3
                    screen.move(y, 1); screen.clrtoeol()
                    i = start + row
                    if i < len(genres):
                        genre = genres[i]
                        label = f"{'[x]' if str(genre['id']) in selected else '[ ]'} {genre['name']}"
                        self.colored(screen, y, 2, compact(label, width - 4), "accent" if i == cursor else "soft",
                                     curses.A_REVERSE if i == cursor else 0)
                screen.refresh()
                key = screen.getch()
                if key == curses.KEY_UP: cursor = max(0, cursor - 1)
                elif key == curses.KEY_DOWN: cursor = min(len(genres) - 1, cursor + 1)
                elif key == curses.KEY_NPAGE: cursor = min(len(genres) - 1, cursor + visible)
                elif key == curses.KEY_PPAGE: cursor = max(0, cursor - visible)
                elif key == ord(" ") and genres:
                    genre_id = str(genres[cursor]["id"])
                    if genre_id in selected: selected.remove(genre_id)
                    else: selected.add(genre_id)
                elif key in (ord("c"), ord("C")): selected.clear()
                elif key in (10, 13):
                    value = ",".join(str(genre["id"]) for genre in genres if str(genre["id"]) in selected)
                    if value != self.filters["genre"]:
                        self.filters["genre"] = value
                        self.config["discover_genre"] = value
                        self.save()
                        self.fetch_list()
                    return
                elif key == 27: return
        finally:
            screen.timeout(100)

    def choose_labels(self, screen):
        try:
            configured = self.api.request("/qobuz/labels")["labels"]
        except (RuntimeError, KeyError) as error:
            self.message = f"Could not load labels: {error}"
            return
        label_key = "discover_label" if self.tab == 1 else "label"
        config_key = "discover_labels" if self.tab == 1 else "search_labels"
        saved_custom = self.config.get("custom_labels")
        custom = [str(name) for name in saved_custom] if isinstance(saved_custom, list) else []
        names = []
        for name in [*(item.get("name", "") for item in configured), *custom, *self.filters[label_key]]:
            name = str(name).strip()
            if name and not any(existing.casefold() == name.casefold() for existing in names):
                names.append(name)
        selected = {name.casefold() for name in self.filters[label_key]}
        cursor = 0
        self.list_covers_hidden = True
        screen.timeout(-1)
        try:
            while True:
                self.draw(screen)
                height, width = screen.getmaxyx()
                visible = max(1, height - 6)
                start = max(0, min(cursor - visible // 2, max(0, len(names) - visible)))
                screen.move(2, 0); screen.clrtoeol()
                self.colored(screen, 2, 2, compact("Labels · Space toggle · a add · Enter apply · c clear · Esc back", width - 4), "accent", curses.A_BOLD)
                for row in range(visible):
                    y = row + 3
                    screen.move(y, 1); screen.clrtoeol()
                    i = start + row
                    if i < len(names):
                        name = names[i]
                        label = f"{'[x]' if name.casefold() in selected else '[ ]'} {name}"
                        self.colored(screen, y, 2, compact(label, width - 4), "accent" if i == cursor else "soft",
                                     curses.A_REVERSE if i == cursor else 0)
                screen.refresh()
                key = screen.getch()
                if key == curses.KEY_UP: cursor = max(0, cursor - 1)
                elif key == curses.KEY_DOWN: cursor = min(max(0, len(names) - 1), cursor + 1)
                elif key == curses.KEY_NPAGE: cursor = min(max(0, len(names) - 1), cursor + visible)
                elif key == curses.KEY_PPAGE: cursor = max(0, cursor - visible)
                elif key == ord(" ") and names:
                    name = names[cursor].casefold()
                    if name in selected: selected.remove(name)
                    else: selected.add(name)
                elif key in (ord("c"), ord("C")): selected.clear()
                elif key in (ord("a"), ord("A")):
                    name = self.prompt(screen, "New label (blank cancels):").strip()
                    screen.timeout(-1)
                    if name:
                        existing = next((item for item in names if item.casefold() == name.casefold()), None)
                        if existing: name = existing
                        else:
                            names.append(name)
                            custom.append(name)
                        selected.add(name.casefold())
                        cursor = names.index(name)
                elif key in (10, 13):
                    labels = [name for name in names if name.casefold() in selected]
                    if labels != self.filters[label_key] or custom != self.config.get("custom_labels", []):
                        self.filters[label_key] = labels
                        self.config[config_key] = labels
                        self.config["custom_labels"] = custom
                        self.save()
                        self.fetch_list()
                    return
                elif key == 27: return
        finally:
            self.list_covers_hidden = False
            screen.timeout(100)

    def begin_search_edit(self, resume=False):
        self.library_auto_due = None
        self.library_sidebar_focus = False
        self.library_right_index = 0
        self.sort_focus = False
        self.search_editing = True
        if not resume: self.search_draft = self.query
        self.search_decoder.reset()

    def finish_search_edit(self, submit=False):
        if submit:
            self.query = self.search_draft.strip()
            self.fetch_list()
        self.search_editing = False
        if submit: self.search_draft = self.query
        self.search_decoder.reset()
        try: curses.curs_set(0)
        except curses.error: pass

    def search_edit_key(self, key):
        if key in (10, 13):
            self.finish_search_edit(submit=True)
        elif key == 27:
            self.finish_search_edit()
            self.search_draft = self.query
            self.library_sidebar_focus = True
            self.library_sidebar_index = 0
            self.sort_focus = False
        elif key in (8, 127, curses.KEY_BACKSPACE):
            self.search_draft = self.search_draft[:-1]
            self.search_decoder.reset()
        elif key in (9, curses.KEY_DOWN):
            self.finish_search_edit(submit=self.search_draft.strip() != self.query)
            self.library_right_index = 1
        elif 32 <= key <= 255:
            try: self.search_draft += self.search_decoder.decode(bytes((key,)))
            except UnicodeDecodeError: self.search_decoder.reset()

    def select_library_tab(self, index, immediate=False):
        changed = index != self.tab
        if changed:
            if self.tab in self.queries: self.queries[self.tab] = self.query
            self.query = self.queries.get(index, "")
            self.list_sixel_clear_pending = bool(self.list_sixel_displayed)
        self.tab = index
        self.library_sidebar_index = index
        self.sort_focus = False
        if changed:
            self.folder = ""
            self.rows = []
            self.row = self.scroll = 0
            self.more = False
            self.list_generation += 1
        if changed and self.search_editing: self.finish_search_edit()
        if immediate or index not in (0, 1, 2) or self.config.get("library_delay", 1.0) == 0:
            if index == 0: self.begin_search_edit()
            else: self.fetch_list()
        elif changed or self.library_auto_due is None:
            self.library_auto_tab = index
            self.library_auto_due = time.monotonic() + float(self.config.get("library_delay", 1.0))

    def poll(self):
        now = time.monotonic()
        if self.page == "Library" and self.library_auto_due is not None and now >= self.library_auto_due:
            tab = self.library_auto_tab
            self.library_auto_due = None
            if tab == self.tab:
                if tab == 0: self.begin_search_edit()
                else: self.fetch_list()
        if now - self.last_player > 3:
            self.last_player = now
            self.submit("player", lambda: self.api.request("/k/api/player"), lambda d: setattr(self, "player", d))
            self.submit("qstatus", lambda: self.api.request("/qconnect/status"), self.update_qstatus)
            self.submit("now-state", lambda: self.api.request("/now"), lambda d: setattr(self, "now_state", d))
        if self.page == "DRC" and now - self.last_drc > 5:
            self.last_drc = now
            self.submit("drc", lambda: self.api.request("/drc/status"), lambda d: setattr(self, "drc", d))
        if now - self.last_measure > 3:
            self.last_measure = now
            self.submit("measure", lambda: self.api.request("/dr/measure"), lambda d: setattr(self, "measure", d.get("job")))
        if self.research_setup_pending and now - self.last_ai_check > 3:
            self.last_ai_check = now
            def ready(settings):
                self.ai_settings = settings
                if settings.get("configured") and self.research_setup_pending:
                    self.research_setup_pending = False
                    self.start_research(force=True)
            self.submit("ai-settings", lambda: self.api.request("/qobuz/ai/settings"), ready)
        want_level = self.config["levels"] or self.config["balance"]
        if want_level and not self.level_stream:
            self.level_stream = Stream(self.api, "vu", lambda d: self.events.put(("level-frame", None, d, None)))
        if not want_level and self.level_stream:
            self.level_stream.close(); self.level_stream = None
        if self.config["dr"] and not self.dr_stream and not self.dr_paused:
            self.dr_stream = Stream(self.api, "dr", lambda d: self.events.put(("dr-frame", None, d, None)))
        if not self.config["dr"] and self.dr_stream:
            self.release_dr()
        if self.page != "Now" and self.config["dr"] and self.dr_stream:
            if self.away_at is None: self.away_at = now
            if now - self.away_at >= self.config["dr_keep_minutes"] * 60 and self.keep_prompt_at is None:
                self.keep_prompt_at = now
                self.message = "Keep estimating DR? y = keep, n = stop (60 s timeout)"
        else:
            self.away_at = None
        if self.keep_prompt_at and now - self.keep_prompt_at >= 60:
            self.release_dr(); self.keep_prompt_at = None
            self.message = "DR estimate stopped; return to Now to restart"

    def release_dr(self):
        if self.dr_stream:
            self.dr_stream.close(); self.dr_stream = None
        self.away_at = None
        self.dr_paused = True

    def drain(self):
        # Bound work per paint so a busy stream cannot starve track polling,
        # keyboard input, and the on-screen clock.
        for _ in range(100):
            try: key, callback, value, error = self.events.get_nowait()
            except queue.Empty: break
            if key == "level-frame":
                self.level = value
                vu = value.get("vu") or {}
                try:
                    l, r = float(vu["left_rms"]), float(vu["right_rms"])
                    if max(l, r) > -60:
                        self.samples.append((time.monotonic(), 10 ** (l / 10), 10 ** (r / 10)))
                except (KeyError, TypeError, ValueError): pass
                self.last_level = time.monotonic()
                continue
            if key == "dr-frame":
                self.dr = value.get("dr") or {}
                if isinstance(value.get("dr_blocks"), list):
                    self.dr_blocks = value["dr_blocks"]
                elif isinstance(value.get("dr_blocks_add"), list):
                    additions = value["dr_blocks_add"]
                    if self.dr_end is not None and self.dr_end == value.get("dr_blocks_end", 0) - len(additions):
                        self.dr_blocks += additions
                    else:
                        self.dr_blocks = []
                if isinstance(value.get("dr_blocks_len"), int):
                    length = value["dr_blocks_len"]
                    self.dr_blocks = self.dr_blocks[-length:] if length else []
                self.dr_end = value.get("dr_blocks_end")
                self.last_dr = time.monotonic()
                continue
            self.pending.discard(key)
            if error:
                if key == f"list-{self.list_generation}": self.list_error = str(error)
                self.message = compact(error, 120)
                if key == "research": self.research_job = None
            else:
                if not self.connected and key in ("player", "qstatus", "now-state"):
                    self.connected = True
                    self._message = ""
                if callback: callback(value)

    def switch(self, page):
        if self.page == "Research" and page != "Research": self.research_setup_pending = False
        if self.page == "Library" and page != "Library":
            self.library_auto_due = None
            if self.search_editing: self.finish_search_edit()
        self.page = page
        if page == "Now":
            self.away_at = self.keep_prompt_at = None
            self.dr_paused = False
            if self.config["dr"] and not self.dr_stream:
                self.dr_stream = Stream(self.api, "dr", lambda d: self.events.put(("dr-frame", None, d, None)))
        if page == "Config":
            self.submit("ai-settings", lambda: self.api.request("/qobuz/ai/settings"),
                        lambda d: setattr(self, "ai_settings", d))
        if page == "Library":
            if self.tab == 0 and not self.search_editing:
                delay = float(self.config.get("library_delay", 1.0))
                if delay == 0: self.begin_search_edit()
                else:
                    self.library_auto_tab = 0
                    self.library_auto_due = time.monotonic() + delay
            elif self.tab != 0 and not self.rows:
                self.fetch_list()

    def configure_colors(self):
        self.light = theme_is_light(self.config.get("theme", "auto"))
        self.styles = {name: 0 for name in ("accent", "green", "yellow", "red", "muted", "soft", "fmt_hires", "fmt_24", "fmt_48", "bright", "orange", "year", "cover")}
        self.cover_pairs = {}
        if not curses.has_colors(): return
        curses.start_color()
        try: curses.use_default_colors()
        except curses.error: pass
        palette = ({"accent": "0969da", "green": "1a7f37", "yellow": "9a6700",
                    "red": "cf222e", "muted": "59636e", "soft": "6e7781", "fmt_hires": "0969da",
                    "fmt_24": "9a6700", "fmt_48": "8250df", "bright": "1f2328", "orange": "bc4c00",
                    "year": "1b7c83"} if self.light else
                   {"accent": "58a6ff", "green": "3fb950", "yellow": "d29922",
                    "red": "f85149", "muted": "8b949e", "soft": "c9d1d9", "fmt_hires": "79c0ff",
                    "fmt_24": "e3b341", "fmt_48": "d2a8ff", "bright": "f0f6fc", "orange": "ffa657",
                    "year": "76e3ea"})
        fallback = {"accent": curses.COLOR_BLUE, "green": curses.COLOR_GREEN,
                    "yellow": curses.COLOR_YELLOW, "red": curses.COLOR_RED,
                    "muted": curses.COLOR_CYAN, "soft": curses.COLOR_WHITE, "fmt_hires": curses.COLOR_BLUE,
                    "fmt_24": curses.COLOR_YELLOW, "fmt_48": curses.COLOR_MAGENTA,
                    "bright": curses.COLOR_WHITE, "orange": curses.COLOR_RED, "year": curses.COLOR_CYAN}
        for number, (name, color) in enumerate(palette.items(), 1):
            if number >= curses.COLOR_PAIRS: break
            fg = (xterm_color(bytes.fromhex(color)) if curses.COLORS >= 256 else fallback[name])
            try:
                curses.init_pair(number, fg, -1)
                self.styles[name] = curses.color_pair(number)
            except curses.error: pass
        self.next_cover_pair = 16

    def cover_style(self, fg, bg):
        if not curses.has_colors() or curses.COLORS < 256: return 0
        key = (fg if fg is not None else -1, bg if bg is not None else -1)
        if key not in self.cover_pairs:
            number = self.next_cover_pair
            if number >= curses.COLOR_PAIRS: return self.styles.get("accent", 0)
            try:
                curses.init_pair(number, *key)
                self.cover_pairs[key] = curses.color_pair(number)
                self.next_cover_pair += 1
            except curses.error: return 0
        return self.cover_pairs[key]

    def colored(self, screen, y, x, value, color, style=0):
        self.text(screen, y, x, value, style | self.styles.get(color, 0))

    def segments(self, screen, y, x, parts, width, style=0):
        """Paint (text, colour, style) parts in a row, cut at width."""
        end = x + width
        for value, color, part_style in parts:
            if x >= end: break
            if len(value) > end - x: value = value[:max(0, end - x - 1)] + "…"
            self.colored(screen, y, x, value, color, part_style | style)
            x += len(value)

    def text(self, screen, y, x, value, style=0):
        height, width = screen.getmaxyx()
        if 0 <= y < height and x < width:
            try: screen.addnstr(y, x, clean(value).replace("\n", " "), max(0, width - x - 1), style)
            except curses.error: pass

    def scrollbar(self, screen, top, x, height, total, offset):
        if total <= height or height <= 0: return
        thumb = max(1, round(height * height / total))
        start = round(min(offset, total - height) * (height - thumb) / (total - height))
        for row in range(height):
            self.colored(screen, top + row, x, "┃" if start <= row < start + thumb else "│",
                         "accent" if start <= row < start + thumb else "muted")

    def cover_mode(self):
        choice = self.config.get("cover_mode", "auto")
        if choice == "auto":
            env = os.environ
            return "sixel" if (env.get("KONSOLE_VERSION") or env.get("KONSOLE_DBUS_SERVICE") or
                               env.get("TERM_PROGRAM", "").lower() == "konsole" or
                               "konsole" in env.get("TERM", "").lower()) else "symbols"
        return choice if choice in ("sixel", "symbols") else "symbols"

    def update_qstatus(self, status):
        self.qstatus = status
        album_id = str(status.get("qobuz_album") or "")
        if album_id and album_id != self.art_album_id:
            self.art_album_id = album_id
            self.art_large = ""
            def accept(data):
                if self.art_album_id == album_id:
                    self.art_large = data.get("album", {}).get("image_large") or ""
            self.submit("album-art-" + album_id,
                        lambda: self.api.request("/qobuz/album/" + urllib.parse.quote(album_id)), accept)

    def current_art(self):
        if self.qstatus.get("playback_state") == "stop" and self.last_art:
            return self.last_art
        art = self.qstatus.get("art") or (self.now_state.get("music") or {}).get("art") or ""
        if art and self.art_large and str(self.qstatus.get("qobuz_album") or "") == self.art_album_id:
            art = self.art_large
        if art: self.last_art = art
        return art or self.last_art

    def draw(self, screen):
        self.list_sixel_targets = []
        active_art = self.current_art()
        if self.sixel_visible and (self.page != "Now" or not self.config["cover"] or
                                   not active_art or not self.cover_key or active_art != self.cover_key[0]):
            # Konsole keeps Sixel pixels independently of curses' cell buffer.
            os.write(sys.stdout.fileno(), b"\x1b[H\x1b[2J")
            screen.clear()
            self.sixel_visible = False
            self.sixel_target = None
        if self.list_sixel_clear_pending:
            os.write(sys.stdout.fileno(), b"\x1b[H\x1b[2J")
            screen.clear()
            self.list_sixel_displayed = ()
            self.list_sixel_size = None
            self.list_sixel_nav_state = None
            self.list_sixel_clear_pending = False
        screen.erase()
        height, width = screen.getmaxyx()
        if height < (20 if self.page == "Library" and self.tab == 0 else 15) or width < 55:
            self.text(screen, 0, 0, "Need at least 55 columns × 20 rows" if self.page == "Library" and self.tab == 0 else "Need at least 55 columns × 15 rows")
            screen.refresh(); return
        self.colored(screen, 0, 1, f"open-media-drc  ·  {self.page}  ·  q Quit", "accent", curses.A_BOLD)
        self.colored(screen, 1, 0, "─" * (width - 1), "muted")
        zoom = self.page == "Now" and self.cover_zoom
        bottom = height - (2 if zoom else 7 if self.config["levels"] or self.config["dr"] or self.config["balance"] else 3)
        if self.page == "Library": self.draw_library(screen, bottom)
        elif self.page == "Now": self.draw_now(screen, bottom)
        elif self.page == "DRC": self.draw_drc(screen, bottom)
        elif self.page == "Research": self.draw_research(screen, bottom)
        elif self.page == "Album": self.draw_album(screen, bottom)
        elif self.page == "Config": self.draw_config(screen, bottom)
        if not zoom: self.draw_live(screen, bottom)
        if not zoom: self.draw_nav(screen, bottom)
        self.colored(screen, height - 1, 1, self.footer_status(width - 3), "accent", curses.A_REVERSE)
        screen.refresh()
        targets = tuple(self.list_sixel_targets)
        nav_state = ((self.tab, self.scroll, self.row, self.library_sidebar_focus, self.library_right_index)
                     if self.page == "Library" else None)
        if (targets != self.list_sixel_displayed or
                (targets and ((height, width) != self.list_sixel_size or nav_state != self.list_sixel_nav_state))):
            if self.list_sixel_displayed:
                if targets != self.list_sixel_displayed or (height, width) != self.list_sixel_size:
                    os.write(sys.stdout.fileno(), b"\x1b[H\x1b[2J")
                    screen.clearok(True)  # repaint after an external terminal clear
                    screen.refresh()
            for left, top, payload in targets:
                os.write(sys.stdout.fileno(), f"\x1b7\x1b[{top + 1};{left + 1}H".encode() + payload + b"\x1b8")
            self.list_sixel_displayed = targets
        self.list_sixel_size = (height, width)
        self.list_sixel_nav_state = nav_state
        if self.page == "Now" and self.sixel_target and self.cover_sixel and not self.sixel_visible:
            left, top = self.sixel_target
            payload = f"\x1b7\x1b[{top + 1};{left + 1}H".encode() + self.cover_sixel + b"\x1b8"
            os.write(sys.stdout.fileno(), payload)
            self.sixel_visible = True

    def draw_nav(self, screen, bottom):
        height, width = screen.getmaxyx()
        x = 2
        for index, (label, page) in enumerate(PAGE_NAV):
            if x + len(label) >= width - 1: continue
            self.colored(screen, bottom - 1, x, label, "accent" if self.page == page else "soft")
            x += len(label) + 3
        if self.page == "Now":
            live_rows = 2 * int(self.config["levels"]) + int(self.config["balance"]) + int(self.config["dr"])
            y = bottom + live_rows if live_rows else bottom
            hint = "☷ Shift+Tab"
            self.colored(screen, y, width - len(hint) - 2, hint, "accent")

    def draw_library(self, screen, bottom):
        _, width = screen.getmaxyx()
        divider = 27
        result_x = divider + 2
        result_width = width - result_x - 2
        for y in range(2, bottom - 1):
            self.colored(screen, y, divider, "│", "muted")
        for index, name in enumerate(TABS):
            focused = self.library_sidebar_focus and index == self.library_sidebar_index
            label = f"{'▸' if focused else ' '} {index + 1} {name}"
            self.colored(screen, 2 + index, 1, compact(label, divider - 2).ljust(divider - 2),
                         "accent" if index == self.tab else "soft",
                         curses.A_REVERSE | curses.A_BOLD if focused else 0)
        self.colored(screen, 8, 1, "─" * (divider - 2), "muted")
        self.colored(screen, 9, 1, "p Play  a Add  h Fav", "soft")
        self.colored(screen, 10, 1, "b Later  m More", "soft")
        self.colored(screen, 11, 1, "r Reload" + ("  x Edit" if self.tab == 5 else ""), "soft")
        self.colored(screen, 2, result_x, TABS[self.tab], "accent", curses.A_BOLD)
        if self.tab == 0:
            first_control = "⌕ " + (self.search_draft if self.search_editing else self.query or "Enter to search")
        elif self.tab == 1:
            selected = set(self.filters["genre"].split(",")) - {""}
            names = [genre["name"] for genre in self.genres if str(genre["id"]) in selected]
            first_control = f"Genre: {', '.join(names) if names else f'{len(selected)} selected' if selected else 'Any'}  ·  Enter choose"
        elif self.tab in (2, 3, 4):
            first_control = f"Search: {self.query or 'all'}  ·  Enter edit"
        else:
            first_control = "Review later"
        if self.tab == 0:
            inner = result_width - 2
            box_style = curses.A_BOLD if self.search_editing else 0
            self.colored(screen, 3, result_x, "┌" + "─" * inner + "┐", "accent", box_style)
            if self.search_editing:
                visible_text = self.search_draft[-max(1, inner - 3):]
                cursor = "▌" if int(time.monotonic() * 2) % 2 == 0 else " "
                content = "⌕ " + visible_text + cursor
            else:
                content = "⌕ " + (self.search_draft or self.query or "Type to search…")
            self.colored(screen, 4, result_x, "│" + content[:inner].ljust(inner) + "│", "accent", box_style)
            self.colored(screen, 5, result_x, "└" + "─" * inner + "┘", "accent", box_style)
        else:
            self.colored(screen, 3, result_x, compact(first_control, result_width), "accent",
                         curses.A_REVERSE if not self.library_sidebar_focus and self.library_right_index == 0 else 0)
        if self.tab in (0, 1):
            f = self.filters
            label_key = "label" if self.tab == 0 else "discover_label"
            label_count = len(f[label_key])
            label_summary = f"{label_count} {'label' if label_count == 1 else 'labels'}"
            active = ([label_summary] if label_count else []) + [key for key in ("from", "to", "awarded", "hires", "local") if f[key]]
            summary = ", ".join(active) or "none"
            filter_y = 6 if self.tab == 0 else 4
            filter_text = f"Filters: {summary}  ·  Enter edit"
            if self.tab == 0:
                sort_text = "Sort: Qobuz" if f["sort"] == "relevance" else "Sort: Time"
                sort_x = result_x + result_width - len(sort_text)
                filter_width = sort_x - result_x - 2
                short_filter = f"{label_summary} ↵" if label_count else "Filters ↵"
                self.colored(screen, filter_y, result_x,
                             compact(filter_text if filter_width >= 17 else short_filter, filter_width), "accent",
                             curses.A_REVERSE if not self.library_sidebar_focus and self.library_right_index == 1 and not self.sort_focus else 0)
                self.colored(screen, filter_y, sort_x, sort_text, "accent",
                             curses.A_REVERSE if not self.library_sidebar_focus and self.library_right_index == 1 and self.sort_focus else 0)
            else:
                self.colored(screen, filter_y, result_x, compact(filter_text, result_width), "accent",
                             curses.A_REVERSE if not self.library_sidebar_focus and self.library_right_index == 1 else 0)
        first_result = 8 if self.tab == 0 else 6
        loading = f"list-{self.list_generation}" in self.pending
        if loading:
            title = "Searching Qobuz" if self.tab == 0 else "Loading results"
            track_width = max(1, result_width - len(title) - 2)
            position = int(time.monotonic() * 8) % track_width
            track = "─" * position + "█" + "─" * (track_width - position - 1)
            self.colored(screen, first_result - 1, result_x, compact(title + " " + track, result_width), "green")
        elif self.list_error:
            self.colored(screen, first_result - 1, result_x, compact(self.list_error, result_width), "red")
        else:
            self.colored(screen, first_result - 1, result_x, "─" * result_width, "muted")
        if not loading and not self.rows and self.tab == 0 and (self.query or self.filters["label"]):
            self.colored(screen, first_result, result_x,
                         compact("No matching albums" if not self.list_error else "Search unavailable", result_width), "muted")
        cover_height = 4 if self.tab == 1 else 3
        cover_width = 12 if self.tab == 1 else 10
        boxed_results = result_width >= 4
        block_height = cover_height + 1
        first_content = first_result + int(boxed_results)
        visible = max(0, (bottom - first_content - cover_height - int(boxed_results)) // block_height + 1)
        if self.row < self.scroll: self.scroll = self.row
        if visible and self.row >= self.scroll + visible: self.scroll = self.row - visible + 1
        for index in range(self.scroll, min(len(self.rows), self.scroll + visible)):
            y = first_content + (index - self.scroll) * block_height
            item = self.rows[index]
            results_focused = not self.library_sidebar_focus and self.library_right_index == (2 if self.tab in (0, 1) else 1)
            focused = results_focused and index == self.row
            selected = curses.A_REVERSE if focused and not boxed_results else 0
            if boxed_results:
                if focused:
                    self.colored(screen, y - 1, result_x, "┌" + "─" * (result_width - 2) + "┐", "green")
                    for border_y in range(y, y + cover_height):
                        self.colored(screen, border_y, result_x, "│", "green")
                        self.colored(screen, border_y, result_x + result_width - 1, "│", "green")
                    self.colored(screen, y + cover_height, result_x,
                                 "└" + "─" * (result_width - 2) + "┘", "green")
            content_x = result_x + 2 if boxed_results else result_x
            content_width = result_width - 4 if boxed_results else result_width
            if item.get("kind") == "folder":
                self.colored(screen, y, content_x, compact("▸ " + item.get("path", ""), content_width),
                             "accent" if index == self.row and not boxed_results else "muted", selected)
                continue
            art = item.get("image_large") or item.get("image") or ""
            local = item.get("source") == "local"
            art_width = cover_width if (art or local) and content_width >= cover_width + 20 else 0
            if art_width and not self.list_covers_hidden:
                if art: self.draw_list_cover(screen, art, content_x, y, cover_width, cover_height, local=local)
                elif local: self.draw_local_cover_marker(screen, content_x, y, cover_width, cover_height)
            x = content_x + (art_width + 2 if art_width else 0)
            text_width = content_width - (x - content_x)
            artist = clean(item.get("artist"))
            show_artist = bool(artist) and not (self.tab == 0 and same_name(artist, self.query))
            title_y = y + int(show_artist)
            if show_artist: self.colored(screen, y, x, compact(artist, text_width), "soft", selected)
            title = ("★ " if item.get("rating") else "") + clean(item.get("title") or "—")
            self.colored(screen, title_y, x, compact(title, text_width), "bright", selected | curses.A_BOLD)
            details = []
            if item.get("year"): details.append(str(item["year"]))
            if item.get("label"): details.append(clean(item["label"]))
            quality, tier = album_quality(item)
            if quality: details.append(quality)
            dr_text, dr_color, dr_style = album_dr(item)
            detail_text = " · ".join(details)
            if dr_text and text_width >= len(dr_text):
                available = text_width - len(dr_text) - 3
                detail_text = compact(detail_text, available) if available > 0 else ""
                dr_x = x + len(detail_text) + (3 if detail_text else 0)
                self.colored(screen, title_y + 1, x, detail_text, tier or "muted", selected)
                self.colored(screen, title_y + 1, dr_x, dr_text, dr_color, selected | dr_style)
            else:
                self.colored(screen, title_y + 1, x, compact(detail_text, text_width), tier or "muted", selected)

