    def draw_cover(self, screen, art, width, height, left, top):
        if art and width >= 10 and height >= 3:
            mode = self.cover_mode()
            key = (art, width, height, left, top, mode,
                   curses.COLORS >= 256 if curses.has_colors() else False)
            if key != self.cover_key:
                if self.sixel_visible:
                    os.write(sys.stdout.fileno(), b"\x1b[H\x1b[2J")
                    screen.clear()
                    self.sixel_visible = False
                self.cover_key = key
                self.cover_lines = []
                self.cover_sixel = None
                self.cover_pairs = {}
                self.next_cover_pair = 16
                use_color = key[6]
                def accept_cover(result):
                    if self.cover_key == key:
                        if mode == "sixel": self.cover_sixel = result
                        else: self.cover_lines = result
                    else: self.cover_key = None
                self.submit("cover", lambda: self.render_cover(art, width, height, use_color, mode), accept_cover)
            if mode == "sixel":
                self.sixel_target = (left, top)
                return
            self.sixel_target = None
            for row, runs in enumerate(self.cover_lines[:height]):
                col = left
                for value, fg, bg in runs:
                    if col >= left + width: break
                    self.text(screen, top + row, col, value[:left + width - col], self.cover_style(fg, bg))
                    col += len(value)

    def render_cover(self, url, width, height, use_color=True, mode="symbols"):
        if not shutil.which("chafa") or width < 10 or height < 3:
            return b"" if mode == "sixel" else [[("Cover: " + url, None, None)]]
        if url.startswith("/"): url = self.api.server + url
        if not url.startswith(("http://", "https://")): return b"" if mode == "sixel" else []
        with urllib.request.urlopen(url, timeout=10) as response:
            image = response.read(5_000_001)
        if len(image) > 5_000_000: return b"" if mode == "sixel" else []
        if mode == "sixel":
            command = ["chafa", "--probe", "off", "--polite", "on", "--format", "sixels",
                       "--colors", "full", "--scale", "max", "--size", f"{width}x{height}", "-"]
        else:
            command = ["chafa", "--probe", "off", "--colors", "full" if use_color else "none",
                       "--format", "symbols", "--symbols", "vhalf",
                       "--scale", "max", "--size", f"{width}x{height}", "-"]
        output = subprocess.run(command, input=image, capture_output=True, timeout=10,
                                check=True, env={**os.environ, "TERM": "dumb"}).stdout
        return output if mode == "sixel" else parse_cover_ansi(output.decode(errors="replace"))

