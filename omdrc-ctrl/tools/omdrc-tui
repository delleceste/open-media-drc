    def save(self):
        CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
        tmp = CONFIG_PATH.with_suffix(".tmp")
        tmp.write_text(json.dumps({k: v for k, v in self.config.items() if k != "server"}, indent=2) + "\n")
        os.replace(tmp, CONFIG_PATH)

    def submit(self, key, fn, callback=None):
        if key in self.pending:
            return
        self.pending.add(key)
        if key == "research":
            def background():
                try: self.events.put((key, callback, fn(), None))
                except Exception as error: self.events.put((key, callback, None, str(error)))
            threading.Thread(target=background, daemon=True).start()
            return
        future = self.pool.submit(fn)
        def done(result):
            try:
                value = result.result()
                self.events.put((key, callback, value, None))
            except Exception as error:
                self.events.put((key, callback, None, str(error)))
        future.add_done_callback(done)

    def fetch_list(self, append=False):
        tab = TABS[self.tab]
        query = self.query.strip()
        params = {}
        if tab == "Search":
            path = "/qobuz/search"
            params = {"q": query, "label": self.filters["label"],
                      "sort": self.filters["sort"], "awarded": int(self.filters["awarded"]),
                      "hires": int(self.filters["hires"]), "local": int(self.filters["local"])}
            for name in ("from", "to"):
                if self.filters[name]: params[name] = self.filters[name]
            if append: params["scan"] = self.offset
        elif tab == "Discover":
            path = "/qobuz/discover"
            params = {"genre": self.filters["genre"], "offset": self.offset if append else 0,
                      "label": self.filters["label"], "awarded": int(self.filters["awarded"]),
                      "hires": int(self.filters["hires"])}
        elif tab == "Favourites":
            path = "/qobuz/favorites/playlist/" + urllib.parse.quote(self.folder) if self.folder else "/qobuz/favorites"
        elif tab == "Chronology":
            path, params = "/qobuz/played", {"q": query, "limit": 100}
        elif tab == "Awarded":
            path, params = "/qobuz/awarded", {"q": query}
        else:
            path = "/qobuz/review"
        def apply(data):
            if tab != TABS[self.tab]: return
            if tab == "Favourites" and not self.folder:
                rows = [{"kind": "folder", **f} for f in data.get("folders", [])]
                rows += data.get("albums", [])
            else:
                rows = data.get("results", data.get("albums", data.get("items", [])))
            if query and tab == "Favourites":
                needle = query.casefold()
                rows = [row for row in rows if needle in (str(row.get("title", "")) + " " + str(row.get("artist", "")) + " " + str(row.get("path", ""))).casefold()]
            self.rows = (self.rows + rows) if append and tab == "Discover" else rows
            if not append: self.row = self.scroll = 0
            self.more = bool(data.get("more"))
            self.offset = data.get("next_offset", data.get("next_scan", 0))
            self.message = f"{len(self.rows)} items" + (" · more available (m)" if self.more else "")
        self.submit("list", lambda: self.api.request(path, params), apply)

    def poll(self):
        now = time.monotonic()
        if now - self.last_player > 3:
            self.last_player = now
            self.submit("player", lambda: self.api.request("/k/api/player"), lambda d: setattr(self, "player", d))
            self.submit("qstatus", lambda: self.api.request("/qconnect/status"), lambda d: setattr(self, "qstatus", d))
            self.submit("now-state", lambda: self.api.request("/now"), lambda d: setattr(self, "now_state", d))
        if self.page == "DRC" and now - self.last_drc > 5:
            self.last_drc = now
            self.submit("drc", lambda: self.api.request("/drc/status"), lambda d: setattr(self, "drc", d))
        if now - self.last_measure > 3:
            self.last_measure = now
            self.submit("measure", lambda: self.api.request("/dr/measure"), lambda d: setattr(self, "measure", d.get("job")))
        if self.research_setup_pending and now - self.last_ai_check > 3:
            self.last_ai_check = now
            def ready(settings):
                self.ai_settings = settings
                if settings.get("configured") and self.research_setup_pending:
                    self.research_setup_pending = False
                    self.start_research(force=True)
            self.submit("ai-settings", lambda: self.api.request("/qobuz/ai/settings"), ready)
        want_level = self.config["levels"] or self.config["balance"]
        if want_level and not self.level_stream:
            self.level_stream = Stream(self.api, "vu", lambda d: self.events.put(("level-frame", None, d, None)))
        if not want_level and self.level_stream:
            self.level_stream.close(); self.level_stream = None
        if self.config["dr"] and not self.dr_stream and not self.dr_paused:
            self.dr_stream = Stream(self.api, "dr", lambda d: self.events.put(("dr-frame", None, d, None)))
        if not self.config["dr"] and self.dr_stream:
            self.release_dr()
        if self.page != "Now" and self.config["dr"] and self.dr_stream:
            if self.away_at is None: self.away_at = now
            if now - self.away_at >= self.config["dr_keep_minutes"] * 60 and self.keep_prompt_at is None:
                self.keep_prompt_at = now
                self.message = "Keep estimating DR? y = keep, n = stop (60 s timeout)"
        else:
            self.away_at = None
        if self.keep_prompt_at and now - self.keep_prompt_at >= 60:
            self.release_dr(); self.keep_prompt_at = None
            self.message = "DR estimate stopped; return to Now to restart"

    def release_dr(self):
        if self.dr_stream:
            self.dr_stream.close(); self.dr_stream = None
        self.away_at = None
        self.dr_paused = True

    def drain(self):
        # Bound work per paint so a busy stream cannot starve track polling,
        # keyboard input, and the on-screen clock.
        for _ in range(100):
            try: key, callback, value, error = self.events.get_nowait()
            except queue.Empty: break
            if key == "level-frame":
                self.level = value
                vu = value.get("vu") or {}
                try:
                    l, r = float(vu["left_rms"]), float(vu["right_rms"])
                    if max(l, r) > -60:
                        self.samples.append((time.monotonic(), 10 ** (l / 10), 10 ** (r / 10)))
                except (KeyError, TypeError, ValueError): pass
                self.last_level = time.monotonic()
                continue
            if key == "dr-frame":
                self.dr = value.get("dr") or {}
                if isinstance(value.get("dr_blocks"), list):
                    self.dr_blocks = value["dr_blocks"]
                elif isinstance(value.get("dr_blocks_add"), list):
                    additions = value["dr_blocks_add"]
                    if self.dr_end is not None and self.dr_end == value.get("dr_blocks_end", 0) - len(additions):
                        self.dr_blocks += additions
                    else:
                        self.dr_blocks = []
                if isinstance(value.get("dr_blocks_len"), int):
                    length = value["dr_blocks_len"]
                    self.dr_blocks = self.dr_blocks[-length:] if length else []
                self.dr_end = value.get("dr_blocks_end")
                self.last_dr = time.monotonic()
                continue
            self.pending.discard(key)
            if error:
                self.message = compact(error, 120)
                if key == "research": self.research_job = None
            else:
                if not self.connected and key in ("player", "qstatus", "now-state"):
                    self.connected = True
                    self.message = "Connected"
                if callback: callback(value)

    def switch(self, page):
        if page == "Visibility" and self.page != "Visibility": self.visibility_back = self.page
        if self.page == "Research" and page != "Research": self.research_setup_pending = False
        self.page = page
        if page == "Now":
            self.away_at = self.keep_prompt_at = None
            self.dr_paused = False
            if self.config["dr"] and not self.dr_stream:
                self.dr_stream = Stream(self.api, "dr", lambda d: self.events.put(("dr-frame", None, d, None)))
        if page == "Config":
            self.submit("ai-settings", lambda: self.api.request("/qobuz/ai/settings"),
                        lambda d: setattr(self, "ai_settings", d))
        if page == "Library" and not self.rows: self.fetch_list()

    def configure_colors(self):
        self.light = theme_is_light(self.config.get("theme", "auto"))
        self.styles = {name: 0 for name in ("accent", "green", "yellow", "red", "muted", "soft", "fmt_hires", "fmt_24", "fmt_48", "cover")}
        self.cover_pairs = {}
        if not curses.has_colors(): return
        curses.start_color()
        try: curses.use_default_colors()
        except curses.error: pass
        palette = ({"accent": "0969da", "green": "1a7f37", "yellow": "9a6700",
                    "red": "cf222e", "muted": "59636e", "soft": "6e7781", "fmt_hires": "0969da",
                    "fmt_24": "9a6700", "fmt_48": "8250df"} if self.light else
                   {"accent": "58a6ff", "green": "3fb950", "yellow": "d29922",
                    "red": "f85149", "muted": "8b949e", "soft": "c9d1d9", "fmt_hires": "79c0ff",
                    "fmt_24": "e3b341", "fmt_48": "d2a8ff"})
        fallback = {"accent": curses.COLOR_BLUE, "green": curses.COLOR_GREEN,
                    "yellow": curses.COLOR_YELLOW, "red": curses.COLOR_RED,
                    "muted": curses.COLOR_CYAN, "soft": curses.COLOR_WHITE, "fmt_hires": curses.COLOR_BLUE,
                    "fmt_24": curses.COLOR_YELLOW, "fmt_48": curses.COLOR_MAGENTA}
        for number, (name, color) in enumerate(palette.items(), 1):
            if number >= curses.COLOR_PAIRS: break
            fg = (xterm_color(bytes.fromhex(color)) if curses.COLORS >= 256 else fallback[name])
            try:
                curses.init_pair(number, fg, -1)
                self.styles[name] = curses.color_pair(number)
            except curses.error: pass
        self.next_cover_pair = 16

    def cover_style(self, fg, bg):
        if not curses.has_colors() or curses.COLORS < 256: return 0
        key = (fg if fg is not None else -1, bg if bg is not None else -1)
        if key not in self.cover_pairs:
            number = self.next_cover_pair
            if number >= curses.COLOR_PAIRS: return self.styles.get("accent", 0)
            try:
                curses.init_pair(number, *key)
                self.cover_pairs[key] = curses.color_pair(number)
                self.next_cover_pair += 1
            except curses.error: return 0
        return self.cover_pairs[key]

    def colored(self, screen, y, x, value, color, style=0):
        self.text(screen, y, x, value, style | self.styles.get(color, 0))

    def text(self, screen, y, x, value, style=0):
        height, width = screen.getmaxyx()
        if 0 <= y < height and x < width:
            try: screen.addnstr(y, x, clean(value).replace("\n", " "), max(0, width - x - 1), style)
            except curses.error: pass

    def cover_mode(self):
        choice = self.config.get("cover_mode", "auto")
        if choice == "auto":
            env = os.environ
            return "sixel" if (env.get("KONSOLE_VERSION") or env.get("KONSOLE_DBUS_SERVICE") or
                               env.get("TERM_PROGRAM", "").lower() == "konsole" or
                               "konsole" in env.get("TERM", "").lower()) else "symbols"
        return choice if choice in ("sixel", "symbols") else "symbols"

    def draw(self, screen):
        active_art = (self.qstatus.get("art") or (self.now_state.get("music") or {}).get("art") or "")
        if self.sixel_visible and (self.page != "Now" or not self.config["cover"] or
                                   not active_art or not self.cover_key or active_art != self.cover_key[0]):
            # Konsole keeps Sixel pixels independently of curses' cell buffer.
            os.write(sys.stdout.fileno(), b"\x1b[H\x1b[2J")
            screen.clear()
            self.sixel_visible = False
            self.sixel_target = None
        screen.erase()
        height, width = screen.getmaxyx()
        if height < (20 if self.page == "Library" and self.tab == 0 else 15) or width < 55:
            self.text(screen, 0, 0, "Need at least 55 columns × 20 rows" if self.page == "Library" and self.tab == 0 else "Need at least 55 columns × 15 rows")
            screen.refresh(); return
        self.colored(screen, 0, 1, f"open-media-drc  ·  {self.page}  ·  q Quit", "accent", curses.A_BOLD)
        self.colored(screen, 1, 0, "─" * (width - 1), "muted")
        zoom = self.page == "Now" and self.cover_zoom
        bottom = height - (2 if zoom else 7 if self.config["levels"] or self.config["dr"] or self.config["balance"] else 3)
        if self.page == "Library": self.draw_library(screen, bottom)
        elif self.page == "Now": self.draw_now(screen, bottom)
        elif self.page == "DRC": self.draw_drc(screen, bottom)
        elif self.page == "Research": self.draw_research(screen, bottom)
        elif self.page == "Album": self.draw_album(screen, bottom)
        elif self.page == "Config": self.draw_config(screen, bottom)
        elif self.page == "Visibility":
            if self.visibility_back == "Library": self.draw_library(screen, bottom)
            elif self.visibility_back == "DRC": self.draw_drc(screen, bottom)
            elif self.visibility_back == "Config": self.draw_config(screen, bottom)
            elif self.visibility_back == "Album": self.draw_album(screen, bottom)
            else: self.draw_now(screen, bottom)
        if not zoom: self.draw_live(screen, bottom)
        if not zoom: self.draw_nav(screen, bottom)
        if self.page == "Visibility": self.draw_visibility(screen, bottom)
        self.colored(screen, height - 1, 1, compact(self.message, width - 3), "accent", curses.A_REVERSE)
        screen.refresh()
        if self.page == "Now" and self.sixel_target and self.cover_sixel and not self.sixel_visible:
            left, top = self.sixel_target
            payload = f"\x1b7\x1b[{top + 1};{left + 1}H".encode() + self.cover_sixel + b"\x1b8"
            os.write(sys.stdout.fileno(), payload)
            self.sixel_visible = True

    def draw_nav(self, screen, bottom):
        height, width = screen.getmaxyx()
        live_visible = any(self.config[key] for key in ("levels", "dr", "balance"))
        x = 2
        for index, (label, page) in enumerate(PAGE_NAV):
            y = (bottom + 1 + 2 * int(self.config["levels"]) + int(self.config["balance"]) + int(self.config["dr"]) - 1) if live_visible and page == "Visibility" else bottom - 1
            position = width - len(label) - 2 if page == "Visibility" else x
            if position < 1 or position + len(label) >= width - 1: continue
            self.colored(screen, y, position, label,
                         "accent" if self.page == page or self.nav_focus and self.nav_index == index else "soft",
                         curses.A_REVERSE if self.nav_focus and self.nav_index == index else 0)
            if page != "Visibility": x += len(label) + 3

