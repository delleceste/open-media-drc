    def draw_now(self, screen, bottom):
        h, w = screen.getmaxyx()
        p, q = self.player, self.qstatus
        art = q.get("art") or (self.now_state.get("music") or {}).get("art") or ""
        if self.cover_zoom:
            cover_h = max(0, bottom - 3)
            cover_w = min(cover_h * 2, max(0, w - 4))
            if self.config["cover"]: self.draw_cover(screen, art, cover_w, cover_h, max(1, (w - cover_w) // 2), 2)
            self.colored(screen, bottom, 2, compact(f"{p.get('title') or q.get('line1') or 'Nothing playing'} — {p.get('artist', '')}    C/Esc back", w - 4), "accent")
            return
        cover_h = max(0, bottom - 4)
        cover_w = min(cover_h * 2, max(0, w - 38)) if self.config["cover"] and art else 0
        if cover_w < 10 or cover_h < 3: cover_w = cover_h = 0
        x = cover_w + 4 if cover_w else 2
        avail = max(10, w - x - 2)
        title = p.get("title") or q.get("line1") or "Nothing playing"
        self.colored(screen, 2, x, compact(title, avail), "accent", curses.A_BOLD)
        self.text(screen, 3, x, compact(p.get("artist", ""), avail))
        self.text(screen, 4, x, compact(p.get("album", ""), avail))
        edition = "  ".join(str(value) for value in (p.get("label"), p.get("date")) if value)
        quality = q.get("line2") or ""
        if edition:
            self.colored(screen, 5, x, compact(edition, avail), "muted")
            quality_x = x + min(len(edition) + 2, avail)
        else:
            quality_x = x
        if quality and quality_x < w - 2:
            self.colored(screen, 5, quality_x, compact(quality, w - quality_x - 2), format_color(quality))
        elapsed, duration = p.get("elapsed"), p.get("duration")
        if isinstance(elapsed, (int, float)) and isinstance(duration, (int, float)) and duration:
            elapsed += max(0, time.monotonic() - self.last_player) if p.get("state") == "play" else 0
            self.text(screen, 6, x, f"{int(elapsed//60)}:{int(elapsed%60):02d} / {int(duration//60)}:{int(duration%60):02d}")
        drc_row = 3 + cover_h - 1 if cover_w else bottom - 2
        visible = max(1, drc_row - NOW_MENU_TOP)
        selected_row = NOW_ACTION_ROWS[self.now_action]
        self.now_action_scroll = min(self.now_action_scroll, max(0, 11 - visible))
        if selected_row < self.now_action_scroll: self.now_action_scroll = selected_row
        if selected_row >= self.now_action_scroll + visible:
            self.now_action_scroll = selected_row - visible + 1
        for menu_row in range(self.now_action_scroll, min(11, self.now_action_scroll + visible)):
            y = NOW_MENU_TOP + menu_row - self.now_action_scroll
            if menu_row == 4:
                self.colored(screen, y, x, "─" * min(avail, 30), "muted")
                continue
            if menu_row == 1:
                self.colored(screen, y, x, "|<", "accent" if self.now_action == 1 else "soft",
                             curses.A_REVERSE if self.now_action == 1 else 0)
                self.colored(screen, y, x + 6, ">|", "accent" if self.now_action == 2 else "soft",
                             curses.A_REVERSE if self.now_action == 2 else 0)
                continue
            index = NOW_ACTION_ROWS.index(menu_row)
            label, shortcut = NOW_ACTIONS[index]
            if index == 0: label = "Pause" if p.get("state") == "play" else "Play"
            if index == 4:
                progress = bar(elapsed, min(22, max(4, avail - 17)), 0, duration) if isinstance(elapsed, (int, float)) and isinstance(duration, (int, float)) and duration else "░" * min(22, max(4, avail - 17))
                label = "Seek " + progress + "  ← →"
            mark = "▸ " if index == self.now_action else "  "
            self.colored(screen, y, x, compact(mark + label, avail),
                         "green" if index == 0 and p.get("state") == "play" else "accent" if index == self.now_action else "soft",
                         curses.A_REVERSE if index == self.now_action else 0)
        drc = (self.now_state.get("drc") or {})
        self.colored(screen, drc_row, x, compact(drc_summary(drc), avail),
                     "green" if drc.get("running") else "muted" if drc.get("running") is False else "yellow")
        if cover_w:
            self.draw_cover(screen, art, cover_w, cover_h, 2, 3)
        elif not art:
            self.colored(screen, 13, 2, "Cover unavailable for this source", "muted")

    def draw_cover(self, screen, art, width, height, left, top):
        if art and width >= 10 and height >= 3:
            mode = self.cover_mode()
            key = (art, width, height, left, top, mode,
                   curses.COLORS >= 256 if curses.has_colors() else False)
            if key != self.cover_key:
                if self.sixel_visible:
                    os.write(sys.stdout.fileno(), b"\x1b[H\x1b[2J")
                    screen.clear()
                    self.sixel_visible = False
                self.cover_key = key
                self.cover_lines = []
                self.cover_sixel = None
                self.cover_pairs = {}
                self.next_cover_pair = 16
                use_color = key[6]
                def accept_cover(result):
                    if self.cover_key == key:
                        if mode == "sixel": self.cover_sixel = result
                        else: self.cover_lines = result
                    else: self.cover_key = None
                self.submit("cover", lambda: self.render_cover(art, width, height, use_color, mode), accept_cover)
            if mode == "sixel":
                self.sixel_target = (left, top)
                return
            self.sixel_target = None
            for row, runs in enumerate(self.cover_lines[:height]):
                col = left
                for value, fg, bg in runs:
                    if col >= left + width: break
                    self.text(screen, top + row, col, value[:left + width - col], self.cover_style(fg, bg))
                    col += len(value)

    def render_cover(self, url, width, height, use_color=True, mode="symbols"):
        if not shutil.which("chafa") or width < 10 or height < 3:
            return b"" if mode == "sixel" else [[("Cover: " + url, None, None)]]
        if url.startswith("/"): url = self.api.server + url
        if not url.startswith(("http://", "https://")): return b"" if mode == "sixel" else []
        with urllib.request.urlopen(url, timeout=10) as response:
            image = response.read(5_000_001)
        if len(image) > 5_000_000: return b"" if mode == "sixel" else []
        if mode == "sixel":
            command = ["chafa", "--probe", "off", "--polite", "on", "--format", "sixels",
                       "--colors", "full", "--scale", "max", "--size", f"{width}x{height}", "-"]
        else:
            command = ["chafa", "--probe", "off", "--colors", "full" if use_color else "none",
                       "--format", "symbols", "--symbols", "vhalf",
                       "--scale", "max", "--size", f"{width}x{height}", "-"]
        output = subprocess.run(command, input=image, capture_output=True, timeout=10,
                                check=True, env={**os.environ, "TERM": "dumb"}).stdout
        return output if mode == "sixel" else parse_cover_ansi(output.decode(errors="replace"))

