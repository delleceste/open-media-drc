# omdrcctrl commands configuration
#
# Each [section] defines one command.  Section name = command id (no spaces).
#
# Required keys (all commands):
#   what   - label shown next to the widget
#   group  - card section name (drc | apps | system | any custom name)
#   type   - READ | WRITE | LINK
#   cmd    - shell command to execute (READ and WRITE only)
#
# WRITE-only keys:
#   button  - button label text (e.g. Apply, Launch, Reboot)
#   confirm - yes | no  (show confirmation dialog before running; default no)
#
# READ-only keys:
#   refresh      - auto-refresh interval in seconds (omit or 0 = manual only)
#   details_root - root dir for dynamic details lookup ({root}/{output}/README.md)
#
# LINK-only keys:
#   url - URL to open in a new tab (e.g. http://192.168.1.1/)
#
# Optional keys (READ or WRITE):
#   os      - comma-separated platform names where the command is shown
#             (e.g. Linux, FreeBSD). Omit to show on every supported OS.
#   process - process name checked with pgrep -x; Details button appears when
#             the process is running. Use this instead of 'unit' when the
#             process is not managed by systemd or to avoid any systemd side
#             effects.
#   unit    - systemctl unit name; when 'systemctl is-active <unit>' succeeds
#             a Details button appears. Prefer 'process' when possible.
#   details - absolute path to a Markdown (.md) file rendered on the details
#             page; images may use paths relative to the .md file's directory
#   (one of 'process' or 'unit' must be present together with 'details')
#   details_link - external URL for a static always-visible Details button (overrides
#                 the conditional process/unit-based Details button)
#
# Example READ command (uncomment and adapt):
# [cpu_temp]
# what    = CPU temperature
# group   = system
# type    = READ
# refresh = 10
# cmd     = sensors | awk '/Core 0/{print $3}'
#
# This file is rendered by the top-level open-media-drc CMake build. Commands,
# site data, and state always use that installation's paths; there is no
# checkout-backed installation variant.

# -- Monitor settings -------------------------------------------------------
# Settings for the MPD and top-CPU monitoring panels.
[monitor]
# Processes with %CPU below this threshold are omitted from the top-CPU list.
topcpu_threshold = 4.0
# Refresh interval in seconds for the MPD panel.
monitor_interval = 5
# Refresh interval in seconds for the top-CPU panel. This runs ps.
topcpu_interval = 5
# Refresh interval in seconds for the audio devices panel.
sndstat_interval = 5
# Refresh interval in seconds for the BruteFIR CPU panel.
brutefir_interval = 5
# BruteFIR RTI/Peak gauge poll ladder, in whole seconds, comma-separated.
# Polling starts at the first step; once a poll comes back reporting the
# exact same RTI and peak reading as the previous one dsp_gauge_settle_count
# times in a row, the next poll waits for the next (slower) step instead,
# down to the last one. Any actual change in either reading resets it
# straight back to the first (fastest) step, so a spike is still caught
# within one poll.
dsp_gauge_poll_steps = 1,5,8
# How many consecutive unchanged polls it takes to step down to the next
# (slower) interval.  A single quiet reading does not prove the level has
# actually settled -- this makes it hold for a while first.
dsp_gauge_settle_count = 10

# -- Dynamic Range database -------------------------------------------------
# The renderer card's "DR ↗" button looks the record up at dr.loudness-war.info
# and lists the other masters people have measured, best first.  Read-only and
# on demand: nothing is queried until the button is pressed.  Set enabled = no
# on a box that must not talk to the internet -- the button and the page then
# disappear.
[drdb]
enabled = yes
# Where the database lives.  Kept configurable only so a mirror, or a local
# copy of the site, can be pointed at without a code change.
base_url = https://dr.loudness-war.info
# Seconds to wait for one page.  A lookup is made while someone is watching:
# it should fail visibly rather than hang the request thread.
timeout = 12
# Seconds a fetched page stays usable.  Pressing the button again on the same
# record, or reopening an album's details, then costs no request at all.
cache_ttl = 900
# Listing pages to walk (25 albums each).  They are requested already sorted
# by album DR descending, so a search cut short here still shows the best
# masters the database holds.
max_pages = 3
# Upper bound on the album pages the "find the album" sweep may read in one
# press.  That sweep exists because the Qobuz renderer publishes no album tag,
# so the only way to place a track is to look inside each candidate's own
# track list.
max_detail_lookups = 24

# -- Configuration workflows -----------------------------------------------
[configuration]
enabled = yes
site_root = @OMDRC_CONFIG_SITE_ROOT@
# Persistent authority for uploaded designs. A Git work tree must be clean and
# records every deployment; an ordinary writable directory is fully supported.
design_root = @OMDRC_CONFIG_DESIGN_ROOT@
state_root = @OMDRC_CONFIG_STATE_ROOT@
tools_root = @OMDRC_FILTER_TOOLS_ROOT@
helper = @OMDRC_CONFIG_HELPER@
max_file_bytes = 1073741824
max_upload_bytes = 2147483648
apply_timeout = 120
# A finished job's bulk working files (the REW upload and staged bundle) are
# deleted as soon as it ends; this caps the small job.json logs kept under
# state_root so an old box does not accumulate one directory per install
# forever. The newest are kept for the page to reopen.
retain_jobs = 25

# -- Bit-perfect verification ----------------------------------------------
# Runs the USB wire tap from the browser and shows the compared bytes.
# tools_root must hold bitperfect-lib.py, bitperfect_runner.py,
# bitperfect_material.py and the two bitperfect-tap-*.sh scripts.
# The tap needs root: the scripts escalate with `sudo -n`, so the panel's user
# needs a password-less rule for usbmon (Linux) / usbdump (FreeBSD).
[bitperfect]
enabled = yes
tools_root = @OMDRC_BITPERFECT_TOOLS_ROOT@
generator = @OMDRC_BITPERFECT_GENERATOR@
# Artifacts are large (a 30 s 44.1k capture is ~10 MB, and a run keeps the
# reference, the aligned payload and the untrimmed wire stream), so these
# default to /var/tmp rather than the site tree.
results_root = @OMDRC_BITPERFECT_RESULTS_ROOT@
assets_root = @OMDRC_BITPERFECT_ASSETS_ROOT@
state_root = @OMDRC_BITPERFECT_STATE_ROOT@
# Verifying an arbitrary track by PATH is confined to this directory; leave it
# empty to allow uploads only.
music_root = @OMDRC_BITPERFECT_MUSIC_ROOT@
max_upload_bytes = 2147483648
run_timeout = 900

# -- Live spectrum analyzer ------------------------------------------------
# Low-risk analyzer source: MPD writes a secondary raw PCM stream to a FIFO.
# omdrcctrl enables the matching MPD output only while a browser is actively
# watching /spectrum/stream, and disables it again when the browser disconnects.
#
# Requires the "OMDRC Spectrum" fifo audio_output in mpd/mpd.conf.
[spectrum]
enabled = yes
mpd_output_name = OMDRC Spectrum
fifo_path = /tmp/omdrc-spectrum.fifo
sample_rate = 44100
bits = 32
channels = 2
# Where the PCM comes from: auto | mpd | cdin.
#   mpd    MPD's secondary fifo output (above) — the music path
#   cdin   the CD / S-PDIF bridge, which never passes through MPD, so the MPD
#          FIFO above is empty for the whole of a disc
#   auto   cdin while a disc is actually playing through the bridge, else mpd
source = auto
# The capture source's own FIFO and rate. The rate must travel with the
# source: CD is 44.1 kHz where the MPD FIFO above is 48 kHz, and analysing at
# the wrong rate mislabels every frequency bin without reporting any error.
# The rate below is only the FALLBACK — a running bridge logs the rate it
# started at, and the analyzer prefers that.
cdin_fifo_path = /tmp/omdrc-cdin-spectrum.fifo
cdin_sample_rate = 44100
# How the CD PCM reaches that FIFO differs by OS, and only Linux needs a
# setting here:
#
#   FreeBSD  leave this empty. omdrc-cdin writes the FIFO itself — set
#            omdrc_cdin_spectrum_fifo="/tmp/omdrc-cdin-spectrum.fifo" in
#            rc.conf to the same path. The daemon writes nothing until the
#            panel opens the FIFO, so it costs nothing while unused.
#
#   Linux    alsaloop(1) is a third-party binary and the supervisor never sees
#            a sample, so omdrcctrl reads the capture device a SECOND time and
#            writes the FIFO itself. That needs a SHAREABLE capture PCM — an
#            ALSA `dsnoop` — because a second `hw:` opener gets EBUSY. Name it
#            here, and point omdrc-cdin-alsaloop's -C at the same PCM. Empty
#            disables the CD source on Linux rather than guessing a PCM name.
cdin_capture_pcm =
refresh_hz = 25
# Live DR panel: seconds between display refreshes (3-second DR blocks are
# unchanged; minimum 3).
dr_refresh_seconds = 5
# Keep the live DR history this many seconds after its last viewer leaves, so a
# page reload or a brief disconnection finds it intact (0 = drop it at once).
dr_hold_seconds = 60
fft_size = 16384
precision_fft_size = 65536
bands = 24
min_frequency = 31.5
# Lower chart/VU bound in dBFS. Raising this makes the analyzer less sensitive
# to very low-level content; lower values show more quiet detail.
floor_db = -40
# How fast a bar falls back once its band goes quiet, in dB per second.  Only
# the release is shaped: the analysis peak-holds every band across the whole
# frame interval, so a rise is a real transient and lands on the bar at once.
# Lower is more languid, higher is twitchier; 30 dB/s crosses a 40 dB plot in
# a little over a second.
fall_db_per_s = 30
# VU display below the analyzer: bars | needles
vu_mode = bars
# Meter timing.  The display is fed from a tap at the TOP of the chain — MPD's
# second FIFO output, or the CD bridge teeing what it is about to play — so it
# has to be held back by everything between there and the speaker.  The box
# holds it back only by what it can MEASURE, re-derived every 2 s while a meter
# or spectrum is open (DRC on/off, filter and rate changes are followed):
#
#   filter group    the impulse-response peak of the active filter (0 for the
#                   flat `dirac pulse` default, which is a real zero)
#   convolver       one BruteFIR partition, from `filter_length`
#   direct          DRC off (Linux): the DAC buffer, read from the kernel
#
# minus the margin below, so the frames always reach a screen a little early.
# Each screen waits out the rest with its own delay (kiosk: Config -> Meter
# timing, calibrated with the phone's microphone or set by eye with the click
# track; desktop panel: Screen delay under the analyzer's Sliders).  A screen
# can only wait, never anticipate: if a calibration reports the meters arriving
# AFTER the sound, raise the margin by about that much.
drc_delay_margin_ms = 150

# -- Qobuz Connect integration ---------------------------------------------
# Paths to the files written by qobuzconnect2mpd.  Change these if you use
# non-default paths (qconnectstatusfile / qconnectlogfile in its config).
[qconnect]
status_file = /tmp/qconnect2mpd-status.txt
log_file    = /tmp/qconnect2mpd.log
# Seconds between browser polls of /qconnect/status (now-playing, activity).
# The Renderer card's track-position readout still ticks forward every
# second client-side between polls and only corrects itself against the
# server on this cadence, so a slower value here does not make the visible
# clock choppy -- it only controls how quickly a pause/seek/track-change
# elsewhere is noticed.
status_resync_seconds = 3

# -- Log viewer -------------------------------------------------------------
# Sources for the Logs card: one "<id> = <path>" per log, in display order.
# "<id>.label = <text>" renames a source in the picker.  The three settings
# below are reserved key names, not sources.
#
# upmpdcli writes two logs: its own (logfilename in upmpdcli.conf) and the
# stderr of its cdplugin subprocesses, which the upmpdcli service redirects to
# upmpdcli-console.log — that second one carries the Qobuz login verdict.
[logs]
mpd                      = @AUDIO_HOME@/.local/share/mpd/mpd.log
mpd.label                = MPD
upmpdcli               = /tmp/upmpdcli.log
upmpdcli-console       = @UPMPDCLI_CONSOLE_LOG@
upmpdcli-console.label = upmpdcli (plugins)
qobuzconnect2mpd       = /tmp/qconnect2mpd.log
brutefir               = /tmp/brutefir.out
brutefir.label         = BruteFIR
omdrc-cdin             = /tmp/omdrc-cdin.log
omdrc-cdin.label       = CD input
# Most a single log view reads back, in bytes.
tail_bytes = 200000
# Tail of each source the alert rules below are matched against, in bytes.
scan_bytes = 65536
# Seconds between browser polls for active alerts.
alert_interval = 20

# -- CD / S-PDIF input bridge -----------------------------------------------
# The bridge captures the CD player's S/PDIF through the ESI U24 XL and feeds
# it into the DRC chain.  It is a service the panel WATCHES, not a command it
# runs, and the two operating systems run different programs behind the same
# log grammar:
#
#   FreeBSD  omdrc-cdin (cdin/), an OSS daemon. virtual_oss mixes clients, so
#            the card enforces source exclusivity explicitly: START disables
#            MPD's audible outputs and STOP restores the one previously active.
#   Linux    scripts/omdrc-cdin-alsaloop, a supervisor around alsaloop(1).
#            hw:Loopback,0,0 is a SINGLE substream, so the bridge and MPD's DRC
#            outputs cannot both hold it — a capture input is an exclusive
#            source, congruent with the FreeBSD card policy above.
#            `drc.sh cdin` selects it; any rate action selects music again.
#
# Everything the CD input card shows is read from this log, so log_file must
# match the daemon's: omdrc_cdin_logfile in /etc/rc.conf (FreeBSD), or
# OMDRC_CDIN_LOG_FILE in the unit (Linux).
[cdin]
enabled = yes
log_file = /tmp/omdrc-cdin.log
# Checked with pgrep -x to tell "stopped" from "broken": a stopped daemon's log
# is last week's news, and the card says so instead of showing a red light.
#
# Name the process that actually HOLDS the device, which on Linux is alsaloop
# and not the supervisor around it: a supervisor that is alive with the loop
# dead is exactly the state a green light would misreport.  Leave this unset to
# get the right default for the OS (omdrc-cdin / alsaloop).
# process = omdrc-cdin
# Service name — shown in the UI, and what the card's Start/Stop button runs
# (`service omdrc_cdin onestart|onestop`, or `systemctl --user start|stop
# omdrc-cdin`).  Unset takes the OS default (omdrc_cdin / omdrc-cdin).
# service = omdrc_cdin
# Whether that button exists.  Watching the daemon needs no privilege; starting
# and stopping it needs the rc.d grant in sudoers (see the README), so a box
# without that grant sets this to no rather than offering a button that can only
# fail.  The daemon is designed to be left running — this is for the one case
# watching cannot cover: handing /dev/dsp.play back by hand, from a box with no
# keyboard.
control = yes
# Whether STARTING it is one of the actions offered.  Unset takes the OS
# default: yes on FreeBSD, no on Linux.
#
# The asymmetry is not squeamishness.  Stopping only ever RELEASES a device, so
# a stray press ends audio you wanted — visible, recoverable, and it never
# leaves a device wedged.  Starting ACQUIRES one, and acquiring it correctly
# means knowing the rate and the state of the chain: on Linux the bridge and
# BruteFIR share a single snd-aloop substream, so alsaloop opened at 44.1 kHz
# against a loopback BruteFIR is reading at 192 kHz is an EBUSY; and a bridge
# started behind drc.sh's back leaves last_source saying "music", so the next
# reconcile, rate action or reboot stops it again and the bridge looks like it
# died by itself.  `drc.sh cdin` — the "CD input" button — is the start, and
# it sets the rate, the source and which input of the card the bridge opens,
# first.
#
# FreeBSD keeps both halves: virtual_oss mixes, the daemon is a persistent
# service that picks its own output, and a raw start really is just "put it
# back in the chain".
#
# Stop stays on both, and on Linux it stays precisely BECAUSE it does not go
# through drc.sh: when drc.sh is what is stuck — its lock held by a wedged run,
# or MPD refusing connections so every rate action aborts on the way in — this
# is the one control left that can hand the device back.
# control_start = no
refresh = 5
# Past failures the card keeps.  Failures accumulate and stay visible in red;
# the healthy status line is replaced rather than accumulated, so a quiet week
# does not push last night's dropout off the list.
max_events = 20

# -- Audio chain ------------------------------------------------------------
# The block diagram of who currently holds the sound devices.  Unlike every
# other card here it does not ask open-media-drc anything: it asks the kernel,
# through fstat(1) on FreeBSD and fuser(1) on Linux, so a process from OUTSIDE
# the chain squatting a device (a stray PulseAudio, a leftover mpv, a second
# brutefir from a half-finished restart) is visible the moment it happens.
[chain]
enabled = yes
# Seconds between polls.  Each one runs a single fstat/fuser over the device
# list plus, at most, one `mpc status` -- and fstat/fuser is comfortably the
# most expensive poll in the whole panel, so this baseline stays slow.  A DRC
# rate change, CD-in toggle or DRC OFF triggers an immediate out-of-band
# refresh from the browser regardless (see runWrite() in index.html), so this
# interval only has to catch a change nothing else already reports: a stray
# process taking a device from outside the chain.
refresh = 10
# Re-ask through `sudo -n` when omdrcctrl is not root.  fstat/fuser can only
# report descriptors of processes the caller may debug, so without this the card
# sees the chain (brutefir, MPD, omdrc-cdin all run as the panel's own user) but
# NOT a root process holding a device.  With no sudoers grant the first attempt
# fails, is never retried, and the card says the listing is incomplete.
privileged = yes
# The four device roles, in flow order.  Leave a role empty to drop it from the
# diagram — a box with no CD input sets `capture =` and the input block, and its
# LED, disappear instead of sitting there permanently grey.
#
# FreeBSD defaults (the role symlinks omdrc_audio maintains, plus the two cuse
# nodes virtual_oss creates):
#   capture = /dev/dsp.capture
#   bridge  = /dev/dsp.play
#   loop    = /dev/dsp.loop
#   dac     = /dev/dsp.dac
#
# Linux defaults (ALSA, named the way brutefir names them and translated to the
# /dev/snd node; card may be a number or an id, "hw:Loopback,1" works):
#   capture =                 ; unset follows the capture interface selected on
#                             ; the /configuration page (/run/omdrc/audio.roles)
#   bridge  = hw:1,0          ; snd-aloop playback side, MPD writes into it
#   loop    = hw:1,1          ; snd-aloop capture side, brutefir reads it
#   dac     = hw:0,0

# -- Log alerts -------------------------------------------------------------
# Each [alert:<id>] section watches the logs for one condition and reports it in
# the web UI: error/warn/info show as a banner at the top of the page, ok as a
# status line under the renderer buttons.
#
#   pattern  - regex (Python syntax); a matching line raises the alert
#   clears   - optional regex; a match NEWER than the pattern's cancels it
#   message  - what the UI shows
#   hint     - optional second line, what to do about it
#   severity - error | warn | info | ok   (default warn)
#   sources  - comma-separated source ids to watch (default: all of them)
#   service  - the program the rule speaks for; while it is not running the
#              alert is reported as info and `ok` rules stay silent
#   action   - optional UI action button on the banner: qobuz-oauth (upmpdcli)
#              or qconnect-oauth (qobuzconnect2mpd)
#   clears_file / clears_file_pattern - the rule is not raised while that file
#              matches that regex (a fact on disk beating a stale log tail);
#              @qobuz_token@ stands for the Qobuz token file
#
# Keep a rule and its `clears` on the same source: "newer than" is only
# meaningful within one log.  A literal % must be written %% (configparser).
#
# Qobuz has no success line to match: qobuz-app.py logs "Qobuz running" and then
# logs in silently, printing "oauth initialisation not done" (no token) or
# "/user/login returns ..." (token refused) only on failure.  So the rules below
# are each other's inverse — a startup or a completed sign-in with no failure
# after it is reported as connected.
#
# Match a failure *sense*, not the co-occurrence of "qobuz" and "oauth": a
# successful sign-in logs "session: init_oauth: auth_code ..." and "Qobuz:
# trackuri: OAuth initialisation", which name both words while meaning the
# opposite.  A looser pattern reports a working login as broken.
#
# `service` matters as much as `sources` here.  Each renderer has its OWN Qobuz
# login — upmpdcli's plugin token under cachedir, qobuzconnect2mpd's under its
# qconnectstatedir — and each log outlives the program that wrote it.  Naming the
# service keeps a stopped renderer's stale log from demanding anything: it is
# reported as info, and its `ok` rules go quiet entirely.

[alert:qobuz_oauth]
severity = warn
service  = upmpdcli
sources  = upmpdcli-console
action   = qobuz-oauth
pattern  = (?i)(oauth\s+initiali\w*\s+not\s+done|oauth.*\bnot\s+done\b|\bnot\s+done\b.*oauth|oauth\s+initiali\w*\s+missing|(qobuz|oauth).*\bno\s+token\b)
clears   = (?i)(qobuz.*running|got\s+auth_code|init_oauth:\s*auth_code|trackuri.*oauth\s+initiali)
clears_file         = @qobuz_token@
clears_file_pattern = user_auth_token\s*=\s*\S
message  = upmpdcli: Qobuz OAuth initialisation not done
hint     = Press Qobuz sign-in: the panel runs the OAuth script and shows the URL to open in this browser.  upmpdcli must be running to receive the redirect.

# A token exists but Qobuz would not take it — deliberately no clears_file:
# this is exactly the case a stored token does not settle.
[alert:qobuz_login]
severity = warn
service  = upmpdcli
sources  = upmpdcli-console
action   = qobuz-oauth
pattern  = (?i)(/user/login\s+returns|tried login but failed|qobuz.*login.*fail)
clears   = (?i)(qobuz.*running|got\s+auth_code|init_oauth:\s*auth_code|trackuri.*oauth\s+initiali)
message  = upmpdcli: Qobuz refused the stored login
hint     = The token is there but was not accepted — sign in again.

[alert:qobuz_ok]
severity = ok
service  = upmpdcli
sources  = upmpdcli-console
pattern  = (?i)(qobuz.*running|got\s+auth_code|init_oauth:\s*auth_code|trackuri.*oauth\s+initiali)
clears   = (?i)((oauth\s+initiali\w*\s+not\s+done|oauth.*\bnot\s+done\b|\bnot\s+done\b.*oauth|oauth\s+initiali\w*\s+missing|(qobuz|oauth).*\bno\s+token\b)|(/user/login\s+returns|tried login but failed|qobuz.*login.*fail))
message  = upmpdcli: Qobuz plugin connected
hint     = Started or signed in, and reported no login failure afterwards.

[alert:upmpdcli_mpd_ok]
severity = ok
service  = upmpdcli
sources  = upmpdcli
pattern  = (?i)mpdcli::openconn:\s*mpd connected ok
clears   = (?i)(mpd connection failed|mpdcli::openconn:.*failed|mpdcli::eventloop:\s*could not open connection)
message  = upmpdcli: MPD connected
hint     = The renderer established its local MPD control connection.

# qobuzconnect2mpd is a different program with a different login and its own
# OAuth flow.  Its action starts `-L` as AUDIO_USER, keeps that process
# alive for the browser redirect, then starts the normal renderer after the
# token is cached.  No clears_file: its token and upmpdcli's have different
# formats/paths, so the authenticated service startup is the source of truth.
[alert:qconnect_auth]
severity = warn
service  = qobuzconnect2mpd
sources  = qobuzconnect2mpd
action   = qconnect-oauth
pattern  = (?i)(not authenticated|no auth token|cannot stream until it is authenticated|waiting for .*oauth login|login not completed within the timeout|oauth (code exchange|token exchange|callback) failed|token could not be persisted)
clears   = (?i)qobuzconnect2mpd:\s*qobuz plugin connected
message  = qobuzconnect2mpd is not signed in to Qobuz
hint     = Press sign in: the panel starts qobuzconnect2mpd's own OAuth bootstrap and opens its remote-browser redirect flow.

[alert:qconnect_mpd_ok]
severity = ok
service  = qobuzconnect2mpd
sources  = qobuzconnect2mpd
pattern  = (?i)qconnect2mpd:\s*mpd connected ok
clears   = (?i)qconnect2mpd:\s*mpd connect failed
message  = qobuzconnect2mpd: MPD connected
hint     = The renderer established its local MPD control connection.

[alert:qconnect_ok]
severity = ok
service  = qobuzconnect2mpd
sources  = qobuzconnect2mpd
pattern  = (?i)qobuzconnect2mpd:\s*qobuz plugin connected
clears   = (?i)(not authenticated|no auth token|cannot stream until it is authenticated|waiting for .*oauth login|login not completed within the timeout|oauth (code exchange|token exchange|callback) failed|token could not be persisted)
message  = qobuzconnect2mpd: Qobuz plugin connected
hint     = Qobuz accepted its OAuth-backed cloud session.

# -- Qobuz OAuth sign-in ----------------------------------------------------
# Drives upmpdcli's qobuz-init-oauth.py from the panel, so a headless box needs
# no keyboard: the script prints the sign-in URLs and the web UI shows them.
# Signing in redirects to upmpdcli's own media-server port, which stores the
# token — so upmpdcli must be RUNNING, and the browser must be able to reach the
# host in the redirect URL (the panel offers the address you are using).
[qobuz_oauth]
script = /usr/local/share/upmpdcli/cdplugins/qobuz/qobuz-init-oauth.py
# upmpdcli.conf the script reads the media-server host/port from.  Leave empty
# to search ${PREFIX}/etc/open-media-drc/, ${PREFIX}/etc/ and /etc/.
upmpdcli_config =
# Token file written by the plugin.  Empty: <cachedir>/qobuz/config, with
# cachedir taken from upmpdcli.conf.
cache_config =
# Seconds to wait for the script (it fetches the Qobuz app id over the net).
timeout = 45

# qobuzconnect2mpd has its own token and a long-lived `-L` bootstrap.  The
# panel stops its normal service, starts this process, shows the URL it prints,
# leaves it alive to receive the browser redirect, then starts and remembers
# qobuzconnect2mpd after the token is cached.
[qconnect_oauth]
binary = qobuzconnect2mpd
# Empty searches ~/.config/qobuzconnect2mpd/qobuzconnect2mpd.conf,
# ${PREFIX}/etc/qobuzconnect2mpd.conf, then /etc/qobuzconnect2mpd.conf.
config =
# Empty on both OSes: omdrcctrl and both renderers all run as AUDIO_USER.  A
# non-empty override remains available for non-standard installations and uses
# non-interactive sudo when it differs from the controller's user.
run_user =
# Seconds to wait for app-id discovery and the sign-in URL.  The callback itself
# stays alive for qobuzconnect2mpd's own five-minute timeout.
url_timeout = 45

[drc_status]
what    = Active config
group   = drc
type    = READ
refresh = 5
cmd     = @OMDRC_DRC_STATUS@

[drc_off]
what    = OFF
group   = drc
type    = WRITE
button  = Apply
confirm = yes
confirm_message = Turning DRC off removes BruteFIR's fixed 8 dB of attenuation: the same digital signal will play about 8 dB LOUDER. Turn your amplifier/preamp volume DOWN by roughly 8 dB first, then Apply.
cmd     = @OMDRC_DRC@ off
process = brutefir

[drc_resamp]
what    = Flat (0 dB) - auto resample
group   = drc
type    = WRITE
button  = Apply
cmd     = @OMDRC_DRC@ resamp
process = brutefir
details_link = https://github.com/delleceste/DRC-120.blue/tree/master/README.md

[drc_192000]
what    = 192
group   = drc
type    = WRITE
button  = Apply
cmd     = @OMDRC_DRC@ 192000
process = brutefir

[drc_96000]
what    = 96
group   = drc
type    = WRITE
button  = Apply
cmd     = @OMDRC_DRC@ 96000
process = brutefir

[drc_88200]
what    = 88.2
group   = drc
type    = WRITE
button  = Apply
cmd     = @OMDRC_DRC@ 88200
process = brutefir

[drc_48000]
what    = 48
group   = drc
type    = WRITE
button  = Apply
cmd     = @OMDRC_DRC@ 48000
process = brutefir

[drc_44100]
what    = 44.1
group   = drc
type    = WRITE
button  = Apply
cmd     = @OMDRC_DRC@ 44100
process = brutefir

# The CD capture source.  Selecting any rate above hands the loopback back to
# MPD and stops the bridge.
[drc_cdin]
what    = CD in
group   = drc
type    = WRITE
button  = Apply
cmd     = @OMDRC_DRC@ cdin
process = brutefir

[chrome]
what   = Google Chrome
group  = apps
type   = WRITE
button = Launch
cmd    = google-chrome

[kodi]
what   = Kodi media center
group  = apps
type   = WRITE
button = Launch
cmd    = kodi

[reboot]
what    = Reboot system
group   = system
type    = WRITE
button  = Reboot
confirm = yes
cmd     = sudo reboot

[reboot_to_arch]
what     = Reboot into Linux
group    = system
os       = FreeBSD
type     = WRITE
button   = Reboot into Linux
confirm  = yes
cmd      = /usr/local/sbin/reboot-to-arch

[reboot_freebsd]
what    = Reboot to FreeBSD
group   = system
type    = WRITE
button  = Reboot to FreeBSD
confirm = yes
os      = Linux
# The helper makes FreeBSD GRUB's saved default and then reboots, both of
# which need root — it exits 1 with "Must run as root." otherwise, and the
# click appears to do nothing.  Same shape as [reboot] above.
# The switch is sticky, not one-shot: FreeBSD stays the default until
# something changes it, and picking "Arch Linux" at the GRUB menu is the
# return path.  See scripts/grub-reboot-to-freebsd.sh.
cmd     = sudo grub-reboot-to-freebsd.sh

[poweroff]
what    = Power off
group   = system
type    = WRITE
button  = Off
confirm = yes
cmd     = sudo poweroff
