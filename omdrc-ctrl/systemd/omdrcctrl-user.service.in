[Unit]
Description=OMDRC Control – web remote-control interface (:9090)
After=network-online.target sound.target
Wants=network-online.target

# systemd --user unit (installed by `cmake -DUSER_INSTALL=ON`).  This is a
# convenience mode for developers / single-user boxes: it installs into
# ~/.local and needs no root.  It is NOT the mode a distributable package ships
# — packages register the system unit (omdrcctrl.service), which is the
# canonical model on both Linux and FreeBSD.
#
# Running in the user scope means XDG_RUNTIME_DIR and the session bus are
# present natively, so the renderer toggle (`systemctl --user` against the
# qobuzconnect2mpd / upmpdcli user services) just works.  Note this is no
# longer a hard requirement: the system unit reaches the same bus because
# app.py's _env() derives XDG_RUNTIME_DIR / DBUS_SESSION_BUS_ADDRESS from the
# uid.  The system unit only needs /run/user/<uid> to exist — i.e. the user
# logged in, or lingering enabled (see below).
#
# Enable lingering so this unit survives logout / starts at boot:
#   loginctl enable-linger <user>

[Service]
Type=simple
Environment=DISPLAY=:0
ExecStart=@CMAKE_INSTALL_PREFIX@/bin/omdrcctrl
Restart=on-failure
RestartSec=5
KillMode=process

[Install]
WantedBy=default.target
