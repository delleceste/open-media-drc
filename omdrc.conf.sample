# open-media-drc configuration — INSTALLED mode sample.
#
# Copy to ${PREFIX}/etc/open-media-drc/omdrc.conf (usually
# /usr/local/etc/open-media-drc/omdrc.conf) and edit.  Read (sourced as shell)
# by drc.sh / drc-status.sh when no config.env sits beside them; a repo
# checkout keeps using its own config.env instead and ignores this file.
# $OMDRC_CONF overrides the location in both modes.

# Speaker geometry / filter set: $OMDRC_SITE_DIR/configs/$GEOMETRY/
# brutefir-<rate>.conf.  Default "flat" = identity dirac-pulse filters, no
# correction.  To add real room correction see FILTERS_AND_DRC.md: put per-rate
# filters + configs under $OMDRC_SITE_DIR/{filters,configs}/<name>/ and set
# GEOMETRY=<name>.
#GEOMETRY=flat

# Where configs/ and filters/ live.  Default: ${PREFIX}/etc/open-media-drc.
#OMDRC_SITE_DIR=/usr/local/etc/open-media-drc

# Runtime state (last_arg, last_power, drc.log).  Default: /var/db/omdrc when
# run as root, ~/.local/state/omdrc otherwise.  Interactive runs and the rc.d
# service must share state — pin it here to be explicit.
#OMDRC_STATE_DIR=/var/db/omdrc

# The user that owns brutefir / the audio session (informational here; an
# installed box gets these from host.cmake at configure time).
#AUDIO_USER=media
#AUDIO_HOME=/home/media

# Music library location (for the mpd config templates).
#MUSIC_DIR=/media/music

# UPnP/OpenHome renderer friendly name (defaults to hostname).
#FRIENDLY_NAME=

# DAC warm-up knobs (see comments in drc.sh; env-overridable per run).
#DAC_WARMUP_SECS=3
#DAC_SETTLE_SECS=1
#DAC_PRIME_CYCLES=0

# ── the capture sources ─────────────────────────────────────────────────────
# `drc.sh cdin` and `drc.sh linein` run the same input bridge; these six values
# are the whole difference between them.  See doc/CDIN-LINUX.md.
#
# The rate is the rate the source ARRIVES at, not a preference: a CD is
# 44.1 kHz because Red Book says so, and an analog input is whatever its
# converter runs at.  Asking a card for a rate it does not have does not fail —
# ALSA's plug layer resamples and nothing reports it.  The active filter set
# must have a config for the rate, or `drc.sh geometry` refuses the switch.
#CDIN_RATE=44100
#LINEIN_RATE=96000

# The input to select on the capture card, passed to the bridge verbatim:
# "auto" picks the card's digital item (iec958 / s-pdif / optical / coax),
# "keep" leaves the card alone, anything else is a mixer item name.  List a
# card's items with:  amixer -c <card> contents | grep -i -A5 'Capture Source'
# Cards with no such control are unaffected either way.
#CDIN_CAPTURE_SOURCE=auto
#LINEIN_CAPTURE_SOURCE=Line

# The PCM device index within the card, for cards that put the digital input on
# a second device instead of behind the selector — the USB Sound Blaster HD is
# one: analog on device 0, S/PDIF on device 1.
#CDIN_CAPTURE_DEVICE=0
#LINEIN_CAPTURE_DEVICE=0
