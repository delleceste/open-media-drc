// Which FreeBSD layer each in-tree patch touches.
digraph patches_map {
    rankdir=TB;
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#eef4fb", color="#4a6d94"];
    edge [fontname="Helvetica", fontsize=9, color="#555555"];

    subgraph cluster_kernel {
        label="Kernel (base)"; fontsize=11; style=dashed; color="#999999";
        uaudio [label="uaudio(4)\nsnd_uaudio.ko"];
        cuse   [label="cuse(3)\ncuse.ko"];
    }
    subgraph cluster_user {
        label="Userland (base)"; fontsize=11; style=dashed; color="#999999";
        voss [label="virtual_oss\n/usr/sbin/virtual_oss"];
    }
    subgraph cluster_ports {
        label="Ports"; fontsize=11; style=dashed; color="#999999";
        kodi [label="multimedia/kodi\nAESinkOSS.cpp"];
    }

    p1 [label="uaudio-clock-before-alt\n(rate-change cold-open silence)", shape=note, fillcolor="#fdf3d8"];
    p2 [label="uaudio-shared-clock-fix\n(44.1 kHz flicker, bug 295933)", shape=note, fillcolor="#fdf3d8"];
    p3 [label="uaudio-feedback-follow\n(candidate, needs rebase)", shape=note, fillcolor="#f5f5f5"];
    p4 [label="virtual_oss-settrigger-sync-deadlock\n(155% CPU livelock)", shape=note, fillcolor="#fdf3d8"];
    p5 [label="virtual_oss teardown\n(destroy cuse devices on exit)", shape=note, fillcolor="#fdf3d8"];
    p6 [label="cuse-client-open-refleak-fix\n(bug 296291, D-state wedge)", shape=note, fillcolor="#fdf3d8"];
    p7 [label="Kodi OSS sink:\nenumerate userspace devices", shape=note, fillcolor="#fdf3d8"];

    p1 -> uaudio; p2 -> uaudio; p3 -> uaudio;
    p4 -> voss;  p5 -> voss;
    p6 -> cuse;
    p7 -> kodi;
}
