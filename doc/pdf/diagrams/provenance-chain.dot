// Filter provenance: from REW exports to a green "verified" badge.
// Every arrow labelled with a hash is a content check that must pass.
digraph provenance_chain {
    rankdir=TB;
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled",
          fillcolor="#eef4fb", color="#4a6d94"];
    edge [fontname="Helvetica", fontsize=8, color="#555555"];

    subgraph cluster_source {
        label="Source repository (DRC-<room>, separate checkout)";
        fontname="Helvetica"; fontsize=10; color="#bbbbbb"; style=dashed;
        mdat   [label="<session>.mdat\nthe REW measurement session", fillcolor="#fdf3d8"];
        rew    [label="<session>.txts/\nL, R, LR | L+R, FLX/FRX,\n*.filtered | L+R.remeasured", fillcolor="#fdf3d8"];
        head   [label="git commit in the project\nHEAD + one blob per input", fillcolor="#fdf3d8"];
        mdat -> rew [label="exported by REW"];
        rew -> head [label="git add + git commit\n(required: uncommitted stops the deploy)"];
        mdat -> head [style=dashed, label="hashed into the manifest"];
    }

    subgraph cluster_site {
        label="Site repository (configs/ + filters/, e.g. omdrc-801N)";
        fontname="Helvetica"; fontsize=10; color="#bbbbbb"; style=dashed;
        copies [label="source/<design>/\nverbatim copies of the exports"];
        raws   [label="<rate>/[@<design>/]{L,R}.raw\nFLOAT64_LE coefficients"];
        conf   [label="configs/<geo>/brutefir-<rate>[@<design>].conf.in\ntemplate"];
        ana    [label="analysis/<design>.json\nprecomputed response traces"];
        man    [label="provenance/<design>.json\nMANIFEST: bundle_id binds all of it",
                 fillcolor="#dff0df"];
        copies -> man; raws -> man; conf -> man; ana -> man;
    }

    head -> copies [label="new_filter_design.py -> deploy_filter.py\nnames every role from the filenames,\nchecks each filter TXT against its WAV,\nrecords the commit and the .mdat hash"];
    raws -> ana   [style=invis];

    hist  [label="room history\ngit checkout <commit> -- filters/ configs/", fillcolor="#dff0df"];
    inst  [label="make install\n$PREFIX/etc/open-media-drc/", fillcolor="#f3e6f5"];
    bf    [label="BruteFIR\nloads the rendered .conf"];
    ui    [label="omdrc-ctrl Filter response\nverified (green) / mismatch (red)", fillcolor="#f3e6f5"];

    man -> hist [label="one commit in the room repository:\ngit log = every filter set ever live"];
    man -> inst [label="CMake runs verify_filter_bundle.py first;\n@design without a manifest is fatal"];
    inst -> bf;
    bf -> ui    [label="hash the RAWs actually loaded;\nrelease stored curves only on\na single exact manifest match"];
}
