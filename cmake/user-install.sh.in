#!/bin/sh
# Per-user setup for open-media-drc.  Run AS THE AUDIO USER after the system
# install:
#     sudo cmake --install build      # (or sudo make install)
#     cmake --build build --target user-install   # (or: make user-install)
#
# It does only what a root/system install cannot: the systemd --user services,
# the desktop autostart symlink, and the per-user BruteFIR defaults.  Idempotent,
# and it never uses sudo itself — the two steps that need root (linger, the
# audio group) are printed for you to run.  Rendered by CMake from host.cmake.
set -u

PREFIX="@CMAKE_INSTALL_PREFIX@"
CFG="${XDG_CONFIG_HOME:-$HOME/.config}"

if [ "$(id -u)" -eq 0 ]; then
    echo "user-install: run this as the audio user, not root." >&2
    exit 1
fi

# --- BruteFIR runtime defaults (OS-specific source; required or brutefir fails) ---
mkdir -p "$CFG/BruteFIR"
if [ "$(uname)" = "Linux" ]; then
    _bf="$PREFIX/share/omdrc/brutefir_defaults.linux.conf"
else
    _bf="$PREFIX/share/omdrc/brutefir_defaults.conf"
fi
_defaults="$CFG/BruteFIR/brutefir_defaults.conf"
if [ -e "$_defaults" ]; then
    echo "user-install: keeping existing $_defaults"
elif [ -f "$_bf" ]; then
    cp "$_bf" "$_defaults" && echo "user-install: installed BruteFIR defaults"
fi

# The defaults file is hand-edited (device lines, plugin path), so the copy above
# never overwrites one that exists.  The `# omdrc-managed-dac` marker is the
# exception: omdrc-config-helper finds the output device line by that comment, so
# a defaults file written before the marker existed fails every DAC selection
# from the web UI with no hint of why.  Add the marker in place — the comment
# only, never the device value — which is the one edit an upgrade owes a file it
# otherwise leaves alone.  FreeBSD pins the DAC through sysrc and has no marker.
if [ "$(uname)" = "Linux" ] && [ -f "$_defaults" ] &&
   ! grep -q 'omdrc-managed-dac' "$_defaults"; then
    _tmp="$_defaults.omdrc-new"
    # First device line inside the output block: the enclosing `device: "alsa" {`
    # ends in a brace, not a semicolon, so it cannot match.
    if awk '
        /^[[:space:]]*output[[:space:]]*\{/ { in_output = 1 }
        in_output && !marked && /^[[:space:]]*device:[[:space:]]*"[^"]*";/ {
            sub(/;.*$/, "; # omdrc-managed-dac"); marked = 1
        }
        { print }
        END { exit !marked }
    ' "$_defaults" > "$_tmp"; then
        mv "$_tmp" "$_defaults" &&
            echo "user-install: marked the output device in $_defaults omdrc-managed"
    else
        rm -f "$_tmp"
        echo "user-install: no output device line found in $_defaults; add" \
             "'# omdrc-managed-dac' to it by hand or DAC selection will fail" >&2
    fi
fi

# --- where a --user unit has to be linked, if anywhere ------------------------
# systemd's default user unit path already contains $PREFIX/lib/systemd/user for
# the standard prefixes (/usr, /usr/local), so linking an installed unit into
# $CFG is not just redundant, it is harmful: the copy in $CFG makes the unit
# "linked", and `systemctl --user enable` then refuses to operate on it ("Refusing
# to operate on linked unit file").  Worse, while any older enablement symlink
# still names the same unit by another path, systemd reports the unit file state
# as `bad`.  Link only for a prefix systemd would never look in on its own.
_omdrc_needs_link() {
    _paths=$(systemctl --user show --property=UnitPath --value 2>/dev/null) ||
        _paths=""
    if [ -z "$_paths" ]; then      # systemd too old to ask: assume the defaults
        case "$PREFIX" in
            /usr|/usr/local) return 1 ;;
            *) return 0 ;;
        esac
    fi
    for _p in $_paths; do
        [ "$_p" = "$PREFIX/lib/systemd/user" ] && return 1
    done
    return 0
}

# Link $1 (a unit name) into $CFG only when systemd cannot already see it, and
# clear any link left by an earlier install that did so unconditionally.
_omdrc_link_unit() {
    if _omdrc_needs_link; then
        mkdir -p "$CFG/systemd/user"
        ln -sf "$PREFIX/lib/systemd/user/$1" "$CFG/systemd/user/$1"
    elif [ -L "$CFG/systemd/user/$1" ]; then
        rm -f "$CFG/systemd/user/$1"
        echo "user-install: dropped redundant link $CFG/systemd/user/$1"
    fi
}

# --- omdrcvideo idle-mpv autostart (desktop session, both OSes) ---
if [ -f "$PREFIX/share/omdrcvideo/autostart/mpv-idle.desktop" ]; then
    mkdir -p "$CFG/autostart"
    ln -sf "$PREFIX/share/omdrcvideo/autostart/mpv-idle.desktop" \
           "$CFG/autostart/mpv-idle.desktop"
    echo "user-install: linked mpv-idle autostart"
fi

# --- omdrcvideo --user service (Linux; FreeBSD serves the web UI from rc.d) ---
if [ "$(uname)" = "Linux" ] && [ -f "$PREFIX/lib/systemd/user/omdrcvideo.service" ]; then
    _omdrc_link_unit omdrcvideo.service
    systemctl --user daemon-reload 2>/dev/null || true
    if systemctl --user enable --now omdrcvideo.service 2>/dev/null; then
        echo "user-install: enabled omdrcvideo (:9080)"
    else
        echo "user-install: enable omdrcvideo later: systemctl --user enable --now omdrcvideo"
    fi
    loginctl enable-linger "$(id -un)" 2>/dev/null \
        || echo "user-install: to survive logout, run: sudo loginctl enable-linger $(id -un)"
fi

# --- remembered renderer restore (Linux user scope) --------------------------
# Both switchable renderers must be in the same --user scope.  Enable the
# restore unit, never one renderer directly, or two front-ends can drive MPD.
if [ "$(uname)" = "Linux" ] && \
        [ -f "$PREFIX/lib/systemd/user/upmpdcli.service" ] && \
        [ -f "$PREFIX/lib/systemd/user/omdrc-renderer.service" ]; then
    _omdrc_link_unit upmpdcli.service
    _omdrc_link_unit omdrc-renderer.service
    systemctl --user daemon-reload 2>/dev/null || true
    systemctl --user disable upmpdcli.service qobuzconnect2mpd.service \
        2>/dev/null || true
    if systemctl --user enable --now omdrc-renderer.service 2>/dev/null; then
        echo "user-install: enabled remembered renderer restore"
    else
        echo "user-install: enable renderer later: systemctl --user enable --now omdrc-renderer"
    fi
fi

# --- CD / S-PDIF input bridge (Linux; deliberately not enabled) --------------
# The CD input is an exclusive source here (one seat on hw:Loopback,0,0) and
# drc.sh starts/stops the unit as the source changes, so it only has to be
# visible to systemd: `drc.sh cdin` selects the input, and any rate action hands
# the loopback back to MPD.  Enabling it would fight that.
if [ "$(uname)" = "Linux" ] && [ -f "$PREFIX/lib/systemd/user/omdrc-cdin.service" ]; then
    _omdrc_link_unit omdrc-cdin.service
    systemctl --user daemon-reload 2>/dev/null || true
    echo "user-install: omdrc-cdin available (started on demand by 'drc.sh cdin')"
fi

# --- ALSA hw access needs the 'audio' group (root; advise only) ---
if [ "$(uname)" = "Linux" ]; then
    if ! id -nG 2>/dev/null | tr ' ' '\n' | grep -qx audio; then
        echo "user-install: for ALSA hw access run: sudo usermod -aG audio $(id -un)  (then re-login)"
    fi
fi

echo "user-install: done."
