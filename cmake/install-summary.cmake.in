# Final installation handoff. Generated by the top-level project and installed
# last, after core-drc, omdrcctrl and omdrcvideo have all completed.

message("")
message("======================================================================")
message(" open-media-drc installation complete: @CMAKE_INSTALL_PREFIX@")
message(" Host config: @CMAKE_INSTALL_PREFIX@/etc/open-media-drc/omdrc.conf")
message(" Existing host/application configs are preserved on reinstall.")
message(" Real-host installs normalize writable MPD/renderer state for @AUDIO_USER@.")
message(" make install copies files only; it does not switch DRC or restart services.")

if("@OMDRC_SERVICE_MANAGER@" STREQUAL "systemd")
    message("")
    message(" FIRST INSTALL / HOST INTEGRATION (Linux)")
    message(" 1. Copy the files that are read from /etc (modprobe, systemd-modules-load")
    message("    and udev read /etc and /lib, never @CMAKE_INSTALL_PREFIX@/lib):")
    message("      sudo cp @CMAKE_INSTALL_PREFIX@/lib/udev/rules.d/99-usb-audio-drc.rules /etc/udev/rules.d/")
    message("      sudo cp @CMAKE_INSTALL_PREFIX@/lib/modules-load.d/snd-aloop.conf /etc/modules-load.d/")
    message("      sudo cp @CMAKE_INSTALL_PREFIX@/lib/modprobe.d/omdrc-snd-aloop.conf /etc/modprobe.d/")
    message("      sudo modprobe -r snd_aloop 2>/dev/null; sudo modprobe snd-aloop")
    message("      sudo cp @CMAKE_INSTALL_PREFIX@/share/omdrc/sudoers.d/omdrcctrl-renderer /etc/sudoers.d/")
    message("      sudo chmod 0440 /etc/sudoers.d/omdrcctrl-renderer && sudo visudo -c")
    message("    Copy BOTH aloop files: the modprobe.d one pins the loopback's card")
    message("    index (mpd.conf and brutefir_defaults.linux.conf name hw:1,1) and")
    message("    clocks it from the DAC instead of a free-running hrtimer.  Loading the")
    message("    module without it yields a chain that drifts and hides it in ignore_xrun.")
    message("    The sudoers snippet (already syntax-checked by this install) grants")
    message("    @AUDIO_USER@ passwordless start/stop on exactly qobuzconnect2mpd.service and")
    message("    upmpdcli.service -- what omdrcctrl's web toggle and omdrc-renderer need below.")
    message(" 2. Reload/enable system scope. upmpdcli/qobuzconnect2mpd/omdrc-renderer are")
    message("    system services with User=@AUDIO_USER@; leave the two renderers DISABLED")
    message("    and enable only the restorer, which starts whichever one was last active:")
    message("      sudo systemctl disable --now mpd.socket upmpdcli.service qobuzconnect2mpd.service 2>/dev/null || true")
    message("      sudo systemctl daemon-reload")
    message("      sudo udevadm control --reload-rules")
    message("      sudo systemctl enable --now mpd omdrcctrl omdrc-renderer")
    message("    Keep qconnectstatedir=@AUDIO_HOME@/.local/state/qobuzconnect2mpd explicit in")
    message("    qobuzconnect2mpd.conf (mirrors FreeBSD's /var/db/qobuzconnect2mpd pin) so a")
    message("    future build cannot silently miss the cached token and re-login fresh.")
    message(" 3. As @AUDIO_USER@, from this build directory:")
    message("      make user-install")
    message("    This installs BruteFIR defaults, mpv autostart and omdrcvideo (still --user:")
    message("    it drives the desktop session's own idle mpv). It prints any linger/")
    message("    audio-group action still requiring sudo.")
    message(" 4. Existing installation after an upgrade:")
    message("      sudo systemctl daemon-reload && sudo systemctl restart omdrcctrl")
else()
    message("")
    message(" FIRST INSTALL / HOST INTEGRATION (FreeBSD)")
    message(" 1. Kernel/audio-user prerequisites:")
    message("      sudo sysrc kld_list+=cuse && sudo kldload cuse")
    message("      configure non-interactive sudo for the virtual_oss lifecycle used by omdrc")
    message(" 2. Configure rc.d ownership and startup:")
    message("      sudo sysrc musicpd_enable=YES musicpd_config=@CMAKE_INSTALL_PREFIX@/etc/open-media-drc/musicpd.conf")
    message("      sudo sysrc omdrc_renderer_enable=YES omdrcctrl_enable=YES omdrcvideo_enable=YES")
    message("      sudo sysrc omdrcctrl_user=@AUDIO_USER@ omdrcvideo_user=@AUDIO_USER@")
    message("      sudo sysrc qobuzconnect2mpd_user=@AUDIO_USER@ qobuzconnect2mpd_group=$(id -gn @AUDIO_USER@)")
    message("      sudo sysrc qobuzconnect2mpd_homedir=/var/db/qobuzconnect2mpd")
    message("      sudo sysrc upmpdcli_enable=NO qobuzconnect2mpd_enable=NO")
    message("      sudo sysrc omdrc_audio_enable=YES omdrc_audio_user=@AUDIO_USER@")
    message("    omdrc_audio owns role links and the DRC lifecycle; remove old drc_usb_audio/brutefir_drc/omdrc_sndlink keys.")
    message("    For the CD input, name the capture card as well (it is what creates /dev/dsp.capture):")
    message("      sudo sysrc omdrc_audio_capture=\"ESI U24XL\"   # or 0xVID:0xPID")
    message("    omdrc_renderer alone restores the last renderer; do not enable either renderer directly.")
    message("    qobuzconnect2mpd.conf must keep qconnectstatedir=/var/db/qobuzconnect2mpd.")
    message("    Installation automatically migrates MPD/upmpdcli/qobuzconnect2mpd writable state to @AUDIO_USER@.")
    message(" 3. As @AUDIO_USER@, from this build directory:")
    message("      make user-install")
    message("    This installs BruteFIR defaults and the desktop mpv autostart link.")
    message(" 4. Activate a first install (or restart only the affected services on upgrade):")
    message("      sudo service devd restart")
    message("      sudo service musicpd start")
    message("      sudo service omdrc_renderer start")
    message("      sudo service omdrcctrl start && sudo service omdrcvideo start")
    message("      sudo service omdrc_audio start   # creates role links and reconciles DRC")
    message("    After a UI-only reinstall: sudo service omdrcctrl restart")
endif()

message("")
message(" DESKTOP LAUNCHERS")
message(" Menu entries were installed to @CMAKE_INSTALL_PREFIX@/share/applications for")
message(" every browser / mpv found at configure time (the configure output lists which,")
message(" and which were skipped): the No-DRC browsers, Play, and Play Blu-ray.")
message(" Earlier versions asked you to symlink these out of the checkout by hand; such")
message(" symlinks SHADOW the installed entries, so retire them:")
message("      rm -f @AUDIO_HOME@/.local/share/applications/*-nodrc.desktop")
message("      rm -f @AUDIO_HOME@/.local/share/applications/play-*.desktop")
message("      rm -f @AUDIO_HOME@/play-media.sh @AUDIO_HOME@/play-bluray.sh")
message(" A per-user install instead: configure with")
message("      -DCMAKE_INSTALL_PREFIX=@AUDIO_HOME@/.local   (then install without sudo)")

message("")
message(" INSTALLED DRC CONFIGURATIONS")
@OMDRC_INSTALL_CONFIGURATION_MESSAGES@

message("")
message(" VERIFIED PROVENANCE IDENTITIES")
@OMDRC_INSTALL_PROVENANCE_MESSAGES@

message("")
message(" RUNTIME SELECTION / VERIFICATION")
message("      @CMAKE_INSTALL_PREFIX@/bin/omdrc geometry --list")
message("      @CMAKE_INSTALL_PREFIX@/bin/omdrc geometry <geometry>")
message("      @CMAKE_INSTALL_PREFIX@/bin/omdrc design --list")
message("      @CMAKE_INSTALL_PREFIX@/bin/omdrc design <default|@design-id|legacy-selector>")
message(" Open http://<hostname>:9090 and choose Filter response.")
message(" Require the green verified identity to match the selected geometry/design,")
message(" annotated tag, source commit and bundle ID printed above.")
message(" A missing or different identity means the displayed curves must not be trusted.")
message("======================================================================")
