# Final installation handoff. Generated by the top-level project and installed
# last, after core-drc, omdrcctrl and omdrcvideo have all completed.

message(STATUS "")
message(STATUS "======================================================================")
message(STATUS " open-media-drc installation complete: @CMAKE_INSTALL_PREFIX@")
message(STATUS " Host config: @CMAKE_INSTALL_PREFIX@/etc/open-media-drc/omdrc.conf")
message(STATUS " Existing host/application configs are preserved on reinstall.")
message(STATUS " make install copies files only; it does not switch DRC or restart services.")

if("@OMDRC_SERVICE_MANAGER@" STREQUAL "systemd")
    message(STATUS "")
    message(STATUS " FIRST INSTALL / HOST INTEGRATION (Linux)")
    message(STATUS " 1. Install the two files read from /etc and the ALSA loopback module:")
    message(STATUS "      sudo cp @CMAKE_INSTALL_PREFIX@/lib/udev/rules.d/99-usb-audio-drc.rules /etc/udev/rules.d/")
    message(STATUS "      sudo mkdir -p /etc/systemd/system/mpd.service.d")
    message(STATUS "      sudo cp @CMAKE_INSTALL_PREFIX@/share/omdrc/mpd.service.d/open-media-drc.conf /etc/systemd/system/mpd.service.d/")
    message(STATUS "      echo snd-aloop | sudo tee /etc/modules-load.d/snd-aloop.conf")
    message(STATUS "      sudo modprobe snd-aloop")
    message(STATUS " 2. Reload/enable system scope (renderers are deliberately NOT system services):")
    message(STATUS "      sudo systemctl disable --now mpd.socket upmpdcli.service 2>/dev/null || true")
    message(STATUS "      sudo systemctl daemon-reload")
    message(STATUS "      sudo udevadm control --reload-rules")
    message(STATUS "      sudo systemctl enable --now mpd omdrcctrl")
    message(STATUS " 3. As @AUDIO_USER@, from this build directory:")
    message(STATUS "      make user-install")
    message(STATUS "    This installs BruteFIR defaults, mpv autostart, omdrcvideo, and the")
    message(STATUS "    user-scope remembered-renderer service. It leaves individual renderers")
    message(STATUS "    disabled and prints any linger/audio-group action still requiring sudo.")
    message(STATUS " 4. Existing installation after an upgrade:")
    message(STATUS "      sudo systemctl daemon-reload && sudo systemctl restart omdrcctrl")
else()
    message(STATUS "")
    message(STATUS " FIRST INSTALL / HOST INTEGRATION (FreeBSD)")
    message(STATUS " 1. Kernel/audio-user prerequisites:")
    message(STATUS "      sudo sysrc kld_list+=cuse && sudo kldload cuse")
    message(STATUS "      configure non-interactive sudo for the virtual_oss lifecycle used by omdrc")
    message(STATUS " 2. Configure rc.d ownership and startup:")
    message(STATUS "      sudo sysrc musicpd_enable=YES musicpd_config=@CMAKE_INSTALL_PREFIX@/etc/open-media-drc/musicpd.conf")
    message(STATUS "      sudo sysrc omdrc_renderer_enable=YES omdrcctrl_enable=YES omdrcvideo_enable=YES")
    message(STATUS "      sudo sysrc omdrcctrl_user=@AUDIO_USER@ omdrcvideo_user=@AUDIO_USER@")
    message(STATUS "      sudo sysrc qobuzconnect2mpd_user=@AUDIO_USER@ qobuzconnect2mpd_group=$(id -gn @AUDIO_USER@)")
    message(STATUS "      sudo sysrc qobuzconnect2mpd_homedir=/var/db/qobuzconnect2mpd")
    message(STATUS "      sudo sysrc upmpdcli_enable=NO qobuzconnect2mpd_enable=NO")
    message(STATUS "      sudo sysrc omdrc_audio_enable=YES omdrc_audio_user=@AUDIO_USER@")
    message(STATUS "    omdrc_audio owns role links and the DRC lifecycle; remove old drc_usb_audio/brutefir_drc/omdrc_sndlink keys.")
    message(STATUS "    For the CD input, name the capture card as well (it is what creates /dev/dsp.capture):")
    message(STATUS "      sudo sysrc omdrc_audio_capture=\"ESI U24XL\"   # or 0xVID:0xPID")
    message(STATUS "    omdrc_renderer alone restores the last renderer; do not enable either renderer directly.")
    message(STATUS "    qobuzconnect2mpd.conf must keep qconnectstatedir=/var/db/qobuzconnect2mpd.")
    message(STATUS "    Existing dedicated-user install, once: sudo chown -R @AUDIO_USER@:$(id -gn @AUDIO_USER@) /var/db/qobuzconnect2mpd")
    message(STATUS " 3. As @AUDIO_USER@, from this build directory:")
    message(STATUS "      make user-install")
    message(STATUS "    This installs BruteFIR defaults and the desktop mpv autostart link.")
    message(STATUS " 4. Activate a first install (or restart only the affected services on upgrade):")
    message(STATUS "      sudo service devd restart")
    message(STATUS "      sudo service musicpd start")
    message(STATUS "      sudo service omdrc_renderer start")
    message(STATUS "      sudo service omdrcctrl start && sudo service omdrcvideo start")
    message(STATUS "      sudo service omdrc_audio start   # creates role links and reconciles DRC")
    message(STATUS "    After a UI-only reinstall: sudo service omdrcctrl restart")
endif()

message(STATUS "")
message(STATUS " INSTALLED DRC CONFIGURATIONS")
@OMDRC_INSTALL_CONFIGURATION_MESSAGES@

message(STATUS "")
message(STATUS " VERIFIED PROVENANCE IDENTITIES")
@OMDRC_INSTALL_PROVENANCE_MESSAGES@

message(STATUS "")
message(STATUS " RUNTIME SELECTION / VERIFICATION")
message(STATUS "      @CMAKE_INSTALL_PREFIX@/bin/omdrc geometry --list")
message(STATUS "      @CMAKE_INSTALL_PREFIX@/bin/omdrc geometry <geometry>")
message(STATUS "      @CMAKE_INSTALL_PREFIX@/bin/omdrc design --list")
message(STATUS "      @CMAKE_INSTALL_PREFIX@/bin/omdrc design <default|@design-id|legacy-selector>")
message(STATUS " Open http://<hostname>:9090 and choose Filter response.")
message(STATUS " Require the green verified identity to match the selected geometry/design,")
message(STATUS " annotated tag, source commit and bundle ID printed above.")
message(STATUS " A missing or different identity means the displayed curves must not be trusted.")
message(STATUS "======================================================================")
