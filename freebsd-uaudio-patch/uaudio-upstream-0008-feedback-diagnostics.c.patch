+static int
+uaudio_chan_diag_sysctl(SYSCTL_HANDLER_ARGS)
+{
+	struct uaudio_chan *ch = arg1;
+	struct uaudio_chan_diag d;
+	sbintime_t feedback_last_sbt;
+	uint64_t feedback_age_ms;
+	uint32_t feedback_q16;
+	uint32_t feedback_interval_ms;
+	uint32_t feedback_valid;
+	uint32_t running;
+	uint32_t sample_rate;
+	int feedback_rate;
+	int feedback_shift;
+	char buf[768];
+
+	mtx_lock(&ch->lock);
+	d = ch->diag;
+	running = ch->running;
+	sample_rate = ch->cur_alt < ch->num_alt ?
+	    ch->usb_alt[ch->cur_alt].sample_rate : 0;
+	feedback_rate = ch->feedback_rate;
+	feedback_q16 = ch->feedback_q16;
+	feedback_interval_ms = ch->feedback_interval_ms;
+	feedback_valid = ch->feedback_valid;
+	feedback_last_sbt = ch->feedback_last_sbt;
+	feedback_shift = ch->feedback_shift;
+	mtx_unlock(&ch->lock);
+
+	feedback_age_ms = feedback_last_sbt == 0 ? UINT64_MAX :
+	    (uint64_t)((getsbinuptime() - feedback_last_sbt) / SBT_1MS);
+	snprintf(buf, sizeof(buf),
+	    "version=1 running=%u generation=%ju rate=%u source=%u "
+	    "feedback_valid=%u feedback_rate=%d feedback_raw=%u "
+	    "feedback_q16=%u feedback_q16_min=%u feedback_q16_max=%u "
+	    "feedback_shift=%d feedback_interval_ms=%u feedback_age_ms=%ju "
+	    "feedback_updates=%ju feedback_bad=%ju feedback_errors=%ju "
+	    "feedback_stale=%ju play_short_transfers=%ju "
+	    "play_short_bytes=%ju play_errors=%ju",
+	    running, (uintmax_t)d.stream_generation, sample_rate, d.source,
+	    feedback_valid, feedback_rate, d.feedback_raw, feedback_q16,
+	    d.feedback_q16_min, d.feedback_q16_max, feedback_shift,
+	    feedback_interval_ms, (uintmax_t)feedback_age_ms,
+	    (uintmax_t)d.feedback_updates, (uintmax_t)d.feedback_bad,
+	    (uintmax_t)d.feedback_errors, (uintmax_t)d.feedback_stale,
+	    (uintmax_t)d.play_short_transfers,
+	    (uintmax_t)d.play_short_bytes, (uintmax_t)d.play_errors);
+
+	return (sysctl_handle_string(oidp, buf, sizeof(buf), req));
 }
 
