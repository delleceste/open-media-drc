+
+/*
+ * Number and spacing of UAC2 Clock Validity polls after a sample-rate
+ * change.  ~400 ms total cap: long enough to ride out a 44.1<->48 kHz
+ * crystal-domain relock, short enough that we never stall the USB explore
+ * process (which also handles device attach/detach) for long.  Best-effort:
+ * we proceed when this expires.
+ */
+#define	UAUDIO20_CLOCK_VALID_DELAY_MS	10
+#define	UAUDIO20_CLOCK_VALID_POLLS	40
+
+/*
+ * Wait for the clock source to report locked at the freshly programmed rate.
+ *
+ * uaudio_chan_configure() programs the sample rate (SET_CUR on
+ * CS_SAM_FREQ_CONTROL) and then immediately starts isochronous transfers.
+ * A DAC whose 44.1 kHz and 48 kHz rate families come from different master
+ * crystals (e.g. OKTO RESEARCH DAC8 STEREO) needs time to relock its clock
+ * when switching crystal domains; streaming before that relock completes
+ * makes the device render the first stream silent, even though the host sees
+ * healthy asynchronous feedback either way.  USB Audio 2.0 (section
+ * 5.2.5.1.1) defines the Clock Validity control precisely so the host can
+ * wait for this, so poll it here.
+ *
+ * Bounded and best-effort: if the control is unreadable (device/clock does
+ * not implement it) or never reports valid, we give up after the cap and
+ * continue, so a quirky device can never wedge the explore process.
+ *
+ * Context: this runs in the USB explore process (see
+ * uaudio_chan_reconfigure()), a sleepable context that holds no mutex here,
+ * so usbd_do_request() and usb_pause_mtx() are safe exactly as the
+ * uaudio20_set_speed() call just above already relies on.
+ */
+static void
+uaudio20_wait_clock_valid(struct usb_device *udev, uint8_t iface_no,
+    uint8_t clockid)
+{
+	struct usb_device_request req;
+	usb_error_t error;
+	uint8_t valid;
+	int i;
+
+	req.bmRequestType = UT_READ_CLASS_INTERFACE;
+	req.bRequest = UA20_CS_CUR;
+	USETW2(req.wValue, UA20_CS_CLOCK_VALID_CONTROL, 0);
+	USETW2(req.wIndex, clockid, iface_no);
+	USETW(req.wLength, 1);
+
+	for (i = 0; i != UAUDIO20_CLOCK_VALID_POLLS; i++) {
+		valid = 0;
+		error = usbd_do_request(udev, NULL, &req, &valid);
+		if (error != 0) {
+			/* control not supported: nothing to wait for */
+			DPRINTF("clockid=%d validity unreadable: %s\n",
+			    clockid, usbd_errstr(error));
+			return;
+		}
+		if (valid & 1) {
+			DPRINTFN(6, "clockid=%d valid after %d ms\n",
+			    clockid, i * UAUDIO20_CLOCK_VALID_DELAY_MS);
+			return;
+		}
+		usb_pause_mtx(NULL,
+		    USB_MS_TO_TICKS(UAUDIO20_CLOCK_VALID_DELAY_MS));
+	}
+	DPRINTF("clockid=%d not valid after %d ms; continuing anyway\n",
+	    clockid,
+	    UAUDIO20_CLOCK_VALID_POLLS * UAUDIO20_CLOCK_VALID_DELAY_MS);
 }
 
