+/*
+ * Explicit USB Audio feedback is a fixed-point count of samples per USB
+ * (micro)frame.  Mode 1 follows every feedback packet with a phase
+ * accumulator.  Mode 0 retains the historical one-sample-per-second
+ * correction path as a run-time rollback while this change is evaluated on
+ * a wider set of devices.
+ */
 static int uaudio_feedback_mode = 1;
 SYSCTL_INT(_hw_usb_uaudio, OID_AUTO, feedback_mode, CTLFLAG_RWTUN,
     &uaudio_feedback_mode, 0,
     "explicit feedback handling: 0=legacy one-second correction, "
-    "1=continuous fixed-point feedback");
+    "1=continuous fixed-point scheduling");
 
