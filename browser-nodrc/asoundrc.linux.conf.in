# Managed by open-media-drc; generated by the audio-role configuration helper.
# Included from the audio user's ALSA configuration by make install.
# Card IDs survive changes in USB enumeration order; card numbers do not.
# Change physical devices on /configuration; no CMake reconfigure is needed.

defaults.pcm.!card "@_browser_dac@"
defaults.ctl.!card "@_browser_dac@"

# Mix browser streams at 48 kHz. MPD/BruteFIR's explicit hw: devices bypass
# this mixer and retain their existing sample-rate/bit-perfect behavior.
# The DAC must be released by MPD/BruteFIR before a browser starts playback.
pcm.omdrc_browser_mix {
    type dmix
    ipc_key 1330463826
    ipc_key_add_uid true
    slave {
        pcm "hw:CARD=@_browser_dac@,DEV=0"
        format S32_LE
        rate 48000
        channels 2
        period_time 0
        period_size 1024
        buffer_size 4096
    }
    bindings {
        0 0
        1 1
    }
}

pcm.omdrc_browser_playback {
    type plug
    slave.pcm "omdrc_browser_mix"
}

pcm.omdrc_browser_capture {
    type plug
    slave.pcm "@_browser_capture_pcm@"
}

# Override the distribution default and any fallback to card 0.
# Capture uses the selected input independently of the playback card.
pcm.!default {
    type asym
    playback.pcm "omdrc_browser_playback"
    capture.pcm "omdrc_browser_capture"
    hint {
        show on
        description "open-media-drc browser audio (ALSA)"
    }
}

ctl.!default {
    type hw
    card "@_browser_dac@"
}
