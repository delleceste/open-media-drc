[Desktop Entry]
# Rendered from this .in by ../install.sh (@AUDIO_HOME@ from config.env).
# Deploy so it shows in the KDE launcher:
#   ln -sf @AUDIO_HOME@/open-media-drc/browser-nodrc/chromium-nodrc.desktop \
#          @AUDIO_HOME@/.local/share/applications/chromium-nodrc.desktop
Version=1.0
Type=Application
Name=Chromium (No DRC)
Comment=Chromium with BruteFIR/DRC bypassed so the browser plays to the DAC
Exec=@AUDIO_HOME@/open-media-drc/browser-nodrc/chromium-nodrc.sh %U
Icon=chromium
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
StartupWMClass=chromium
