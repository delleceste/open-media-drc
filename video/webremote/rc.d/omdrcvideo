#!/bin/sh
#
# PROVIDE: omdrcvideo
# REQUIRE: NETWORKING LOGIN
# KEYWORD: shutdown
#
# FreeBSD rc.d service for the video webremote (Flask app, video/webremote).
# Rendered from this .in by ../../../install.sh (/home/giacomo/open-media-drc, giacomo come
# from config.env). Run-from-repo: the app is executed straight from this
# checkout, so a `git pull` is the whole update path.
#
# The persistent idle mpv this app drives is NOT started here — it autostarts in
# the KDE/Plasma session so it owns the projector display (see
# autostart/mpv-idle.desktop). This service only serves the web UI / API.

. /etc/rc.subr

name="omdrcvideo"
rcvar="omdrcvideo_enable"

load_rc_config "$name"

: ${omdrcvideo_enable:="NO"}
: ${omdrcvideo_user:="giacomo"}
# rc starts with a minimal PATH; the app shells out to python3, ffmpeg, ffprobe,
# bd_list_titles (all in /usr/local/bin), so set PATH explicitly via ${name}_env
# (rc.subr applies it with env(1)). No DISPLAY needed: it talks to mpv over a
# unix socket, not X.
: ${omdrcvideo_env:="PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin"}

command="/usr/sbin/daemon"

if [ "$(id -u)" -eq 0 ]; then
	# Started as root: rc.subr drops privileges to ${omdrcvideo_user} via su(1).
	# Do NOT also pass daemon -u (double setusercontext() fails).
	: ${omdrcvideo_pidfile:="/var/run/${name}/${name}.pid"}
	: ${omdrcvideo_logfile:="/var/run/${name}/${name}.log"}
else
	# Started unprivileged (service omdrcvideo onestart): nothing to drop to.
	unset omdrcvideo_user
	: ${omdrcvideo_pidfile:="${TMPDIR:-/tmp}/${name}-$(id -un).pid"}
	: ${omdrcvideo_logfile:="${TMPDIR:-/tmp}/${name}-$(id -un).log"}
fi

pidfile="${omdrcvideo_pidfile}"
_app="/home/giacomo/open-media-drc/video/webremote/src/app.py"
_conf="/home/giacomo/open-media-drc/video/webremote/webremote.conf"
command_args="-f -o ${omdrcvideo_logfile} -P ${pidfile} python3 ${_app} --config ${_conf}"

start_precmd="omdrcvideo_precmd"

omdrcvideo_precmd()
{
	# Create the pidfile/logfile dir writable by the run-as user (the daemon
	# writes them after rc.subr drops privileges). Runs as root, pre-su(1).
	for d in "${omdrcvideo_pidfile%/*}" "${omdrcvideo_logfile%/*}"; do
		if [ -n "${omdrcvideo_user}" ]; then
			/usr/bin/install -d -o "${omdrcvideo_user}" -m 0755 "${d}"
		else
			/usr/bin/install -d -m 0755 "${d}"
		fi
	done
}

run_rc_command "$1"
