#!/bin/sh
#
# PROVIDE: omdrcvideo
# REQUIRE: NETWORKING LOGIN
# KEYWORD: shutdown
#
# FreeBSD rc.d service for the video webremote (Flask app, video/webremote).
# Rendered by CMake (configure_file) into the build tree and installed to
# %%PREFIX%%/etc/rc.d/omdrcvideo. It launches the installed wrapper
# (@CMAKE_INSTALL_PREFIX@/bin/omdrcvideo), which points at the installed app +
# config; @OMDRCVIDEO_SERVICE_USER@ comes from host.cmake.
#
# The persistent idle mpv this app drives is NOT started here — it autostarts in
# the desktop session so it owns the projector display (see
# autostart/mpv-idle.desktop). This service only serves the web UI / API.

. /etc/rc.subr

name="omdrcvideo"
rcvar="omdrcvideo_enable"

load_rc_config "$name"

: ${omdrcvideo_enable:="NO"}
: ${omdrcvideo_user:="@OMDRCVIDEO_SERVICE_USER@"}
# rc starts with a minimal PATH; the app shells out to python3, ffmpeg, ffprobe,
# bd_list_titles (all in /usr/local/bin), so set PATH explicitly via ${name}_env
# (rc.subr applies it with env(1)). No DISPLAY needed: it talks to mpv over a
# unix socket, not X.
: ${omdrcvideo_env:="PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin"}

command="/usr/sbin/daemon"

# One rc service has one identity.  A caller's UID must not select a private
# /tmp pidfile: non-root status would miss the boot instance and onestart could
# attempt a duplicate.  rc.subr already suppresses a redundant su(1) when the
# caller is omdrcvideo_user.  It drops privileges on root startup; do not also
# pass daemon -u (double setusercontext() fails).
: ${omdrcvideo_pidfile:="/var/run/${name}/${name}.pid"}
: ${omdrcvideo_logfile:="/var/run/${name}/${name}.log"}

pidfile="${omdrcvideo_pidfile}"
# The installed wrapper bakes in the python3 interpreter, app path and --config.
command_args="-f -M 0644 -o ${omdrcvideo_logfile} -P ${pidfile} @CMAKE_INSTALL_PREFIX@/bin/omdrcvideo"

start_precmd="omdrcvideo_precmd"

omdrcvideo_precmd()
{
	[ -n "${omdrcvideo_user}" ] ||
		err 1 "set omdrcvideo_user in /etc/rc.conf"
	# Create the canonical pidfile/logfile dir writable by the run-as user (the
	# daemon writes them after rc.subr drops privileges).  At boot this runs as
	# root, before rc.subr's su(1).
	for d in "${omdrcvideo_pidfile%/*}" "${omdrcvideo_logfile%/*}"; do
		/usr/bin/install -d -o "${omdrcvideo_user}" -m 0755 "${d}"
	done
}

run_rc_command "$1"
