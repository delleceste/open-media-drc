# video webremote configuration (INI; see ../ARCHITECTURE.md).
# LAN-only service. Never bind to a public interface or expose to the internet.
#
# Rendered from this .in by CMake (configure_file) into the build tree and
# installed to $PREFIX/etc/omdrcvideo/webremote.conf.  @VIDEO_DIR@,
# @OMDB_API_KEY@, @DISC_DEVICE@ come from host.cmake.  Edit the installed copy
# for anything else; a reinstall will not overwrite it.

[server]
host = 0.0.0.0
port = 9080

[media]
# Comma-separated whitelist of browsable media roots. Nothing outside these
# directories can be listed or played. One root for now.
roots = @VIDEO_DIR@

[mpv]
# JSON IPC socket of the persistent idle mpv (matches mpv-idle.sh /
# video/mpv/mpv.conf input-ipc-server).
socket = /tmp/mpv-socket

[avsync]
# A/V sync fine-tune offered by the remote ("⏱ A/V sync" in the transport bar).
# mpv-idle.sh already sets the baseline audio-delay from the DRC audio-path
# latency (../AV-SYNC-DELAY.md); this is the leftover buffering term you dial in
# by eye on a lip-sync scene. The slider is centred on 0 and spans ±range
# seconds; + delays the AUDIO, - delays the VIDEO (mpv's sign convention).
# step = slider/spin-box granularity in seconds. The trim is remembered across
# restarts of mpv and of this app (<thumbs.cache_dir>/avsync.json).
range = 1.0
step  = 0.01

[thumbs]
# ffmpeg frame grabs (cached by path+mtime — generated at most once per file).
# seek_percent = how far into the video to grab.
cache_dir    = ~/.cache/omdrc-video
seek_percent = 10
max_width    = 320
# Background prewarm: a thread generates missing thumbnails for new files so
# browsing is instant. prewarm_interval = rescan period in seconds (0 = once at
# startup only). concurrency = max simultaneous ffmpeg jobs on the headless box.
# Favourites are stored in <cache_dir>/favorites.json.
prewarm_interval = 900
concurrency      = 2

[disc]
# Physical USB Blu-ray drive. When enabled, the main page shows a "Play Blu-ray
# disc" button: the app sets up the gcache read-ahead, picks the longest title,
# and loads it into the idle mpv over IPC (needs passwordless sudo for
# kldload/gcache, same as play-bluray.sh). Eject destroys the cache.
enabled = yes
device  = @DISC_DEVICE@
cache   = bd

[imdb]
# OMDb API key (omdbapi.com — free tier at /apikey.aspx). When set, the details
# panel shows verified IMDb info (year, director, cast, plot, rating) and links
# to the real title page; movie titles are then sent to omdbapi.com. Leave blank
# to disable all external calls — the IMDb button then opens a plain search.
omdb_api_key = @OMDB_API_KEY@
