[Unit]
Description=OMDRC video web remote (Flask app, :9080)
After=network-online.target sound.target
Wants=network-online.target

# systemd --user unit, rendered by CMake (configure_file).  Runs in the user
# scope because it drives the persistent idle mpv started by the desktop session
# autostart, over that session's JSON IPC socket (/tmp/mpv-socket).  This unit
# only serves the web UI / API; the idle mpv is NOT started here (see
# autostart/mpv-idle.desktop).  Enable + linger so it survives logout:
#   systemctl --user enable --now omdrcvideo
#   loginctl enable-linger @OMDRCVIDEO_SERVICE_USER@

[Service]
Type=simple
ExecStart=@CMAKE_INSTALL_PREFIX@/bin/omdrcvideo
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
