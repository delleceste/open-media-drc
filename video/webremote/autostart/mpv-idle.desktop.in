[Desktop Entry]
# KDE/GNOME session autostart for the persistent idle mpv that the video
# webremote drives over its JSON IPC socket.  Rendered by CMake (configure_file).
#
# Symlink into the audio user's autostart dir (see the post-install hint):
#   ln -sf @CMAKE_INSTALL_PREFIX@/share/omdrcvideo/autostart/mpv-idle.desktop \
#          ~/.config/autostart/mpv-idle.desktop
#
# Hidden while idle (mpv-idle.sh uses --idle=yes with no --force-window): no
# window shows until the web app loads a file. Starts with the desktop so mpv
# owns the display / projector.
Type=Application
Name=mpv idle (video web remote)
Comment=Persistent idle mpv that the phone web remote controls over IPC
Exec=@CMAKE_INSTALL_PREFIX@/lib/omdrcvideo/mpv-idle.sh
Icon=mpv
Terminal=false
Categories=AudioVideo;Player;Video;
X-KDE-autostart-phase=2
X-GNOME-Autostart-enabled=true
