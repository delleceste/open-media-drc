[Desktop Entry]
# KDE/Plasma session autostart for the persistent idle mpv that the video
# webremote drives over its JSON IPC socket. Rendered from this .in by
# ../../../install.sh (/home/giacomo/open-media-drc from config.env).
#
# Deploy:
#   ln -sf /home/giacomo/open-media-drc/video/webremote/autostart/mpv-idle.desktop \
#          ~/.config/autostart/mpv-idle.desktop
#
# Hidden while idle (mpv-idle.sh uses --idle=yes with no --force-window): no
# window shows until the web app loads a file. Starts with the desktop so mpv
# owns DISPLAY=:0 / the projector.
Type=Application
Name=mpv idle (video web remote)
Comment=Persistent idle mpv that the phone web remote controls over IPC
Exec=/home/giacomo/open-media-drc/video/webremote/mpv-idle.sh
Icon=mpv
Terminal=false
Categories=AudioVideo;Player;Video;
X-KDE-autostart-phase=2
X-GNOME-Autostart-enabled=true
