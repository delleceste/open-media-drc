[Desktop Entry]
# Rendered and installed by video/webremote/CMakeLists.txt (`make install`)
# into @CMAKE_INSTALL_PREFIX@/share/applications; Exec points at the installed
# launcher, so the install prefix decides system-wide vs per-user scope.
# Appears in Dolphin's "Open With" for video files; also runnable from the menu.
Type=Application
Name=Play (DRC audio)
GenericName=Media Player
Comment=Play a file or URL through the room-correction audio chain (mpv)
Exec=@OMDRC_VIDEO_LAUNCHER_DIR@/play-media.sh %U
Icon=mpv
Terminal=false
Categories=AudioVideo;Player;Video;
MimeType=video/x-matroska;video/mp4;video/x-msvideo;video/quicktime;video/webm;video/mpeg;video/x-flv;
