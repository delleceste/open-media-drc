# Generated from *.in by install.sh (single source of truth = the .in + config.env)
/mpd/mpd.conf
/mpd/musicpd.conf
/drc.service
/etc/rc.d/musicpd
/etc/rc.d/brutefir_drc
/etc/rc.d/upmpdcli
/etc/systemd/user/upmpdcli.service
/video/webremote/systemd/omdrcvideo.service
/etc/systemd/system/brutefir-drc.service
/etc/systemd/system/drc-usb-audio.service
# brutefir per-rate configs are generated from configs/**/*.conf.in
configs/*/*.conf
# … except the shipped flat (dirac pulse) defaults, which have no host-specific
# values and are committed as plain .conf (no .in / rendering step)
!configs/flat/*.conf
# No-DRC browser launchers are generated from browser-nodrc/*.desktop.in
/browser-nodrc/*.desktop
/upmpdcli/upmpdcli.conf

# Runtime state written by drc.sh
/last_arg
/last_power
/drc.log

# Runtime state written by omdrc-ctrl (analyzer slider positions).  Repo mode
# keeps state beside the checkout; installed mode uses /var/db/omdrc or XDG.
/spectrum-drc-delay-delta
/spectrum-floor-db

# Runtime state written by the glitch-detection subsystem
/glitch.log
/.glitch-debug.enabled

# Python bytecode cache (video/webremote and omdrc-ctrl)
__pycache__/
*.pyc

# Stale local backup of omdrc-ctrl (has its own nested .git + build artifacts)
/omdrc-ctrl-backup/

# PDF manual intermediate diagram renders (regenerated by doc/pdf/build-pdf.sh)
doc/pdf/build/
