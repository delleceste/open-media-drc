# Generated from *.in by install.sh (single source of truth = the .in + config.env)
/mpd/mpd.conf
/mpd/musicpd.conf
/drc.service
/etc/rc.d/musicpd
/etc/rc.d/brutefir_drc
/etc/rc.d/upmpdcli
/etc/systemd/user/upmpdcli.service
/video/webremote/systemd/omdrcvideo.service
/video/webremote/rc.d/omdrcvideo
# Rendered by CMake from webremote.conf.in (holds the OMDb key); never tracked.
/video/webremote/webremote.conf
/etc/systemd/system/brutefir-drc.service
/etc/systemd/system/drc-usb-audio.service
# brutefir per-rate configs are generated from configs/**/*.conf.in
configs/*/*.conf
# … except the shipped flat (dirac pulse) defaults, which have no host-specific
# values and are committed as plain .conf (no .in / rendering step)
!configs/flat/*.conf
# No-DRC browser launchers are generated from browser-nodrc/*.desktop.in
/browser-nodrc/*.desktop
/upmpdcli/upmpdcli.conf
# Port build artifacts: `make` in the port dir renders files/*.in (SUB_FILES)
# into the same directory without the .in suffix.
/freebsd/audio/open-media-drc/files/*
!/freebsd/audio/open-media-drc/files/*.in

# Runtime state written by drc.sh
/last_arg
/last_power
/drc.log

# Runtime state written by omdrc-ctrl (analyzer slider positions).  Repo mode
# keeps state beside the checkout; installed mode uses /var/db/omdrc or XDG.
/spectrum-drc-delay-delta
/spectrum-floor-db

# Runtime state written by the glitch-detection subsystem
/glitch.log
/.glitch-debug.enabled

# Python bytecode cache (video/webremote and omdrc-ctrl)
__pycache__/
*.pyc

# Stale local backup of omdrc-ctrl (has its own nested .git + build artifacts)
/omdrc-ctrl-backup/

# PDF manual intermediate diagram renders (regenerated by doc/pdf/build-pdf.sh)
doc/pdf/build/

# CMake superproject: local host values (may hold secrets) and build dirs
/host.cmake
/build/

# USB-tap bit-perfect test artifacts (scripts/bitperfect-tap-*.sh): the
# 10 MB wav/raw streams stay local, but the tiny .txt reports ARE tracked —
# they carry the payload sha256, which is all the cross-OS comparison needs
# (bitperfect-compare.py accepts them directly).  The large generated 30 s
# input WAV is also local-only (regenerate: tests/gen-bitperfect-wav.py,
# byte-deterministic — sha256 in tests/README.md).
bp-results/*
!bp-results/*.txt
/tests/bitperfect-test-44100-s32-stereo-30s.wav
/tests/bitperfect-test-44100-s24-stereo-30s.wav
/tests/bitperfect-test-192000-s24-stereo-10s.wav

