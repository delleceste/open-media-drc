#!/bin/sh
#
# PROVIDE: omdrc_cdin
# REQUIRE: brutefir_drc
# KEYWORD: shutdown
#
# omdrc-cdin — the CD / S-PDIF capture bridge.
#
# Add to /etc/rc.conf:
#   omdrc_cdin_enable="YES"
#   omdrc_cdin_in="/dev/dsp1"          # the ESI U24 XL; check /dev/sndstat
#
# This is meant to run continuously, whether or not the CD player is on and
# whether or not the interface is plugged in.  It is safe to leave running
# because the daemon holds the OUTPUT device only while audio is actually on
# the wire: after omdrc_cdin_idle_after milliseconds of exact digital silence
# it releases /dev/dsp.play, so MPD and mpv get the chain back without anyone
# stopping this service.  A missing capture device is likewise not an error
# here — it is retried, and reported in the web panel's CD input card.
#
# REQUIRE: brutefir_drc because the output is virtual_oss's client node, which
# drc.sh creates.  Ordering only; if the chain is down the daemon waits for it
# and says so in the log rather than failing.

. /etc/rc.subr

name="omdrc_cdin"
rcvar="omdrc_cdin_enable"

load_rc_config "$name"

: ${omdrc_cdin_enable:="NO"}
: ${omdrc_cdin_user:="@AUDIO_USER@"}
# Capture device: the S/PDIF interface, NOT the DAC.  /dev/sndstat names them;
# pcm0 is normally the DAC, so the interface is usually /dev/dsp1.
: ${omdrc_cdin_in:="/dev/dsp1"}
# Playback device: virtual_oss's client node, which BruteFIR reads.  Use
# /dev/dsp0 to write the DAC directly and bypass the DRC chain.
: ${omdrc_cdin_out:="/dev/dsp.play"}
# Lead in ms — drift margin, startup delay and transport lag, all at once.
# See the calibration section in the README before changing it.
: ${omdrc_cdin_lead:="2000"}
# Digital silence on the wire before the output device is released.  Must stay
# well clear of the 2 s Red Book inter-track pause.
: ${omdrc_cdin_idle_after:="15000"}
# The web panel reads this file for the CD input card's status and events.
# Keep it in step with the [logs] section of omdrcctrl's commands.conf.
: ${omdrc_cdin_logfile:="/tmp/omdrc-cdin.log"}
# Periodic stats in the log: the panel shows the most recent line, and it is
# what "starves 0" is read off during calibration.
: ${omdrc_cdin_stats:="10"}
# Anything else: --out-bits, --period, --retry, -v ...
: ${omdrc_cdin_flags:=""}

command="/usr/sbin/daemon"

if [ "$(id -u)" -eq 0 ]; then
	# Started as root: rc.subr drops privileges to ${omdrc_cdin_user} (the
	# special ${name}_user variable) via su(1).  Do NOT also pass daemon -u
	# — that runs setusercontext() a second time as the already-dropped
	# user and fails with "daemon: failed to set user environment".
	: ${omdrc_cdin_pidfile:="/var/run/${name}/${name}.pid"}
else
	# Started by an unprivileged user (service omdrc_cdin onestart): there
	# is nothing to drop to, so clear ${name}_user — otherwise rc.subr would
	# su to it and prompt for a password — and use a writable pidfile.
	unset omdrc_cdin_user
	: ${omdrc_cdin_pidfile:="${TMPDIR:-/tmp}/${name}-$(id -un).pid"}
fi

pidfile="${omdrc_cdin_pidfile}"
command_args="-f -P ${pidfile} @CMAKE_INSTALL_PREFIX@/bin/omdrc-cdin \
    --in ${omdrc_cdin_in} \
    --out ${omdrc_cdin_out} \
    --lead ${omdrc_cdin_lead} \
    --idle-after ${omdrc_cdin_idle_after} \
    --stats ${omdrc_cdin_stats} \
    --log ${omdrc_cdin_logfile} \
    ${omdrc_cdin_flags}"

start_precmd="omdrc_cdin_precmd"
extra_commands="release"
release_cmd="omdrc_cdin_release"

omdrc_cdin_precmd()
{
	# The pidfile directory is written after rc.subr drops privileges, so
	# create it as the run user.  This runs as root, before the su(1).
	d="${omdrc_cdin_pidfile%/*}"
	if [ -n "${omdrc_cdin_user}" ]; then
		/usr/bin/install -d -o "${omdrc_cdin_user}" -m 0755 "${d}"
		# The daemon appends to the log and the panel reads it, so it
		# must exist and belong to the run user from the first boot.
		/usr/bin/install -o "${omdrc_cdin_user}" -m 0644 /dev/null \
		    "${omdrc_cdin_logfile}" 2>/dev/null || true
	else
		/usr/bin/install -d -m 0755 "${d}"
	fi
}

# `service omdrc_cdin release` — hand the output device back and stay running.
# This is what drc.sh does before stopping virtual_oss; it is here so the same
# thing can be done by hand without having to know the signal.
omdrc_cdin_release()
{
	if [ -f "${pidfile}" ]; then
		kill -HUP "$(cat "${pidfile}")" && \
		    echo "omdrc_cdin: released ${omdrc_cdin_out}"
	else
		echo "omdrc_cdin: not running"
	fi
}

run_rc_command "$1"
