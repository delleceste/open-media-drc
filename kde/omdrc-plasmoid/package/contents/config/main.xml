<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
      http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>
  <group name="General">
    <!-- the box running omdrcctrl -->
    <entry name="host" type="String"><default></default></entry>
    <entry name="port" type="Int"><default>9090</default></entry>
    <!-- "off" | "bars" | "needles"; a click or a scroll on the meters swaps the two -->
    <entry name="meterStyle" type="String"><default>bars</default></entry>
    <!-- the two channels: "auto" (by the pane's shape) | "side" (side by side) | "stacked" -->
    <entry name="meterPair" type="String"><default>auto</default></entry>
    <entry name="showSpectrum" type="Bool"><default>false</default></entry>
    <entry name="spectrumSplit" type="Bool"><default>true</default></entry>
    <entry name="spectrumPeakHold" type="Bool"><default>true</default></entry>
    <!-- on the desktop and in the popup: the spectrum under the meters, not beside them -->
    <entry name="spectrumBelow" type="Bool"><default>false</default></entry>
    <!-- "off" | "pane" (beside the meters) | "background" (behind them) -->
    <entry name="coverMode" type="String"><default>pane</default></entry>
    <!-- live dynamic range: value, gauge and the segmented history -->
    <entry name="showDr" type="Bool"><default>false</default></entry>
    <!-- per song (the window restarts at each track) or continuous -->
    <entry name="drPerSong" type="Bool"><default>true</default></entry>
    <!-- the DR window, seconds: 60 .. 5400 in whole minutes -->
    <entry name="drWindow" type="Int"><default>60</default></entry>
    <entry name="showBalance" type="Bool"><default>false</default></entry>
    <!-- "split" (grey left / red right, a pointer) | "bar" (from the centre) -->
    <entry name="balanceLook" type="String"><default>split</default></entry>
    <!-- the balance's averaging window, seconds -->
    <entry name="balanceWindow" type="Double"><default>15</default></entry>
    <!-- analyzer frame wait: follow the box's measured remaining margin, or override per widget -->
    <entry name="autoScreenDelay" type="Bool"><default>true</default></entry>
    <entry name="screenDelayMs" type="Int"><default>150</default></entry>
    <!-- the box-wide chain-delay margin last asked for in the settings, "ms@stamp":
         written on Apply/OK, and the widget then sends it to the box (main.qml) -->
    <entry name="boxMarginRequest" type="String"><default></default></entry>
    <!-- title / artist under the display (desktop and popup only) -->
    <entry name="showTitle" type="Bool"><default>true</default></entry>
    <!-- length along a panel in pixels; 0: follow the panes -->
    <entry name="panelLength" type="Int"><default>0</default></entry>
    <entry name="panelInset" type="Int"><default>0</default></entry>
    <!-- the widget's reach into the panel's own padding, pixels kept clear from the
         panel's edges: top/left and bottom/right (0: flush with the panel edge) -->
    <entry name="panelMarginStart" type="Int"><default>0</default></entry>
    <entry name="panelMarginEnd" type="Int"><default>2</default></entry>
    <entry name="paneOrder" type="String"><default>cover,meters,spectrum,dr,balance</default></entry>
    <!-- "default" (Plasma's) | "none" | "custom" (backgroundColor) -->
    <entry name="backgroundMode" type="String"><default>default</default></entry>
    <!-- #AARRGGBB: the alpha is kept -->
    <entry name="backgroundColor" type="String"><default>#99000000</default></entry>
    <!-- theme background hue with this opacity (0..100), for panel/desktop use -->
    <entry name="backgroundOpacity" type="Int"><default>55</default></entry>
  </group>
</kcfg>
